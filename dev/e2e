#!/bin/sh
# The end-to-end scenarios, all of them, on one of dev/emulate's backends,
# with a summary to attach to a pull request (CONTRIBUTING.md, "Test on a
# Chumby, or an emulated one, and show it"). Every emulated Chumby is
# qemu-chumby's machine, through dev/emulate:
#
#   dev/e2e [--build | --no-fetch] TREE NEOCHUMBYD OUT
#       the dist profile, as CI runs it: neochumby's Linux 7, no
#       proprietary firmware
#   NEOCHUMBY_EMU_PROFILE=stock E2E_SCENARIOS=stock dev/e2e TREE NEOCHUMBYD OUT
#       the sideload itself, from the emulated Chumby's stock firmware: your
#       own, by NEOCHUMBY_EMU_KERNEL, _NAND and _PSP; local only, never in CI
#       (docs/legal.md)
#   NEOCHUMBY_EMU_DEVICE=NAME dev/e2e TREE NEOCHUMBYD OUT
#       a real Chumby, paired and set dev=on
#
# E2E_SCENARIOS, a space-separated list of boot, smoke, link, pairing,
# powercut, stock and airplay, runs only those; by default, all.
#
# TREE from tools/tree, with doom and neochumby-sync, and for the stock
# firmware's scenario its sideload files (`tools/tree OUT --sideload DIR doom`);
# NEOCHUMBYD the neochumbyd built with it, for this
# machine (link, pairing and powercut run it here, at the other end of the
# emulated Chumby's serial line). NEOCHUMBY_AIRPLAY_STANDIN (dev/airplay-standin,
# built for the Chumby) dev/emulate-airplay, for a TREE with airplay. Each scenario's screenshots and logs go in
# OUT/<scenario>/, its output in OUT/<scenario>.txt, and the results in
# OUT/summary.txt. A scenario a backend can't run exits 77: skipped, not
# failed. The exit status is 1 if any failed.
#
# First, `dev/emulate prepare` makes QEMU and the profile's images ready,
# once: fetched prebuilt and verified, else built from source (dev/emulate,
# "QEMU ... and the dist image"); --build builds them, never
# fetching (NEOCHUMBY_BUILD=1), and --no-fetch builds what must be made
# (NEOCHUMBY_NO_FETCH=1). Without them the scenarios skip; if a build
# fails, so does dev/e2e.
set -u
while [ $# -gt 0 ]; do
  case $1 in
  --build) export NEOCHUMBY_BUILD=1 ;;
  --no-fetch) export NEOCHUMBY_NO_FETCH=1 ;;
  *) break ;;
  esac
  shift
done
tree=${1:?usage: dev/e2e TREE NEOCHUMBYD OUT}
neochumbyd=${2:?usage: dev/e2e TREE NEOCHUMBYD OUT}
out=${3:?usage: dev/e2e TREE NEOCHUMBYD OUT}
dev=$(cd "$(dirname "$0")" && pwd)
# Your own settings, as dev/emulate reads them (the environment wins): the
# checkout's .env.local, then ~/.config/neochumby/env.local, shared by every
# checkout; where your firmware images are, say.
settings() {
  [ -f "$1" ] || return 0
  while IFS='=' read -r key value; do
    case $key in
    '' | \#* | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
    esac
    case $value in
    "~/"*) value=$HOME/${value#"~/"} ;;
    esac
    eval "[ -n \"\${$key+set}\" ]" || export "$key=$value"
  done < "$1"
}
if [ -n "${NEOCHUMBY_ENV_LOCAL:-}" ]; then
  settings "$NEOCHUMBY_ENV_LOCAL"
else
  settings "$dev/../.env.local"
  settings "${XDG_CONFIG_HOME:-$HOME/.config}/neochumby/env.local"
fi
mkdir -p "$out"
summary=$out/summary.txt
failed=0

# Once, here, not in the first scenario; the scenarios then use what's
# there, or skip.
"$dev/emulate" prepare
case $? in
0 | 77) ;;
*)
  echo "dev/e2e: dev/emulate prepare failed"
  exit 1
  ;;
esac
export NEOCHUMBY_EMU_PREPARED=1

{
  echo "neochumby $(git -C "$dev" rev-parse --short HEAD 2>/dev/null || echo '(no git)')," \
    "on $("$dev/emulate" backend)"
} > "$summary"

run() {
  name=$1
  shift
  echo "== $name"
  start=$(date +%s)
  "$@" > "$out/$name.txt" 2>&1
  status=$?
  took=$(($(date +%s) - start))
  case $status in
  0) result=ok ;;
  77) result=skipped ;;
  *)
    result="FAILED ($status)"
    failed=1
    ;;
  esac
  tail -n 1 "$out/$name.txt"
  echo "$name: $result (${took}s)" | tee -a "$summary"
}

wanted() {
  case " ${E2E_SCENARIOS:-boot smoke link pairing powercut stock airplay} " in
  *" $1 "*) return 0 ;;
  esac
  return 1
}

! wanted boot || run boot "$dev/emulate-boot" "$tree" "$out/boot"
! wanted smoke || run smoke "$dev/emulate-smoke" "$tree" "$out/smoke"
! wanted link || run link "$dev/emulate-link" "$tree" "$neochumbyd" "$out/link"
! wanted pairing || run pairing "$dev/emulate-pairing" "$tree" "$neochumbyd" "$out/pairing"
! wanted powercut || run powercut "$dev/emulate-powercut" "$tree" "$neochumbyd" "$out/powercut"
! wanted stock || run stock "$dev/emulate-stock" "$tree" "$out/stock"
if [ -n "${NEOCHUMBY_AIRPLAY_STANDIN:-}" ] && wanted airplay; then
  run airplay "$dev/emulate-airplay" "$tree" "$NEOCHUMBY_AIRPLAY_STANDIN" "$out/airplay"
fi

echo "--"
cat "$summary"
exit "$failed"
