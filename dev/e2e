#!/bin/sh
# The end-to-end scenarios, all of them, on one of dev/emulate's backends,
# with a summary to attach to a pull request (CONTRIBUTING.md, "Test on a
# Chumby, or an emulated one, and show it"). Every emulated Chumby is
# qemu-chumby's machine, through dev/emulate:
#
#   dev/e2e TREE NEOCHUMBYD OUT
#       the dist profile, as CI runs it: neochumby's Linux 5.9.16
#       (dist/build build/sideload-dist), no proprietary firmware
#   NEOCHUMBY_EMU_PROFILE=stock dev/e2e TREE NEOCHUMBYD OUT
#       the emulated Chumby on its stock firmware: your own, by
#       NEOCHUMBY_EMU_KERNEL, _NAND and _PSP; local only, never in CI
#       (docs/legal.md)
#   NEOCHUMBY_EMU_PROFILE=classic dev/e2e TREE NEOCHUMBYD OUT
#       Linux 2.6.16 built from Chumby's GPL source, with our initramfs
#   NEOCHUMBY_EMU_DEVICE=NAME dev/e2e TREE NEOCHUMBYD OUT
#       a real Chumby, paired and set dev=on
#
# E2E_SCENARIOS, a space-separated list of boot, smoke, pairing, powercut,
# stock and classic, runs only those; by default, all.
#
# TREE from tools/tree, with doom and neochumby-sync, and for the stock
# firmware's scenario ./dev/probe (`tools/tree OUT doom ./dev/probe`, at
# most four apps); NEOCHUMBYD the x86_64
# neochumbyd built with it. NEOCHUMBY_CLASSIC_PICTURES (a renderer's output)
# adds dev/emulate-classic. Each scenario's screenshots and logs go in
# OUT/<scenario>/, its output in OUT/<scenario>.txt, and the results in
# OUT/summary.txt. A scenario a backend can't run exits 77: skipped, not
# failed. The exit status is 1 if any failed.
set -u
tree=${1:?usage: dev/e2e TREE NEOCHUMBYD OUT}
neochumbyd=${2:?usage: dev/e2e TREE NEOCHUMBYD OUT}
out=${3:?usage: dev/e2e TREE NEOCHUMBYD OUT}
dev=$(cd "$(dirname "$0")" && pwd)
# The checkout's .env.local, as dev/emulate reads it (the environment wins):
# where your own firmware images are, say.
local=${NEOCHUMBY_ENV_LOCAL:-$dev/../.env.local}
if [ -f "$local" ]; then
  while IFS='=' read -r key value; do
    case $key in
    '' | \#* | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
    esac
    case $value in
    "~/"*) value=$HOME/${value#"~/"} ;;
    esac
    eval "[ -n \"\${$key+set}\" ]" || export "$key=$value"
  done < "$local"
fi
mkdir -p "$out"
summary=$out/summary.txt
failed=0

{
  echo "neochumby $(git -C "$dev" rev-parse --short HEAD 2>/dev/null || echo '(no git)')," \
    "on $("$dev/emulate" backend)"
} > "$summary"

run() {
  name=$1
  shift
  echo "== $name"
  start=$(date +%s)
  "$@" > "$out/$name.txt" 2>&1
  status=$?
  took=$(($(date +%s) - start))
  case $status in
  0) result=ok ;;
  77) result=skipped ;;
  *)
    result="FAILED ($status)"
    failed=1
    ;;
  esac
  tail -n 1 "$out/$name.txt"
  echo "$name: $result (${took}s)" | tee -a "$summary"
}

wanted() {
  case " ${E2E_SCENARIOS:-boot smoke pairing powercut stock classic} " in
  *" $1 "*) return 0 ;;
  esac
  return 1
}

! wanted boot || run boot "$dev/emulate-boot" "$tree" "$out/boot"
! wanted smoke || run smoke "$dev/emulate-smoke" "$tree" "$out/smoke"
! wanted pairing || run pairing "$dev/emulate-pairing" "$tree" "$neochumbyd" "$out/pairing"
! wanted powercut || run powercut "$dev/emulate-powercut" "$tree" "$neochumbyd" "$out/powercut"
! wanted stock || run stock "$dev/emulate-stock" "$tree" "$out/stock"
if [ -n "${NEOCHUMBY_CLASSIC_PICTURES:-}" ] && wanted classic; then
  run classic "$dev/emulate-classic" "$tree" "$NEOCHUMBY_CLASSIC_PICTURES" "$out/classic"
fi

echo "--"
cat "$summary"
exit "$failed"
