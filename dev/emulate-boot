#!/bin/sh
# The boot, on dev/emulate's emulated Chumby: the least that must work on
# every profile, and what CI checks on dist while the smoke test can't pass
# there yet. It checks that
#   - the boot mounts the stick and runs its hook (dev/emulate's, which
#     runs the tree's own userhook2);
#   - the hook runs the session from the stick, and the session opens home;
#   - home draws: it says so, and the screen settles.
# The screenshot and the console go in OUT.
#
#   dev/emulate-boot TREE OUT     (TREE from tools/tree)
set -eu
tree=${1:?usage: dev/emulate-boot TREE OUT}
out=${2:?usage: dev/emulate-boot TREE OUT}
dev=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$out"
state=$(mktemp -d "${TMPDIR:-/tmp}/neochumby-boot.XXXXXX")
trap 'emu stop >/dev/null 2>&1 || true; rm -rf "$state"' EXIT
emu() { "$dev/emulate" --state "$state" "$@"; }
backend=$(emu backend)
if [ "$backend" = device ]; then
  echo "dev/emulate-boot: skipped: the emulated Chumby's boot only"
  exit 77
fi
slow=$(emu scale)
step() { echo "== $*"; }
fail() {
  echo "FAIL: $*"
  echo "-- the console:"
  emu log || true
  emu stop || true
  exit 1
}

step "boot ($backend)"
r=0
emu start "$tree" || r=$?
[ "$r" -eq 0 ] || exit "$r"
emu wait log 'emutest: stick mounted' $((100 * slow)) || fail "the boot didn't run the stick's hook"
emu wait log "apps from the stick" $((10 * slow)) || fail "the hook didn't take the tree from the stick"
emu wait log 'neochumby: opening home' $((30 * slow)) || fail "the session didn't open home"

step "home draws"
emu wait log 'neochumby-home: showing' $((30 * slow)) || fail "home didn't draw"
emu wait screen $((30 * slow)) || fail "home's screen didn't settle"
emu shot "$out/home.png"
emu log > "$out/console.txt"
emu stop
echo "dev/emulate-boot: all passed ($backend)"
