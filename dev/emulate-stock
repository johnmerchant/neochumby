#!/bin/sh
# The sideload, on the emulated Chumby with its stock firmware. It checks that
#   - the stock boot runs to the boot hook, which loads the module from the
#     stick and jumps;
#   - Linux 7 comes up, its /init runs the stick's hook again, and the session
#     opens home.
# The console and the screen go in OUT.
#
#   dev/emulate-stock TREE OUT     (TREE from tools/tree, with --sideload DIR)
#
# Only on dev/emulate's stock profile (NEOCHUMBY_EMU_PROFILE=stock, your own
# firmware: emu/qemu/qemu-chumby's README, "Images"), so never in CI;
# elsewhere it exits 77.
set -eu
tree=${1:?usage: dev/emulate-stock TREE OUT}
out=${2:?usage: dev/emulate-stock TREE OUT}
dev=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$out"
state=$(mktemp -d "${TMPDIR:-/tmp}/neochumby-stock.XXXXXX")
trap 'emu stop >/dev/null 2>&1 || true; rm -rf "$state"' EXIT
emu() { "$dev/emulate" --state "$state" "$@"; }
if [ "$(emu backend)" != stock ]; then
  echo "dev/emulate-stock: skipped: the stock firmware runs only on the stock profile"
  exit 77
fi
[ -f "$tree/sideload/zImage" ] || {
  echo "FAIL: the tree has no sideload files: tools/tree --sideload DIR"
  exit 1
}
slow=$(emu scale)
step() { echo "== $*"; }
fail() {
  echo "FAIL: $*"
  echo "-- the console:"
  emu log || true
  emu stop || true
  exit 1
}

step "the stock boot, then the hook"
r=0
emu start "$tree" || r=$?
[ "$r" -eq 0 ] || exit "$r"
emu wait log 'emutest: stick mounted' $((90 * slow)) || fail "the stock boot didn't reach the boot hook"
emu wait log 'sideload: jumping to Linux 7' $((60 * slow)) || fail "the hook didn't reach the jump"

step "Linux 7"
emu wait log 'neochumby: opening home' $((100 * slow)) || fail "the session didn't open home"
emu wait screen $((30 * slow)) || fail "home didn't settle"
emu shot "$out/home.png"
emu log > "$out/console.txt"
emu stop
echo "dev/emulate-stock: all passed"
