#!/bin/sh
# dev/emulate's smoke test: boots a tree's session as a Chumby would, from
# a USB stick, and drives it from outside, checking that
#   - the home screen draws, and a tap on DOOM opens Doom (without game data
#     it says so and exits, and the home screen comes back);
#   - holding the top-left corner for three seconds restarts the home screen;
#   - the top button reaches the session, when it holds /dev/switch;
#   - neochumby sensors, run on the console beside the session, sees a
#     touch (where the console has a shell during the session: dist,
#     classic);
#   - CHUMBY MODE ends the session cleanly.
# Screenshots and the console go in OUT.
#
#   dev/emulate-smoke TREE OUT     (TREE from tools/tree, with doom)
#
# On dev/emulate's profile (NEOCHUMBY_EMU_PROFILE: dist, CI's; stock, your
# own firmware; classic) or on a real Chumby (NEOCHUMBY_EMU_DEVICE=NAME,
# paired and set dev=on). The waits scale with `dev/emulate scale`; a
# backend that can't run at all (no images, a neochumbyd from before
# remote input) makes it exit 77.
set -eu
tree=${1:?usage: dev/emulate-smoke TREE OUT}
out=${2:?usage: dev/emulate-smoke TREE OUT}
dev=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$out"
state=$(mktemp -d "${TMPDIR:-/tmp}/neochumby-smoke.XXXXXX")
trap 'emu stop >/dev/null 2>&1 || true; rm -rf "$state"' EXIT
emu() { "$dev/emulate" --state "$state" "$@"; }
backend=$(emu backend)
slow=$(emu scale)
step() { echo "== $*"; }
fail() {
  echo "FAIL: $*"
  echo "-- the console:"
  emu log || true
  emu stop || true
  exit 1
}
count() { emu log | grep -c "$1" || true; }
# Waits until the session has opened the home screen N times.
opened_home() {
  i=0
  until [ "$(count 'neochumby: opening home')" -ge "$1" ]; do
    i=$((i + 1))
    [ "$i" -lt $((600 * slow)) ] || fail "$2"
    sleep 0.1
  done
  emu wait screen $((30 * slow)) || fail "$2"
}

# Where to tap: neochumby-home's layout, rows of apps from y=44, 36 high
# with 4 between, in name order, those with a title and exec (or wasm); CHUMBY MODE
# along the bottom. More than four apps go three to a page, with MORE in
# the fourth row. What happened is read from the session's log.
index=
listed=0
for d in $(ls "$tree/apps"); do
  m=$tree/apps/$d/manifest
  grep -q '^title=' "$m" && grep -Eq '^(exec|wasm)=' "$m" || continue
  [ "$d" = doom ] && index=$listed
  listed=$((listed + 1))
done
[ -n "$index" ] || fail "the tree needs doom"
row_y() { echo $((44 + $1 * 40 + 18)); }
if [ "$listed" -le 4 ]; then
  page=0 row=$index
else
  page=$((index / 3)) row=$((index % 3))
fi

step "boot ($backend)"
if emu start "$tree"; then :; else
  code=$?
  [ "$code" = 77 ] && exit 77
  fail "dev/emulate start failed ($code)"
fi
# The whole boot, then the session.
emu wait log 'neochumby: opening home' $((100 * slow)) || fail "the session didn't open home"
opened_home 1 "the home screen didn't open"
emu shot "$out/1-home.png"

step "tap DOOM"
i=0
while [ "$i" -lt "$page" ]; do
  emu tap 160 "$(row_y 3)"
  sleep 0.5
  i=$((i + 1))
done
emu tap 160 "$(row_y "$row")"
emu wait log 'neochumby: opening doom' $((10 * slow)) || fail "the session didn't open DOOM"
# Without game data Doom exits at once, saying so; with it, it runs.
i=0
until emu log | grep -q 'neochumby-doom: no IWAD found' || [ "$i" -ge $((30 * slow)) ]; do
  i=$((i + 1))
  sleep 0.1
done
emu shot "$out/2-doom.png"
if emu log | grep -q 'neochumby-doom: no IWAD found'; then
  echo "Doom opened, and exited without game data"
  opened_home 2 "the home screen didn't come back after Doom"
else
  echo "Doom is running"
fi

step "the corner hold (the escape hatch)"
before=$(count 'neochumby: opening home')
emu tap 5 5 --hold 3600
emu wait log 'neochumby: escape: ending' $((10 * slow)) || fail "the corner hold didn't end the home screen"
opened_home $((before + 1)) "the home screen didn't come back after the escape"
emu shot "$out/3-escaped.png"

# A session that holds the top button itself (proposal 0002) keeps
# /dev/switch open; a real Chumby's session always does. Home is in front
# here: a remote press can't reach an app that reads the switch itself
# (button = true, Doom's FIRE), so a step that needs that is skipped on a
# device.
if [ "$backend" = device ] || emu status | grep -q 'button_open: True'; then
  step "the top button, to the session"
  emu button press
  emu wait log 'neochumby: the top button: ' $((10 * slow)) || fail "the session didn't act on the top button"
  emu wait screen $((30 * slow)) || fail "the home screen didn't come back after the top button"
  button=
else
  echo "skipped: the top button (the session hasn't /dev/switch)"
  button=" the top button,"
fi

# The console's shell runs beside the session on dist and classic.
case $backend in
dist | classic)
  step "neochumby sensors: a touch"
  (sleep 3 && emu tap 200 20) &
  emu exec --for 6 /mnt/usb/neochumby/neochumby sensors > "$out/sensors.txt" 2>&1 || true
  wait
  grep -q 'Down { x: 200, y: 20,' "$out/sensors.txt" || fail "sensors didn't see the touch at (200, 20): $(cat "$out/sensors.txt")"
  sensors=
  ;;
*) sensors=" sensors," ;;
esac

step "CHUMBY MODE"
emu tap 160 220
emu wait exit $((20 * slow)) || fail "CHUMBY MODE didn't end the session"
[ "$(emu wait exit 1)" = "exit 0" ] || fail "the session ended badly: $(emu wait exit 1)"
emu log > "$out/log.txt"
# The boot carries on after the session: the machine is stopped.
emu stop
echo "-- the console:"
cat "$out/log.txt"
skipped=$(echo "$button$sensors" | sed 's/,$//')
echo "dev/emulate-smoke: all passed ($backend${skipped:+; skipped:$skipped})"
