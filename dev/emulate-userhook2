#!/bin/sh
# dev/emulate's boot hook: userhook2 on the stick dev/emulate makes, which
# the emulated Chumby's boot runs from /mnt/usb as a Chumby runs a stick's
# (dist's /init; the stock firmware's rcS). It runs the real hook,
# emulate/userhook2 (boot/userhook2, unchanged), after
#   - copying the stick's emulate/psp into /psp, for the dist profile: it
#     boots the image directly, so this stands in for what the stock half of
#     the hook hands over (neochumby-handoff). /psp there is in RAM;
#   - linking each --bind directory (emulate/bind/N) at its path;
# and copies the hook's log to the console, which is how dev/emulate
# follows the session: its "neochumby exited: N" is the session's end.

LOG=/tmp/neochumby.log
STICK=/mnt/usb
E=$STICK/emulate

echo "emutest: stick mounted"
if [ -d "$E/psp" ]; then
  mkdir -p /psp
  cp -R "$E/psp/." /psp/
fi
if [ -f "$E/binds" ]; then
  while read -r n path; do
    mkdir -p "${path%/*}"
    rm -rf "$path"
    ln -s "$E/bind/$n" "$path"
  done <"$E/binds"
fi
[ -f "$E/userhook2" ] || {
  echo "emutest: the stick holds no emulate/userhook2"
  exit 0
}
: >>"$LOG"
tail -f "$LOG" &
tail=$!
sh "$E/userhook2"
status=$?
# tail looks at the log once a second: lets it copy the last lines, so
# that what follows comes after them on the console.
sleep 2
kill "$tail"
echo "emutest: hook returned: $status"
exit 0
