#!/bin/sh
# dev/emulate's boot hook: userhook2 on the stick dev/emulate makes, which
# the emulated Chumby's boot runs from /mnt/usb as a Chumby runs a stick's
# (dist's /init; the stock firmware's rcS). It runs the
# tree's own hook, neochumby/userhook2, unchanged, after
#   - copying the stick's emulate/psp into /psp, for the dist profile, whose
#     settings aren't on the NAND;
#   - linking each --bind directory (emulate/bind/N) at its path;
#   - with --server, putting the pairing the Chumby kept (emulate/kept)
#     back in /psp, and copying it there again whenever it changes, so
#     that it outlasts this start;
# and copies the hook's log to the console, which is how dev/emulate
# follows the session: its "neochumby exited: N" is the session's end.

LOG=/tmp/neochumby.log
STICK=/mnt/usb
E=$STICK/emulate

echo "emutest: stick mounted"
if [ -d "$E/psp" ]; then
  mkdir -p /psp
  cp -R "$E/psp/." /psp/
fi
if [ -d "$E/kept" ]; then
  mkdir -p /psp
  cp -R "$E/kept/." /psp/
  (
    while :; do
      for f in neochumby.conf neochumby.key neochumby.settings; do
        [ -f "/psp/$f" ] || continue
        [ "$(cat "/psp/$f")" = "$(cat "$E/kept/$f" 2>/dev/null)" ] && continue
        cp "/psp/$f" "$E/kept/$f.new" && mv "$E/kept/$f.new" "$E/kept/$f" && sync
      done
      sleep 2
    done
  ) &
fi
if [ -f "$E/binds" ]; then
  while read -r n path; do
    mkdir -p "${path%/*}"
    rm -rf "$path"
    ln -s "$E/bind/$n" "$path"
  done <"$E/binds"
fi
[ -f "$STICK/neochumby/userhook2" ] || {
  echo "emutest: the stick holds no neochumby/userhook2"
  exit 0
}
: >>"$LOG"
tail -f "$LOG" &
tail=$!
sh "$STICK/neochumby/userhook2"
status=$?
# tail looks at the log once a second: lets it copy the last lines, so
# that what follows comes after them on the console.
sleep 2
kill "$tail"
echo "emutest: hook returned: $status"
exit 0
