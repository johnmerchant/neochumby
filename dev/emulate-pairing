#!/bin/sh
# A stick paired when it was made, end to end: the emulated Chumby boots a
# stick holding its key and neochumbyd's (as tools/stick --pair writes them),
# and is neochumbyd's Chumby at once: its log arrives over the developer link,
# with no step on the Chumby or the server. It syncs. The power is cut and it
# boots again from the stick as that left it, with the same key and its pairing
# whole, still neochumbyd's Chumby. Then a stick with a key neochumbyd doesn't
# have is refused and registers nothing, another key under the same name goes in
# only with --replace, and once forgotten, the first is turned away.
#
#   dev/emulate-pairing TREE NEOCHUMBYD OUT
#
# TREE from tools/tree; NEOCHUMBYD the neochumbyd built with it, for this
# machine. The emulated Chumby has no network: it reaches neochumbyd over its
# serial line, which qemu-chumby joins to neochumbyd's --listen-unix socket
# (dev/emulate start --server). A real Chumby is skipped: its stick is its
# owner's to make.
set -eu
tree=${1:?usage: dev/emulate-pairing TREE NEOCHUMBYD OUT}
neochumbyd=${2:?usage: dev/emulate-pairing TREE NEOCHUMBYD OUT}
out=${3:?usage: dev/emulate-pairing TREE NEOCHUMBYD OUT}
dev=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$out"
state=$out/state
emu() { "$dev/emulate" --state "$state" "$@"; }
step() { echo "== $*"; }
fail() {
  echo "FAIL: $*"
  echo "-- the log:"
  emu log || true
  echo "-- neochumbyd's log:"
  cat "$out/neochumbyd.log" || true
  emu stop || true
  exit 1
}
backend=$(emu backend)
slow=$(emu scale)

if [ "$backend" = device ]; then
  echo "dev/emulate-pairing: skipped: a real Chumby's stick is its owner's to make"
  exit 77
fi

# The session's files and the home screen: all this needs.
work=$out/tree
rm -rf "$work"
mkdir -p "$work/apps"
for f in "$tree"/*; do
  [ -f "$f" ] && cp -p "$f" "$work/"
done
cp -Rp "$tree/apps/home" "$work/apps/"

ndstate=$out/nd
rm -rf "$ndstate" "$out/first" "$out/stranger" "$out/second" "$state"
# The line's socket: a short path, as a Unix socket's must be.
sockdir=$(mktemp -d /tmp/ncline.XXXXXX)
sock=$sockdir/line.sock
"$neochumbyd" serve --state "$ndstate" --tree "$work" --api 127.0.0.1:0 \
  --listen-unix "$sock" > "$out/neochumbyd.log" 2>&1 &
server=$!
trap 'kill $server 2>/dev/null || true; rm -rf "$sockdir"' EXIT
nd() { "$neochumbyd" "$@" --state "$ndstate"; }

# Until COMMAND succeeds, within SECS.
until_ok() {
  secs=$1
  shift
  i=0
  until "$@"; do
    i=$((i + 1))
    [ "$i" -lt $((secs * 10 * slow)) ] || return 1
    sleep 0.1
  done
}
started() { [ -S "$sock" ] && grep -q '; key [0-9a-f]*$' "$out/neochumbyd.log"; }
until_ok 10 started || fail "neochumbyd didn't start"
server_key=$(sed -n 's/.*; key \([0-9a-f]*\)$/\1/p' "$out/neochumbyd.log")

# In DIR, what tools/stick puts on a stick: its key, and the conf naming
# neochumbyd, which a stranger's names as well.
stick_files() {
  mkdir -p "$1"
  neochumbyd_pub=$("$neochumbyd" keygen "$1/neochumby.key")
  printf 'server=serial\napi_port=7340\nserver_key=%s\nname=chumby\n' "$server_key" > "$1/neochumby.conf"
}
logged() { nd log chumby 2>/dev/null | grep -q "$1"; }
keys() { nd list | sed -n 's/^chumby *[a-z0-9_-]* *\([0-9a-f]*\).*/\1/p'; }

step "paired when made: it is neochumbyd's Chumby at once"
stick_files "$out/first"
first=$neochumbyd_pub
answer=$(nd add chumby "$first" --address serial)
echo "$answer" | grep -qx "server_key=$server_key" || fail "add didn't print neochumbyd's key: $answer"
echo "$answer" | grep -qx 'server=serial' || fail "add didn't print the address: $answer"
size=$(du -sm "$work" | cut -f1)
emu start --psp "$out/first" --size $((size * 3 + 32)) --server "$sock" "$work"
emu wait log 'neochumby: opening home' $((30 * slow)) || fail "the home screen didn't open"
until_ok 60 logged 'neochumby: opening home' || fail "neochumbyd has no log from the paired Chumby"
[ "$(keys)" = "$first" ] || fail "not one Chumby registered: $(keys)"

# The receiver's own first round may be running already. Then this sync waits
# for it, and the round after finds the set up to date.
step "it syncs, and the power is cut as the set goes live"
nd sync chumby > "$out/sync.txt" || fail "neochumbyd sync failed: $(cat "$out/sync.txt")"
emu wait log 'neochumby-sync: set a is live from the next restart' $((60 * slow)) || fail "the set didn't go live"
emu powercut "$out/cut.img"

step "the boot after: its pairing survived, on the stick as the cut left it"
emu start --boot --stick "$out/cut.img" --server "$sock"
emu wait log "apps from the stick's set a" $((60 * slow)) || fail "the boot hook didn't run set a"
emu kept > /dev/null || fail "the stick kept no pairing"
[ "$(cat "$state/psp/neochumby.key")" = "$(cat "$out/first/neochumby.key")" ] || fail "the key changed across the reboot"
grep -qx "server_key=$server_key" "$state/psp/neochumby.conf" || fail "the conf doesn't pin neochumbyd's key"
until_ok 120 logged 'neochumby-sync: up to date' || fail "the Chumby didn't come back as neochumbyd's"
emu exec test -d /psp/rfs1 > /dev/null 2>&1 && fail "something made /psp/rfs1"
emu stop

step "a key neochumbyd doesn't have is refused, and registers nothing"
stick_files "$out/stranger"
stranger=$neochumbyd_pub
emu start --psp "$out/stranger" --server "$sock" "$work"
emu wait log 'settings from .*: no longer paired' $((60 * slow)) || fail "the unknown key wasn't turned away"
[ "$(keys)" = "$first" ] || fail "an unknown key got in: $(keys)"
grep -q 'not registered: refused' "$out/neochumbyd.log" || fail "neochumbyd didn't log the refusal"
emu stop

step "another key under the same name, only with --replace"
if nd add chumby "$stranger" > "$out/replace.txt" 2>&1; then
  fail "a new key replaced the registered one without --replace"
fi
grep -q -- --replace "$out/replace.txt" || fail "add didn't say --replace: $(cat "$out/replace.txt")"
[ "$(keys)" = "$first" ] || fail "the first key is no longer registered"
nd add chumby "$first" > /dev/null || fail "the same key again was refused"

step "forgotten, it is turned away"
nd forget chumby
[ -z "$(keys)" ] || fail "still registered: $(keys)"
emu start --stick "$out/cut.img" --server "$sock"
emu wait log 'settings from .*: no longer paired' $((60 * slow)) || fail "the forgotten Chumby wasn't turned away"
emu stop

echo "dev/emulate-pairing: all passed"
