#!/usr/bin/env python3
"""Runs a neochumby tree on an emulated Chumby Classic, or on a real one,
and drives it from outside: the scenarios (dev/emulate-*, dev/e2e) are
written against this. All emulation happens through qemu-chumby
(emu/qemu/qemu-chumby): QEMU's chumby-classic machine, run and driven by
its chumby-machine runner. This script knows only about neochumby: which
images a profile boots, how a tree goes on a stick, the boot hook, and
the settings.

  dev/emulate start [TREE]        boots the profile with TREE on a USB stick
         [--stick IMG]            or boots this stick image as it is (from
                                  mkstick, or a powercut), written as the
                                  Chumby writes it
         [--psp DIR]              DIR's files added to the settings (/psp)
         [--bind DIR:PATH]        DIR, on the stick, linked at PATH (e.g.
                                  pictures at /tmp/classic)
         [--fast]                 -icount: emulated time runs ahead while
                                  the Chumby is idle (boots in seconds; a
                                  hold lasts longer in emulated time)
         [--boot]                 accepted, for the scenarios: the full
                                  system always boots through the hooks
         [--build]                QEMU and images built from source, never
                                  fetched (NEOCHUMBY_BUILD=1)
         [--no-fetch]             built if they must be made, not fetched
                                  (NEOCHUMBY_NO_FETCH=1)
  dev/emulate prepare [--build | --no-fetch]   what start would fetch or
                                  build, made ready, and nothing booted
  dev/emulate tap X Y [--hold MS] a touch at screen pixel (X, Y)
  dev/emulate button down|up|press  the top button
  dev/emulate shot OUT.png        the screen
  dev/emulate pixel X Y           one pixel, as #rrggbb
  dev/emulate compare [--min F] [--wait SECS] [--want RE] [--mask X,Y,W,H]
                  RAW ...         which 320x240 RGB565 picture the screen is
                                  most like, and the share of its pixels
                                  that match; with --wait, until the best
                                  matches --min of them and is named by RE
  dev/emulate log [-f]            the console (with the session's log)
  dev/emulate wait screen|exit [SECS]   until the screen settles, or the
  dev/emulate wait log REGEX [SECS]     session ends; or a log line matches
                                  (giving up if the session ends first)
  dev/emulate status
  dev/emulate stop
  dev/emulate powercut [--force] OUT.img   the power cut: the machine
                                  stopped, the stick image copied to OUT as
                                  it stands, QEMU killed; boot OUT next.
                                  With --device, a prompt to pull the plug
  dev/emulate exec [--for SECS] CMD [ARG ...]   runs CMD on the Chumby's
                                  console (dist and classic, whose console
                                  has a shell while the session runs)
  dev/emulate mkstick IMG [--size MB] [--force] [TREE]
                                  a stick image as start makes one
  dev/emulate backend             the profile: stock, dist, classic or device
  dev/emulate scale               how much longer than a Chumby's its waits
                                  are (NEOCHUMBY_EMU_SLOW overrides)
  dev/emulate prompt TEXT         with --device, a step for the person there
                                  (pull the power), then Enter; elsewhere
                                  exits 77, skipped

--profile NAME (or NEOCHUMBY_EMU_PROFILE; default dist) picks what the
emulated Chumby boots. Each is a kernel, an optional NAND image or initrd,
a command line, and where the settings go:

  stock    the Chumby's own Linux 2.6.16 firmware, from your own device's
           flash backup (emu/qemu/qemu-chumby's README, "Images"): --kernel
           ZIMAGE, --nand NAND and --factory-psp DIR, or NEOCHUMBY_EMU_KERNEL,
           _NAND and _PSP. The stock boot mounts the stick on /mnt/usb and
           runs its userhook2. The settings are a copy of the NAND with its
           settings partition rewritten. Local only: never in CI
           (docs/legal.md)
  dist     neochumby's Linux 5.9.16: --kernel, or NEOCHUMBY_EMU_DIST_KERNEL,
           else build/sideload-dist/sideload-zImage, fetched or built
           (below). NEOCHUMBY_DIST_KERNEL=stable or mainline (as
           dist/build takes it) boots that kernel track instead, from
           build/sideload-dist-stable or -mainline (CI builds mainline
           weekly: fetched, it's the newest build, which may be older
           than the checkout). Its /init
           mounts the stick and runs its userhook2. No proprietary
           firmware: CI runs it
  classic  Linux 2.6.16 from Chumby's GPL source with a busybox initramfs
           (NEOCHUMBY_EMU_CLASSIC_KERNEL, else build/classic/classic-zImage,
           fetched or built), which runs the stick's hook as the stock boot
           does

Each of a profile's images is a flag (--kernel, --nand, --factory-psp,
--initrd, --append) or a variable: NEOCHUMBY_EMU_DIST_KERNEL, _INITRD and
_APPEND for dist, likewise _CLASSIC_ for classic, and for stock
NEOCHUMBY_EMU_KERNEL, _NAND, _PSP and _APPEND. A new profile is an entry in
PROFILES below. For dist and classic the settings go on the stick, and the
hook copies them into /psp.

QEMU (emu/qemu/out/obj/qemu-system-arm, unless --qemu or $QEMU) and the
dist and classic images (unless given) are made ready at start, as
dev/prebuilt.py describes: used as they are while they match their inputs
(the qemu-chumby commit pinned here; the image's inputs commit, kernel and
any local changes to them), else fetched prebuilt and verified
(emu/qemu/fetch, dist/fetch, classic/fetch), else, with a line saying why,
built from source (emu/qemu/build, dist/build, classic/build). One made
some other way (by hand, or CI's) is used as it is. The stock profile's
images are your own and never fetched. Without a profile's images or QEMU,
when neither fetching nor building can make them here, start exits 77:
skipped; a build that fails is an error. (dev/e2e runs prepare once and
sets NEOCHUMBY_EMU_PREPARED=1, with which start neither fetches nor builds.)

The stick is a FAT image laid out as tools/stick lays one out, the tree as
neochumby/, except that its userhook2 is dev/emulate-userhook2: it puts
the settings and --bind directories in place, copies the session's log to
the console, and runs the tree's own userhook2, unchanged. The session's
end is that hook's "neochumby exited: N" on the console.

The emulated Chumby has no network (QEMU runs with -nic none): --server,
and so pairing and delivery=sync, need a real Chumby.

--device NAME (or NEOCHUMBY_EMU_DEVICE) drives a real Chumby instead: one
paired with a neochumbyd and set `dev=on` (`neochumbyd set NAME dev=on`),
over the developer link, with the server here or --host HOST over ssh
(NEOCHUMBY_EMU_HOST; its state in NEOCHUMBYD_DIR). start installs TREE on
the server (tools/deploy --tree) and restarts the Chumby; log is its log
from then on; shot, tap and button are neochumbyd's; stop restarts it to
its start app. A neochumbyd without remote tap or button skips them (77).

The emulator's directory is --state DIR, else $NEOCHUMBY_EMU, else
neochumby-emulate-UID-PROFILE (or -NAME for a device) in the temporary
directory: the stick, the NAND copy, the console's log (console.log) and
chumby-machine's sockets. Nothing here needs root. Your own settings,
such as where your firmware is, can go in the checkout's .env.local.
"""

import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
DEV = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(DEV)
sys.path.insert(0, DEV)
import device  # noqa: E402
import prebuilt  # noqa: E402

# chumby-machine, from the qemu-chumby submodule (or CHUMBY_MACHINE_PATH, a
# checkout of it).
QEMU_CHUMBY = os.environ.get("CHUMBY_MACHINE_PATH") or os.path.join(REPO, "emu", "qemu", "qemu-chumby")
sys.path.insert(0, QEMU_CHUMBY)
try:
    import chumby_machine as cm  # noqa: E402
except ImportError:
    cm = None

SKIPPED = 77
W, H = 320, 240
# The machine's touchscreen spans the ADC's full range, which this
# calibration maps onto the screen (qemu-chumby's README).
NEUTRAL_CALIBRATION = "0,4095,4095,-4095,0"
HOOK = os.path.join(DEV, "emulate-userhook2")
# The boot hook's line when the session returns (boot/userhook2).
EXITED = re.compile(r"neochumby exited: (\d+)")

# What each profile boots. A setting comes from its flag, else from the
# environment, else the default (a file's relative to the checkout); None
# where the profile has none. `psp` is where the settings go: rewritten in the NAND's
# settings partition, or on the stick for the hook to copy.
PROFILES = {
    "stock": {
        "kernel": ("NEOCHUMBY_EMU_KERNEL", None),
        "nand": ("NEOCHUMBY_EMU_NAND", None),
        "factory_psp": ("NEOCHUMBY_EMU_PSP", None),
        "initrd": None,
        "append": ("NEOCHUMBY_EMU_APPEND", None),
        "psp": "nand",
        "needs": "your own firmware (emu/qemu/qemu-chumby's README, \"Images\")",
    },
    "dist": {
        "kernel": ("NEOCHUMBY_EMU_DIST_KERNEL", "build/sideload-dist/sideload-zImage"),
        "nand": None,
        "factory_psp": None,
        "initrd": ("NEOCHUMBY_EMU_DIST_INITRD", None),
        "append": ("NEOCHUMBY_EMU_DIST_APPEND", "console=ttymxc0,115200 rdinit=/init"),
        "psp": "stick",
        "needs": "the dist image (dist/fetch, else dist/build)",
    },
    "classic": {
        "kernel": ("NEOCHUMBY_EMU_CLASSIC_KERNEL", "build/classic/classic-zImage"),
        "nand": None,
        "factory_psp": None,
        "initrd": ("NEOCHUMBY_EMU_CLASSIC_INITRD", None),
        "append": ("NEOCHUMBY_EMU_CLASSIC_APPEND", "console=ttyS0,38400"),
        "psp": "stick",
        "needs": "the classic image (classic/fetch, else classic/build)",
    },
}
DEFAULT_PROFILE = "dist"
# How much longer than a Chumby's each backend's waits are: QEMU emulates
# the ARM926 at about a real one's pace, with the boot before the session.
SCALE = {"stock": 3, "dist": 3, "classic": 3, device.MACHINE: 5}


def skip(why):
    print(f"dev/emulate: skipped: {why}")
    sys.exit(SKIPPED)


# The state directory, as device.py uses it too: small files read and
# written whole.


class State:
    def __init__(self, path):
        self.path = os.path.abspath(path)

    def at(self, name):
        return os.path.join(self.path, name)

    def claim(self):
        """A directory of the user's, not a link, writable by no one else."""
        os.makedirs(self.path, mode=0o755, exist_ok=True)
        st = os.lstat(self.path)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
            sys.exit(f"dev/emulate: {self.path} must be a directory of yours, writable by no one else; "
                     "give another --state")


def read(state, name):
    try:
        with open(state.at(name)) as f:
            return f.read().strip()
    except (FileNotFoundError, NotADirectoryError):
        return None


def write(state, name, text, size=None):
    path = state.at(name)
    with open(path + ".new", "w") as f:
        f.write(text)
        if size is not None:
            f.truncate(size)
    os.rename(path + ".new", path)


def remove(state, name):
    try:
        os.unlink(state.at(name))
    except FileNotFoundError:
        pass


def backend_of(state):
    return read(state, "profile")


def machine(state):
    if cm is None:
        sys.exit(f"dev/emulate: no chumby-machine: {QEMU_CHUMBY} is empty "
                 "(git submodule update --init emu/qemu/qemu-chumby)")
    return cm.Machine(state.path)


def making(opts):
    """How start makes what it needs (dev/prebuilt.py): (mode, act)."""
    if opts.get("build") or os.environ.get("NEOCHUMBY_BUILD") == "1":
        mode = "build"
    elif opts.get("no_fetch") or os.environ.get("NEOCHUMBY_NO_FETCH") == "1":
        mode = "no-fetch"
    else:
        mode = "auto"
    # dev/e2e has prepared them already: use them or skip, but don't try again.
    return mode, os.environ.get("NEOCHUMBY_EMU_PREPARED") != "1"


def find_qemu(given, how=("auto", True)):
    """QEMU with the machine: --qemu, $QEMU, emu/qemu/out/obj's (fetched or
    built if need be), else qemu-chumby's own or PATH's."""
    for q in (given, os.environ.get("QEMU")):
        if q and os.access(q, os.X_OK):
            return q
    try:
        return prebuilt.Qemu(REPO).ensure(*how)
    except prebuilt.Unavailable as e:
        why = str(e)
    except prebuilt.Failed as e:
        sys.exit(f"dev/emulate: {e}")
    try:
        return cm.find_qemu()
    except cm.Error:
        skip(f"no qemu-system-arm with the chumby-classic machine: {why}; or give $QEMU or --qemu")


def prebuilt_image(profile):
    """The image dev/emulate fetches or builds for PROFILE: None for stock,
    whose images are your own."""
    if profile == "dist":
        return prebuilt.Image(REPO, "dist", os.environ.get("NEOCHUMBY_DIST_KERNEL") or None)
    if profile == "classic":
        return prebuilt.Image(REPO, "classic")
    return None


# The stick.


def stick_layout(work, tree, profile, extra_psp, binds):
    """The stick's files, in WORK: as tools/stick lays them out, but with
    dev/emulate's hook as userhook2 (the tree's own is neochumby/userhook2),
    and under emulate/ the settings and --bind directories. Links, which
    the stick image follows."""
    os.makedirs(os.path.join(work, "emulate"))
    os.symlink(HOOK, os.path.join(work, "userhook2"))
    if tree:
        os.symlink(os.path.abspath(tree), os.path.join(work, "neochumby"))
    if profile and PROFILES[profile]["psp"] == "stick":
        psp = os.path.join(work, "emulate", "psp")
        if extra_psp:
            shutil.copytree(extra_psp, psp)
        else:
            os.makedirs(psp)
        with open(os.path.join(psp, "ts_settings"), "w") as f:
            f.write(NEUTRAL_CALIBRATION + "\n")
    if binds:
        os.makedirs(os.path.join(work, "emulate", "bind"))
        with open(os.path.join(work, "emulate", "binds"), "w") as f:
            for i, (host, guest) in enumerate(binds):
                os.symlink(host, os.path.join(work, "emulate", "bind", str(i)))
                f.write(f"{i} {guest}\n")


def make_stick(out, tree, profile, extra_psp, binds, size_mb=None):
    if tree and not os.path.isfile(os.path.join(tree, "neochumby")):
        sys.exit(f"dev/emulate: {tree}: no neochumby there (make one with tools/tree)")
    with tempfile.TemporaryDirectory() as work:
        stick_layout(os.path.join(work, "stick"), tree, profile, extra_psp, binds)
        cm.mkfat(os.path.join(work, "stick"), out, size_mb, "NEOCHUMBY")


def psp_dir(work, factory, extra):
    """The stock profile's settings: your factory-like set, then --psp's
    files over it, with the intro off and the machine's calibration."""
    psp = os.path.join(work, "psp")
    shutil.copytree(factory, psp, symlinks=True)
    if extra:
        shutil.copytree(extra, psp, symlinks=True, dirs_exist_ok=True)
    open(os.path.join(psp, "disable_intro"), "w").close()
    with open(os.path.join(psp, "ts_settings"), "w") as f:
        f.write(NEUTRAL_CALIBRATION + "\n")
    return psp


def setting(profile, key, opts):
    """One of a profile's images: its flag, its variable, or its default."""
    if opts.get(key):
        return opts[key]
    spec = PROFILES[profile][key]
    if spec is None:
        return None
    env, default = spec
    if key == "kernel" and prebuilt_image(profile):
        default = prebuilt_image(profile).path()
    elif key != "append" and default:
        default = os.path.join(REPO, default)
    return os.environ.get(env) or default


def ready(profile, opts):
    """The profile's images and QEMU, fetched or built if need be:
    (images, qemu). Skips (77) without them."""
    p = PROFILES[profile]
    images = {k: setting(profile, k, opts) for k in ("kernel", "nand", "factory_psp", "initrd", "append")}
    # The image is ours to make unless one was given.
    image = None if opts.get("kernel") or os.environ.get(p["kernel"][0]) else prebuilt_image(profile)
    flags = {"kernel": "--kernel", "nand": "--nand", "factory_psp": "--factory-psp"}
    missing = [f"{flags[k]} or {p[k][0]}" for k in flags
               if p[k] is not None and not (k == "kernel" and image)
               and not (images[k] and os.path.exists(images[k]))]
    if missing:
        skip(f"the {profile} profile needs {p['needs']}: {', '.join(missing)}")
    if images["initrd"] and not os.path.exists(images["initrd"]):
        sys.exit(f"dev/emulate: {images['initrd']}: no such initrd")
    if cm is None:
        skip(f"no chumby-machine ({QEMU_CHUMBY} is empty: git submodule update --init emu/qemu/qemu-chumby)")
    how = making(opts)
    qemu = find_qemu(opts.get("qemu"), how)
    if image:
        try:
            images["kernel"] = image.ensure(*how)
        except prebuilt.Unavailable as e:
            skip(f"the {profile} profile needs {p['needs']}: {e} (or --kernel or {p['kernel'][0]})")
        except prebuilt.Failed as e:
            sys.exit(f"dev/emulate: {e}")
    return images, qemu


def cmd_prepare(opts):
    if opts["device"]:
        print("dev/emulate: a real Chumby: nothing to prepare")
        return
    images, qemu = ready(opts["profile"], opts)
    print(f"dev/emulate: ready: {opts['profile']} boots {images['kernel']} on {qemu}")


def cmd_start(state, opts, tree):
    profile = opts["profile"]
    if opts["device"]:
        state.claim()
        if read(state, "pid"):
            sys.exit(f"dev/emulate: already running ({state.path}); dev/emulate stop first")
        write(state, "profile", device.MACHINE)
        device.start(state, opts, tree, write, read, remove)
        return
    if opts.get("server"):
        sys.exit("dev/emulate: --server: the emulated Chumby has no network (-nic none); "
                 "pairing and NFS need a real Chumby (--device)")
    if tree and opts.get("stick"):
        sys.exit("dev/emulate start: a TREE or a --stick, not both")
    if not tree and not opts.get("stick"):
        sys.exit("dev/emulate start: give a TREE, or a --stick holding one")
    p = PROFILES[profile]
    images, qemu = ready(profile, opts)
    state.claim()
    m = machine(state)
    if m.running():
        sys.exit(f"dev/emulate: already running ({state.path}); dev/emulate stop first")
    remove(state, "profile")
    if opts.get("stick"):
        stick = os.path.abspath(opts["stick"])
        if not os.path.isfile(stick):
            sys.exit(f"dev/emulate: {stick}: no such stick image")
        if (opts.get("psp") and p["psp"] == "stick") or opts.get("binds"):
            sys.exit("dev/emulate: --psp and --bind go on the stick that start makes from a TREE")
    else:
        stick = state.at("stick.img")
        make_stick(stick, tree, profile, opts.get("psp"), opts.get("binds"))
    with tempfile.TemporaryDirectory() as work:
        psp = psp_dir(work, images["factory_psp"], opts.get("psp")) if p["psp"] == "nand" else None
        m.start(kernel=images["kernel"], nand=images["nand"], psp=psp, initrd=images["initrd"],
                append=images["append"], stick=stick, fast=opts.get("fast"), qemu=qemu)
    write(state, "profile", profile)
    print(f"dev/emulate: {profile} booting ({state.path}); the console: dev/emulate log")


def screen565(state):
    """The screen now, as RGB565 values."""
    if backend_of(state) == device.MACHINE:
        if read(state, "pid"):
            device.fetch_screen(state, read)
        with open(state.at("fb0"), "rb") as f:
            return list(memoryview(f.read(W * H * 2)).cast("H"))
    return cm.rgb_to_rgb565(machine(state).screen())


def log_of(state):
    path = state.at("log") if backend_of(state) == device.MACHINE else state.at("console.log")
    try:
        with open(path, "rb") as f:
            return f.read().decode("latin-1")
    except FileNotFoundError:
        return ""


def exit_of(state):
    if backend_of(state) == device.MACHINE:
        return read(state, "exit")
    m = EXITED.search(log_of(state))
    return m and f"exit {m.group(1)}"


def running(state):
    b = backend_of(state)
    if b == device.MACHINE:
        return bool(read(state, "pid"))
    return b is not None and machine(state).running()


def need_running(state):
    if not running(state):
        sys.exit(f"dev/emulate: not running ({state.path})")


def cmd_tap(state, x, y, hold_ms):
    if not (0 <= x < W and 0 <= y < H):
        sys.exit(f"dev/emulate tap: ({x}, {y}) is off the {W}x{H} screen")
    if backend_of(state) == device.MACHINE:
        return device.tap(state, read, x, y, hold_ms)
    need_running(state)
    machine(state).tap(x, y, hold_ms)


def cmd_button(state, how):
    if how not in ("press", "down", "up"):
        sys.exit("usage: dev/emulate button down|up|press")
    if backend_of(state) == device.MACHINE:
        return device.button(state, read, how)
    need_running(state)
    machine(state).button("tap" if how == "press" else how, 200)


def cmd_compare(state, files, least, secs, want, masks):
    keep = cm.masked(masks) if masks else None
    pictures = {}
    for f in files:
        with open(f, "rb") as fh:
            data = fh.read(W * H * 2 + 1)
        if len(data) != W * H * 2:
            sys.exit(f"dev/emulate compare: {f}: not {W * H * 2} bytes")
        p = memoryview(data).cast("H")
        pictures[os.path.basename(f)] = [p[i] for i in keep] if keep else list(p)
    if not pictures:
        sys.exit("usage: dev/emulate compare [--min F] [--wait SECS] [--want RE] RAW ...")
    deadline = time.monotonic() + secs
    while True:
        now = screen565(state)
        if keep:
            now = [now[i] for i in keep]
        share, name = max((sum(a == b for a, b in zip(now, p)) / len(now), n) for n, p in pictures.items())
        ok = share >= least and (not want or re.search(want, name))
        if ok or time.monotonic() >= deadline:
            print(f"{share:.2f} {name}")
            if not ok and (secs or least):
                sys.exit(1)
            return
        time.sleep(0.3)


def cmd_wait(state, what, arg, secs):
    deadline = time.monotonic() + secs
    last, since = None, time.monotonic()
    while time.monotonic() < deadline:
        done = exit_of(state)
        if what == "exit" and done:
            print(done)
            return
        if what == "log" and re.search(arg, log_of(state), re.M):
            return
        if what == "screen":
            now = screen565(state)
            if now != last:
                last, since = now, time.monotonic()
            elif any(now) and time.monotonic() - since >= 0.5:
                return
        if what != "exit" and done:
            sys.exit(f"dev/emulate wait: the session ended ({done})")
        if not running(state):
            sys.exit(f"dev/emulate wait {what}: the Chumby isn't running")
        time.sleep(0.1)
    sys.exit(f"dev/emulate wait {what}: timed out after {secs:g} s")


def cmd_log(state, follow):
    path = state.at("log") if backend_of(state) == device.MACHINE else state.at("console.log")
    try:
        f = open(path, "rb")
    except FileNotFoundError:
        return
    with f:
        while True:
            chunk = f.read()
            if chunk:
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
            elif not follow or not running(state) or exit_of(state):
                return
            else:
                time.sleep(0.2)


def button_open(log):
    """Whether the session holds /dev/switch, as it says: it logs a failure
    to open it, and an open that succeeds later."""
    if "neochumby: opening" not in log:
        return False
    failed = log.rfind("neochumby: /dev/switch: ")
    return failed < 0 or log.find("neochumby: /dev/switch: open now", failed) >= 0


def cmd_status(state):
    b = backend_of(state)
    if b == device.MACHINE and running(state):
        print(f"running: {read(state, 'device-name')}, a Chumby, via {read(state, 'device-host') or 'this machine'}")
    elif running(state):
        print("running")
        s = machine(state).status()
        s["profile"] = b
        s["button_open"] = button_open(log_of(state))
        if exit_of(state):
            s["session"] = exit_of(state)
        for k, v in sorted(s.items()):
            print(f"  {k}: {v}")
    elif exit_of(state):
        print(f"stopped: the session ended ({exit_of(state)})")
    else:
        print("not running")


def cmd_powercut(state, out, force):
    if backend_of(state) == device.MACHINE:
        device.prompt("Pull the Chumby's power now, wait five seconds, and plug it back in.")
        return
    need_running(state)
    if os.path.lexists(out):
        if not force:
            sys.exit(f"dev/emulate powercut: {out} exists; --force to overwrite it")
        if os.path.islink(out) or not os.path.isfile(out):
            sys.exit(f"dev/emulate powercut: {out} isn't a regular file; refusing")
        os.unlink(out)
    machine(state).powercut(out)
    print(f"dev/emulate: the power was cut; the stick as it stood: {out}")


def cmd_stop(state):
    b = backend_of(state)
    if b == device.MACHINE:
        if running(state):
            device.stop(state, read, remove)
    elif b and cm is not None:
        machine(state).stop()


def cmd_exec(state, argv, secs):
    if backend_of(state) == device.MACHINE:
        skip("exec: the emulated Chumby's console only, not a device")
    need_running(state)
    if not argv:
        sys.exit("usage: dev/emulate exec [--for SECS] CMD [ARG ...]")
    line = shlex.join(argv)
    if secs:
        # Stopped after SECS, as the session would stop an app.
        line = f"{line} & p=$!; sleep {secs:g}; kill $p 2>/dev/null; wait $p"
    status, out = machine(state).exec(line, max(30, secs + 30))
    sys.stdout.buffer.write(out.encode("latin-1"))
    sys.stdout.flush()
    sys.exit(status)


def cmd_mkstick(img, size, force, tree, profile):
    if os.path.lexists(img):
        if not force:
            sys.exit(f"dev/emulate mkstick: {img} exists; --force to overwrite it")
        if os.path.islink(img) or not os.path.isfile(img):
            sys.exit(f"dev/emulate mkstick: {img} isn't a regular file; refusing")
    if cm is None:
        sys.exit(f"dev/emulate: no chumby-machine: {QEMU_CHUMBY} is empty")
    make_stick(img, tree, profile, None, None, size)


def local_settings():
    """The checkout's .env.local (never committed): KEY=VALUE lines, such as
    where your own firmware images are (NEOCHUMBY_EMU_KERNEL, _NAND, _PSP).
    The environment wins over it, and NEOCHUMBY_ENV_LOCAL names another
    file (the tests give /dev/null)."""
    try:
        with open(os.environ.get("NEOCHUMBY_ENV_LOCAL") or os.path.join(REPO, ".env.local")) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return
    for line in lines:
        key, eq, value = line.strip().partition("=")
        if eq and key and not key.startswith("#"):
            os.environ.setdefault(key.strip(), os.path.expanduser(value.strip().strip("\"'")))


USAGE = "usage: dev/emulate [--profile NAME | --device NAME] [--state DIR] COMMAND ... (dev/emulate --help)"


def main(argv):
    local_settings()

    def flag(args, name, default=None):
        """The value after `name` in args, taken out of them."""
        if name not in args:
            return default
        i = args.index(name)
        if i + 1 >= len(args):
            sys.exit(f"dev/emulate: {name} needs a value")
        v = args[i + 1]
        del args[i:i + 2]
        return v

    def number(v, kind=int):
        try:
            return kind(v)
        except (TypeError, ValueError):
            sys.exit(f"dev/emulate: not a number: {v}")

    argv = list(argv)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    profile = flag(argv, "--profile") or os.environ.get("NEOCHUMBY_EMU_PROFILE") or DEFAULT_PROFILE
    if profile not in PROFILES:
        sys.exit(f"dev/emulate: no profile {profile} ({', '.join(PROFILES)})")
    chumby = flag(argv, "--device") or os.environ.get("NEOCHUMBY_EMU_DEVICE")
    host = flag(argv, "--host")
    backend = device.MACHINE if chumby else profile
    path = flag(argv, "--state") or os.environ.get("NEOCHUMBY_EMU") or os.path.join(
        tempfile.gettempdir(), f"neochumby-emulate-{os.getuid()}-{chumby or profile}")
    state = State(path)
    if not argv:
        sys.exit(USAGE)
    cmd, args = argv[0], argv[1:]

    def operands(n, usage):
        if len(args) < n:
            sys.exit(f"usage: dev/emulate {usage}")
        return args[:n]

    if cmd == "prepare":
        opts = {"profile": profile, "device": chumby, "qemu": flag(args, "--qemu"), "kernel": flag(args, "--kernel"),
                "nand": flag(args, "--nand"), "factory_psp": flag(args, "--factory-psp"),
                "initrd": flag(args, "--initrd"), "build": "--build" in args, "no_fetch": "--no-fetch" in args}
        args = [a for a in args if a not in ("--build", "--no-fetch")]
        if args:
            sys.exit(f"dev/emulate prepare: unknown options: {' '.join(args)}")
        cmd_prepare(opts)
    elif cmd == "start":
        opts = {
            "profile": profile,
            "device": chumby,
            "host": host,
            "stick": flag(args, "--stick"),
            "server": flag(args, "--server"),
            "psp": flag(args, "--psp"),
            "kernel": flag(args, "--kernel"),
            "nand": flag(args, "--nand"),
            "factory_psp": flag(args, "--factory-psp"),
            "initrd": flag(args, "--initrd"),
            "append": flag(args, "--append"),
            "qemu": flag(args, "--qemu"),
            "fast": "--fast" in args,
            "build": "--build" in args,
            "no_fetch": "--no-fetch" in args,
        }
        args = [a for a in args if a not in ("--fast", "--boot", "--build", "--no-fetch")]
        binds = []
        while "--bind" in args:
            src, _, guest = flag(args, "--bind").partition(":")
            if not os.path.isdir(src) or not guest.startswith("/") or re.search(r"\s", guest):
                sys.exit("dev/emulate start: --bind DIR:/PATH, DIR a directory")
            binds.append((os.path.abspath(src), guest))
        opts["binds"] = binds
        if any(a.startswith("-") for a in args) or len(args) > 1:
            sys.exit(f"dev/emulate start: unknown options: {' '.join(args)}")
        cmd_start(state, opts, args[0] if args else None)
    elif cmd == "tap":
        hold = number(flag(args, "--hold", "100"))
        x, y = operands(2, "tap X Y [--hold MS]")
        cmd_tap(state, number(x), number(y), hold)
    elif cmd == "button":
        cmd_button(state, args[0] if args else "")
    elif cmd == "shot":
        (out,) = operands(1, "shot OUT.png")
        if backend_of(state) == device.MACHINE:
            device.fetch_screen(state, read)
            subprocess.run([sys.executable, "-I", os.path.join(DEV, "fb2png.py"), state.at("fb0"), out], check=True)
        else:
            need_running(state)
            machine(state).shot(out)
    elif cmd == "pixel":
        x, y = (number(v) for v in operands(2, "pixel X Y"))
        if not (0 <= x < W and 0 <= y < H):
            sys.exit(f"dev/emulate pixel: ({x}, {y}) is off the screen")
        if backend_of(state) == device.MACHINE:
            p = screen565(state)[y * W + x]
            r, g, b = (p >> 11) & 0x1F, (p >> 5) & 0x3F, p & 0x1F
            print("#%02x%02x%02x" % (r << 3 | r >> 2, g << 2 | g >> 4, b << 3 | b >> 2))
        else:
            need_running(state)
            print(machine(state).pixel(x, y))
    elif cmd == "compare":
        least, secs = number(flag(args, "--min", "0"), float), number(flag(args, "--wait", "0"), float)
        want, masks = flag(args, "--want"), []
        while "--mask" in args:
            try:
                x, y, w, h = (int(v) for v in flag(args, "--mask").split(","))
            except ValueError:
                sys.exit("dev/emulate compare: --mask X,Y,W,H")
            masks.append((x, y, w, h))
        cmd_compare(state, args, least, secs, want, masks)
    elif cmd == "backend":
        print(backend)
    elif cmd == "scale":
        print(os.environ.get("NEOCHUMBY_EMU_SLOW") or SCALE.get(backend, 1))
    elif cmd == "prompt":
        (text,) = operands(1, "prompt TEXT")
        if backend != device.MACHINE:
            skip(f"prompt: a step for a person, with --device only: {text}")
        device.prompt(text)
    elif cmd == "log":
        cmd_log(state, "-f" in args)
    elif cmd == "wait":
        (what,) = operands(1, "wait screen|exit [SECS] | wait log REGEX [SECS]")
        pattern = None
        if what == "log":
            _, pattern = operands(2, "wait log REGEX [SECS]")
            del args[1]
        elif what not in ("screen", "exit"):
            sys.exit("usage: dev/emulate wait screen|exit [SECS] | wait log REGEX [SECS]")
        cmd_wait(state, what, pattern, number(args[1], float) if len(args) > 1 else 30)
    elif cmd == "status":
        cmd_status(state)
    elif cmd == "powercut":
        force = "--force" in args
        args = [a for a in args if a != "--force"]
        (out,) = operands(1, "powercut [--force] OUT.img")
        cmd_powercut(state, out, force)
    elif cmd == "stop":
        cmd_stop(state)
    elif cmd == "exec":
        secs = number(flag(args, "--for", "0"), float)
        cmd_exec(state, args, secs)
    elif cmd == "mkstick":
        size, force = flag(args, "--size"), "--force" in args
        args = [a for a in args if a != "--force"]
        if not args:
            sys.exit("usage: dev/emulate mkstick IMG [--size MB] [--force] [TREE]")
        cmd_mkstick(args[0], number(size) if size else None, force, args[1] if len(args) > 1 else None, profile)
    else:
        sys.exit(f"dev/emulate: unknown command {cmd}\n{USAGE}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BrokenPipeError:
        pass
    except Exception as e:
        if cm is not None and isinstance(e, cm.Error):
            sys.exit(f"dev/emulate: {e}")
        raise
