#!/bin/sh
# Makes a neochumby stick: any FAT-formatted USB stick, mounted at STICK.
# Plugged into a Chumby at power-on, it takes the Chumby from its stock
# firmware to Linux 7, with its own apps; nothing on the Chumby is changed, and
# without the stick it boots as it always did. A neochumby.conf beside it
# (server=...) offers pairing with a neochumbyd, for apps that need one.
#
# DIR holds the sideload's files (tools/tree has which):
#
#   dist/fetch DIR    (or dist/build DIR)
#   tools/neochumby-kernel-sideloader/build DIR
#   tools/stick STICK --sideload DIR [-d DATA] [APP ...]    (as tools/tree)
set -eu
stick=${1:?usage: tools/stick STICK --sideload DIR [-d DATA] [APP ...]}
shift
root=$(git rev-parse --show-toplevel)
"$root/tools/tree" "$stick/neochumby" "$@"
[ -f "$stick/neochumby/sideload/zImage" ] || {
  echo "tools/stick: no --sideload DIR: this stick can't leave the stock firmware" >&2
  exit 2
}
# Nothing syncs into a stick made by hand, so it carries no receiver.
rm -f "$stick/neochumby/neochumby-sync"
cp "$root/boot/userhook2" "$stick/userhook2"
echo "neochumby stick ready: $stick"
