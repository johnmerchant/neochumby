#!/bin/sh
# Builds the tree (tools/tree, with the APPs given) and installs it in a
# neochumbyd's state directory on HOST, with neochumbyd itself beside it: the
# tree its Chumbys' sticks sync from. What is already there and not in this
# tree (game data, other apps) is left alone. rsync puts each file in under a
# temporary name and renames them all at the end, so a round that starts after
# it sees the whole tree. With --restart, each Chumby NAMEd is asked over ssh to
# sync now and wait for it (`neochumbyd sync NAME`), then to restart, which runs
# the new set (`neochumbyd restart NAME`); a new kernel or initramfs in the tree
# needs a reboot too. Without --restart, Chumbys get it at their next round,
# within the minute, and run it from their next restart or boot. With --tree
# DIR, a tree tools/tree already built is installed instead (dev/emulate
# --device does this); its companions must be built for HOST.
#
# neochumbyd and the companions are built for HOST's machine, which is asked
# over ssh (`uname -sm`): x86_64 or 64-bit ARM Linux, or a machine like the
# one building them. --server-target TRIPLE names it instead (tools/tree).
#
#   tools/deploy HOST [APP ...] [--tree DIR] [--server-target TRIPLE]
#                [--restart NAME ...]
#                                  NEOCHUMBYD_DIR: default /var/lib/neochumbyd
#                                  (zig on PATH)
set -eu
usage="usage: tools/deploy HOST [APP ...] [--tree DIR] [--server-target TRIPLE] [--restart NAME ...]"
host=${1:?$usage}
shift
dir=${NEOCHUMBYD_DIR:-/var/lib/neochumbyd}

# The APPs stay in "$@"; the NAMEs after --restart are collected apart.
names=
restart=
built=
server_t=
n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  if [ "$a" = --tree ] && [ "$n" -gt 0 ]; then
    built=$(cd "$1" && pwd)
    shift
    n=$((n - 1))
  elif [ "$a" = --server-target ] && [ "$n" -gt 0 ]; then
    server_t=$1
    shift
    n=$((n - 1))
  elif [ "$a" = --restart ]; then
    restart=1
  elif [ -n "$restart" ]; then
    case $a in
    *[!a-z0-9_-]* | '') echo "$usage: not a Chumby's name: $a" >&2 && exit 2 ;;
    esac
    names="$names $a"
  else
    set -- "$@" "$a"
  fi
done
[ -n "$restart" ] && [ -z "$names" ] && echo "$usage" >&2 && exit 2
root=$(git rev-parse --show-toplevel)
cd "$root"

host_t=$(rustc -vV | sed -n 's/^host: //p')
if [ -z "$server_t" ]; then
  machine=$(ssh "$host" uname -sm)
  case $machine in
    "Linux x86_64") server_t=x86_64-unknown-linux-musl ;;
    "Linux aarch64" | "Linux arm64") server_t=aarch64-unknown-linux-musl ;;
    *)
      # Another kind of machine: only one like this one, natively.
      if [ "$(uname -sm)" = "$machine" ]; then
        server_t=$host_t
      else
        echo "tools/deploy: $host is $machine: give --server-target (tools/tree lists them)" >&2
        exit 2
      fi
      ;;
  esac
fi
[ "$server_t" = host ] && server_t=$host_t

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if [ -n "$built" ]; then
  cp -R "$built" "$tmp/tree"
else
  tools/tree "$tmp/tree" --server-target "$server_t" "$@"
fi
# As released: with wasm companions (Wasmtime).
cargo build --release --target "$server_t" -p neochumbyd --features wasm-companions
# Keeping its time: an unchanged binary is then not sent, nor the daemon
# restarted.
cp -p "target/$server_t/release/neochumbyd" "$tmp/"

rsync -rlpt --delay-updates "$tmp/tree/" "$host:$dir/tree/"
rsync -pt --delay-updates "$tmp/neochumbyd" "$host:$dir/neochumbyd"

# A restarted daemon (a new binary) takes a few seconds before each Chumby
# is back; neochumbyd sync and restart wait for it. A Chumby still running the
# set it would write has to restart first (sync says so, with status 3): then
# it syncs, and restarts again on what that brought.
remote() { ssh "$host" "'$dir/neochumbyd' $1 $2 --state '$dir'"; }
for name in $names; do
  r=0
  remote sync "$name" || r=$?
  if [ "$r" -eq 3 ]; then
    remote restart "$name"
    tries=0
    until r=0 && remote sync "$name"; do
      r=$?
      tries=$((tries + 1))
      [ "$tries" -lt 5 ] || exit "$r"
      sleep 5
    done
  elif [ "$r" -ne 0 ]; then
    exit "$r"
  fi
  remote restart "$name"
done
