#!/bin/sh
# chumpwn placeholder userspace.
#
# This is deliberately a directory: replace this file and the BusyBox
# binary with your own init and tree, rebuild the cpio, and chumpwn's
# --initramfs argument loads it unchanged.  BusyBox is only here to give
# the demo a shell.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TERM=vt100
export PS1="chumpwn# "
/bin/busybox --install -s /bin 2>/dev/null || true

mkdir -p /proc /sys /dev /tmp /mnt
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3

echo
echo "### chumpwn: Linux 5.9.16 userspace reached ###"
uname -a
echo "--- /proc/version ---"
cat /proc/version
echo "--- /proc/cmdline ---"
cat /proc/cmdline
echo "--- /proc/mtd ---"
if [ -e /proc/mtd ]; then cat /proc/mtd; else echo "absent: no /proc/mtd"; fi
echo "--- /dev/mtd* ---"
if ls /dev/mtd* >/dev/null 2>&1; then ls -l /dev/mtd*; else echo "absent: no /dev/mtd*"; fi
echo "--- dmesg | grep -i nand ---"
if dmesg | grep -i nand; then :; else echo "absent: no NAND in dmesg"; fi
echo "--- /sys/class/mtd ---"
if [ -e /sys/class/mtd ]; then ls -l /sys/class/mtd; else echo "absent: no /sys/class/mtd"; fi
echo "--- NAND platform devices ---"
if ls /sys/bus/platform/devices 2>/dev/null | grep -i nand; then :; else echo "absent: no NAND platform device"; fi
echo "### chumpwn: starting shell (replace this initramfs with your userspace) ###"

exec setsid -c /bin/sh -i </dev/console >/dev/console 2>&1
