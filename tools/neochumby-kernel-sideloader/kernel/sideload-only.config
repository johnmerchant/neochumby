# Linux 5.9.16 for the Chumby Classic, sideload-only: no MTD/NAND at all.
# Applied on top of arch/arm/configs/imx_v4_v5_defconfig.
CONFIG_MODULES=n
CONFIG_MTD=n
CONFIG_MTD_NAND=n
CONFIG_MTD_NAND_MXC=n
CONFIG_MTD_CMDLINE_PARTS=n
CONFIG_CRAMFS=n
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CMDLINE="console=ttymxc0,115200 rdinit=/init"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_LOCALVERSION="-mx21-sideload-only"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ATAGS=y
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_MACH_MX21ADS=y
CONFIG_SOC_IMX21=y
CONFIG_AEABI=y
CONFIG_MACH_MX27ADS=n
CONFIG_MACH_MX27_3DS=n
CONFIG_MACH_IMX27_VISSTRIM_M10=n
CONFIG_MACH_IMX27_DT=n
CONFIG_SOC_IMX1=n
CONFIG_SOC_IMX25=n
CONFIG_SOC_IMX27=n
CONFIG_SOC_IMX31=n
CONFIG_SOC_IMX35=n
