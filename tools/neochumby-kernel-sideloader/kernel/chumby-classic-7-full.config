# Linux 7.3.1 for the Chumby Classic, module handoff: panel console and
# watchdog, no MTD/NAND, no network, USB, sound, storage or touch.
#
# Applied after dist/kernel/stable/linux.fragment, which starts from
# imx_v4_v5_defconfig.  The 7.x kernel boots from the device tree appended
# to the zImage; the module passes the ATAGS command line and memory.
CONFIG_MODULES=n
CONFIG_MTD=n
CONFIG_MTD_NAND=n
CONFIG_MTD_NAND_MXC=n
CONFIG_MTD_CMDLINE_PARTS=n
CONFIG_CRAMFS=n
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CMDLINE="console=ttymxc0,115200 rdinit=/init"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_LOCALVERSION="-mx21-sideload"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KERNEL_XZ=y
CONFIG_RD_XZ=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_ATAGS=y
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_SOC_IMX21=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_AEABI=y
CONFIG_MACH_MX27ADS=n
CONFIG_MACH_MX27_3DS=n
CONFIG_MACH_IMX27_VISSTRIM_M10=n
CONFIG_MACH_IMX27_DT=n
CONFIG_SOC_IMX1=n
CONFIG_SOC_IMX25=n
CONFIG_SOC_IMX27=n
CONFIG_SOC_IMX31=n
CONFIG_SOC_IMX35=n

# The panel: imxfb on the Chumby DT, the graphic window if this kernel has
# it, and the console in Spleen 5x8 (64x30 on 320x240).
CONFIG_FB=y
CONFIG_FB_IMX=y
CONFIG_FB_IMX_GRAPHIC_WINDOW=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
# CONFIG_FONT_8x8 is not set
CONFIG_FONT_SPLEEN_5x8=y
CONFIG_LOGO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_IMX1=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_IMX21_KPP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# The watchdog: a hang reboots into the stock firmware.
CONFIG_WATCHDOG=y
CONFIG_IMX2_WDT=y

# Keep the decompressed Image below the 8 MiB mark at 0xc0800000, so the
# module's initrd block there is not overwritten during decompression.
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_NET is not set
# CONFIG_MMC is not set
# CONFIG_EXT4_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_HWMON is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_SERIO is not set

# VT selects INPUT; keep the core, drop every input driver.
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_KEYBOARD_GPIO_POLLED is not set

# The TSC2100 touchscreen and codec, the accelerometer and the SPI bus.
# CONFIG_MFD_TSC2100 is not set
# CONFIG_TOUCHSCREEN_TSC2100 is not set
# CONFIG_SND_SOC_TSC2100 is not set
# CONFIG_SND_SOC_IMX_TSC2100 is not set
# CONFIG_IIO is not set
# CONFIG_SPI is not set

# Nothing else needs a bus or a block device.
# CONFIG_I2C is not set
# CONFIG_W1 is not set
# CONFIG_DMADEVICES is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_LEDS_CLASS is not set
# CONFIG_EEPROM_AT24 is not set
# CONFIG_EEPROM_AT25 is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_ATA is not set
# CONFIG_PATA_IMX is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_NLS_CODEPAGE_437 is not set
# CONFIG_NLS_ISO8859_1 is not set

# Full Chumby features, as modules in the initramfs.  The kernel keeps
# only the core, panel console and watchdog; the 4 MiB initramfs block
# carries these modules and the WiFi firmware.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETFILTER=n
CONFIG_NETDEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=m
CONFIG_USB_IMX21_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_HID=m
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_INPUT_EVDEV=m
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO_POLLED=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_MFD_TSC2100=m
CONFIG_TOUCHSCREEN_TSC2100=m
CONFIG_SPI=m
CONFIG_SPI_IMX=m
CONFIG_IIO=m
CONFIG_KXP74=m
CONFIG_EEPROM_AT25=m
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_OSSEMUL=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_SOC=m
CONFIG_SND_SOC_TSC2100=m
CONFIG_SND_SOC_IMX_TSC2100=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RT2X00=m
CONFIG_RT73USB=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RFKILL=m
CONFIG_FW_LOADER=y
CONFIG_NFS_FS=m
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_ACL_SUPPORT=m
CONFIG_SUNRPC=m
CONFIG_LOCKD=m
CONFIG_DNS_RESOLVER=m
CONFIG_NFS_USE_KERNEL_DNS=y
CONFIG_VFAT_FS=m
CONFIG_FAT_FS=m
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_DMADEVICES=y
CONFIG_IMX_DMA=m
CONFIG_IMX_SDMA=m
CONFIG_KUSER_HELPERS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_MTD=n
# CONFIG_CS89x0 is not set
# CONFIG_DM9000 is not set
# CONFIG_SMC91X is not set
# CONFIG_SMC911X is not set
# CONFIG_SMSC911X is not set
# CONFIG_SMSC_PHY is not set

# No signed modules or trusted keyring: this kernel only loads the modules
# packed beside it in the initramfs.
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_REVOCATION_LIST is not set
# CONFIG_MODULE_SIG is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
