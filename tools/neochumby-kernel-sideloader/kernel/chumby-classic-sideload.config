# Linux 5.9.16 for the real Chumby Classic, sideload-only: no MTD/NAND.
# Applied on top of arch/arm/configs/imx_v4_v5_defconfig.
CONFIG_MODULES=n
CONFIG_MTD=n
CONFIG_MTD_NAND=n
CONFIG_MTD_NAND_MXC=n
CONFIG_MTD_CMDLINE_PARTS=n
CONFIG_CRAMFS=n
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CMDLINE="console=ttymxc0,115200 rdinit=/init"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_LOCALVERSION="-mx21-sideload"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KERNEL_XZ=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_ATAGS=y
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_SOC_IMX21=y
CONFIG_AEABI=y
CONFIG_MACH_MX27ADS=n
CONFIG_MACH_MX27_3DS=n
CONFIG_MACH_IMX27_VISSTRIM_M10=n
CONFIG_MACH_IMX27_DT=n
CONFIG_SOC_IMX1=n
CONFIG_SOC_IMX25=n
CONFIG_SOC_IMX27=n
CONFIG_SOC_IMX31=n
CONFIG_SOC_IMX35=n

# The board: the Chumby boot loader enters the kernel as an MX21ADS.
# CONFIG_MACH_MX21ADS is not set
CONFIG_MACH_CHUMBY_CLASSIC=y

# The screen: imxfb on the Chumby panel, the graphic window as fb1, and
# the console on fb0 in Spleen 5x8 (64x30 characters on 320x240).
CONFIG_FB=y
CONFIG_FB_IMX=y
CONFIG_FB_IMX_GRAPHIC_WINDOW=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
# CONFIG_FONT_8x8 is not set
CONFIG_FONT_SPLEEN_5x8=y
CONFIG_LOGO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_IMX1=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_GENERIC_PLATFORM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# The watchdog: a hang reboots into the stock firmware.
CONFIG_WATCHDOG=y
CONFIG_IMX2_WDT=y

# Keep the decompressed Image below the 8 MiB mark at 0xc0800000, so a
# module-reserved initrd there is not overwritten during decompression.
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_NET is not set
# CONFIG_MMC is not set
# CONFIG_EXT4_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_HWMON is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_SERIO is not set

# VT selects INPUT; keep the core, drop every input driver.
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_MISC is not set

# Nothing else needs a bus or a block device.
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_W1 is not set
# CONFIG_DMADEVICES is not set
# CONFIG_IIO is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_LEDS_CLASS is not set
# CONFIG_EEPROM_AT24 is not set
# CONFIG_EEPROM_AT25 is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_ATA is not set
# CONFIG_PATA_IMX is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_NLS_CODEPAGE_437 is not set
# CONFIG_NLS_ISO8859_1 is not set
