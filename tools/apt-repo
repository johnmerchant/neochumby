#!/bin/sh
# Lays out a signed apt repository of the .debs in DEBS: OUT/apt, a static
# site, rebuilt whole each time.
#
#   tools/apt-repo DEBS OUT KEYID      (apt-ftparchive, gpg with KEYID's secret key)
set -eu
[ $# -eq 3 ] || {
  echo "usage: tools/apt-repo DEBS OUT KEYID" >&2
  exit 2
}
debs=$1 out=$2 key=$3
mkdir -p "$out/apt/pool/main"
cp "$debs"/*.deb "$out/apt/pool/main/"
cd "$out/apt"
for arch in amd64 arm64; do
  dir=dists/stable/main/binary-$arch
  mkdir -p "$dir"
  apt-ftparchive --arch "$arch" packages pool > "$dir/Packages"
  gzip -9nkf "$dir/Packages"
done
apt-ftparchive \
  -o APT::FTPArchive::Release::Origin=neochumby \
  -o APT::FTPArchive::Release::Label=neochumby \
  -o APT::FTPArchive::Release::Suite=stable \
  -o APT::FTPArchive::Release::Codename=stable \
  -o APT::FTPArchive::Release::Architectures="amd64 arm64" \
  -o APT::FTPArchive::Release::Components=main \
  release dists/stable > ../Release
mv ../Release dists/stable/Release
gpg --batch --yes --local-user "$key" --clearsign -o dists/stable/InRelease dists/stable/Release
gpg --batch --yes --local-user "$key" -abs -o dists/stable/Release.gpg dists/stable/Release
gpg --armor --export "$key" > key.gpg
