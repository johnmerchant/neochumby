#!/bin/sh
# Builds and lays out the tree a Chumby runs neochumby from, the same on a
# stick and in a neochumbyd's export:
#
#   OUT/neochumby        the session
#   OUT/userhook2        the boot hook, which pairing installs
#   OUT/apps/home/       the home screen, always
#   OUT/apps/<app>/      each APP asked for
#
# An app is the crate neochumby-<app> in apps/<app>/. Its manifest names its
# binaries: exec, service and home are built for the Chumby, companion for
# neochumbyd's host. apps/<app>/files/, if there is one, is copied as it is.
#
# Game data is never in the repo: with -d DATA, a tree of the same shape
# holding your own copies (apps/doom/doom1.wad, apps/quake/id1/pak0.pak),
# it is copied in on top.
#
#   tools/tree OUT [-d DATA] [APP ...]    e.g. tools/tree /tmp/t doom quake
#                                         (zig on PATH)
set -eu
out=${1:?usage: tools/tree OUT [-d DATA] [APP ...]}
shift
data=
if [ "${1:-}" = -d ]; then
  data=$2
  shift 2
fi
root=$(git rev-parse --show-toplevel)
chumby=$root/target/armv5te-unknown-linux-musleabi/release
server=$root/target/x86_64-unknown-linux-musl/release
cd "$root"

field() { sed -n "s/^$2=//p" "apps/$1/manifest" | head -n 1; }

cargo chumby
mkdir -p "$out"
cp "$chumby/neochumby" boot/userhook2 "$out/"

for app in home "$@"; do
  [ -f "apps/$app/manifest" ] || {
    echo "tools/tree: no app $app (apps/$app/manifest)" >&2
    exit 1
  }
  dest=$out/apps/$app
  mkdir -p "$dest"
  cargo build --release --target armv5te-unknown-linux-musleabi -p "neochumby-$app"
  for key in exec service home; do
    f=$(field "$app" "$key")
    [ -z "$f" ] || cp "$chumby/$f" "$dest/"
  done
  c=$(field "$app" companion)
  if [ -n "$c" ]; then
    cargo build --release --target x86_64-unknown-linux-musl -p "neochumby-$app" --bin "$c"
    cp "$server/$c" "$dest/"
  fi
  cp "apps/$app/manifest" "$dest/"
  [ ! -d "apps/$app/files" ] || cp -R "apps/$app/files/." "$dest/"
done
[ -z "$data" ] || cp -R "$data/." "$out/"
