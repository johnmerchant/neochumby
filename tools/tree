#!/bin/sh
# Builds and lays out the tree a Chumby runs neochumby from, the same on a
# stick and in a neochumbyd's export:
#
#   OUT/neochumby        the session
#   OUT/neochumby-sync   the receiver, which keeps a paired stick's sets in
#                        step with its neochumbyd
#   OUT/sideload/        what that hook needs on the stock firmware to reach
#                        Linux 7: neochumby-handoff, always, and with
#                        --sideload DIR sideload.ko, zImage and
#                        initramfs.cpio.gz, from DIR/sideload.ko
#                        (tools/neochumby-kernel-sideloader/build DIR) and
#                        DIR/sideload-zImage and sideload-rootfs.cpio.gz
#                        (dist/fetch DIR or dist/build DIR). Without them,
#                        which is enough for an emulated Chumby or one already
#                        on Linux 7, stock boots as it always did
#   OUT/colors           the colour schemes text-mode apps can be drawn in
#                        (colors=, neochumby::term::colors), made by
#                        neochumby-colors from ours (crates/neochumby/themes),
#                        then themes' own repositories
#                        (crates/neochumby/third_party/themes), then
#                        iTerm2-Color-Schemes (a submodule, fetched here)
#   OUT/colors.LICENSE   their licences
#   OUT/apps/home/       neochumby-home, the app list, always
#   OUT/apps/catalog/    neochumby-catalog, GET APPS, always
#   OUT/apps/<name>/     each APP asked for
#   OUT/lib/             the shared libraries its apps that use curses link
#                        (tools/linux-libs): musl, as ld-musl-arm.so.1,
#                        libncursesw.so.6 and libpanelw.so.6
#
# An app is a crate named neochumby-<name>, whose Cargo.toml has a
# [package.metadata.neochumby] table naming its binaries (exec and service
# are built for the Chumby, wasm for wasm32-wasip1 and compiled for it by
# tools/wamrc, companion and server for neochumbyd's host); the tree's
# manifest is made from it (neochumby-manifest). A files/ directory beside
# its Cargo.toml, if it has one, is copied as it is. An APP is one of:
#
#   doom                          apps/doom in this repository
#   ./path, /path                 a crate on this machine
#   git+URL[#REV]                 a crate at the root of a git repository,
#                                 at commit REV (else the default branch's
#                                 head, whose commit is printed to pin)
#   crate:NAME[@VERSION]          a crate from crates.io (else its newest),
#                                 checked against the index's SHA-256
#
# What an app's binaries are built from runs on a Chumby (its companion on
# the server), so pin it: a full commit id for git+ (a branch or tag can
# move), a version for crate:. Unpinned, tools/tree warns; with --pinned
# it refuses.
#
# Game data is never in the repo: with -d DATA, a tree of the same shape
# holding your own copies (apps/doom/doom1.wad, apps/quake/id1/pak0.pak),
# it is copied in on top.
#
# Companions are built for the machine neochumbyd runs on, named by
# --server-target, a Rust target triple (CPU, vendor, OS, C library):
#
#   x86_64-unknown-linux-musl     a PC running Linux (the default)
#   aarch64-unknown-linux-musl    64-bit ARM Linux, such as a Raspberry Pi
#   host                          the machine building it, natively (a Mac,
#                                 say, to run neochumbyd there)
#
# The Chumby's binaries are static, but for one kind of app: one that links
# neochumby-ncurses links it, and musl, dynamically, against OUT/lib's
# (NEOCHUMBY_NCURSES=system), which the session's jail puts at /lib for it
# (crates/neochumby/src/bin/neochumby/jail.rs).
#
#   tools/tree OUT [-d DATA] [--sideload DIR] [--server-target TRIPLE] [--pinned] [APP ...]
#       e.g. tools/tree /tmp/t doom quake
#       (zig, git, curl, make, patch, pkg-config and sha256sum or shasum on
#       PATH)
set -eu
usage="usage: tools/tree OUT [-d DATA] [--sideload DIR] [--server-target TRIPLE] [--pinned] [APP ...]"
out=${1:?$usage}
shift
data=
sideload=
server_t=x86_64-unknown-linux-musl
pinned=
while :; do
  case ${1:-} in
    -d)
      data=${2:?$usage}
      shift 2
      ;;
    --sideload)
      sideload=${2:?$usage}
      shift 2
      ;;
    --server-target)
      server_t=${2:?$usage}
      shift 2
      ;;
    --pinned)
      pinned=1
      shift
      ;;
    *) break ;;
  esac
done
host_t=$(rustc -vV | sed -n 's/^host: //p')
[ "$server_t" = host ] && server_t=$host_t
case $server_t in
  x86_64-unknown-linux-musl | aarch64-unknown-linux-musl | "$host_t") ;;
  *)
    echo "tools/tree: --server-target $server_t: x86_64-unknown-linux-musl," \
      "aarch64-unknown-linux-musl or host ($host_t)" >&2
    exit 2
    ;;
esac
[ -z "$sideload" ] || sideload=$(cd "$sideload" && pwd)
root=$(git rev-parse --show-toplevel)
cd "$root"
chumby_t=armv5te-unknown-linux-musleabi
# Fetched apps: outside the repository, which cargo would otherwise take
# for workspace members.
sources=${XDG_CACHE_HOME:-$HOME/.cache}/neochumby/app-sources
mkdir -p "$sources"

# Outside this repository's workspace .cargo/config.toml does not apply:
# the same toolchain, by environment.
export CARGO_TARGET_ARMV5TE_UNKNOWN_LINUX_MUSLEABI_LINKER=$root/tools/zigcc
export CARGO_TARGET_ARMV5TE_UNKNOWN_LINUX_MUSLEABI_RUSTFLAGS="-C link-self-contained=no -C target-cpu=arm926ej-s"
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=$root/tools/zigcc-x86_64
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C link-self-contained=no"
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=rust-lld
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C linker-flavor=ld.lld -C link-self-contained=yes"
export CC_armv5te_unknown_linux_musleabi=$root/tools/zigcc AR_armv5te_unknown_linux_musleabi=$root/tools/zigar
export CMAKE_TOOLCHAIN_FILE_armv5te_unknown_linux_musleabi=$root/tools/armv5te.cmake
export CC_x86_64_unknown_linux_musl=$root/tools/zigcc-x86_64 AR_x86_64_unknown_linux_musl=$root/tools/zigar
export CC_aarch64_unknown_linux_musl=$root/tools/zigcc-aarch64 AR_aarch64_unknown_linux_musl=$root/tools/zigar
# wasm apps: a 1 MiB stack, not the 16 MiB that some runtimes commit up front
# (docs/proposals/0003-wasm-apps.md).
export CARGO_TARGET_WASM32_WASIP1_RUSTFLAGS="-C link-arg=-zstack-size=1048576"

field() { sed -n "s/^$2=//p" "$1" | head -n 1; }

# An app that isn't pinned: refused with --pinned, else a warning.
unpinned() {
  if [ -n "$pinned" ]; then
    echo "tools/tree: $1 (refused: --pinned)" >&2
    exit 1
  fi
  echo "tools/tree: warning: $1" >&2
}

sha256() {
  if command -v sha256sum > /dev/null; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# Where crates.io's sparse index keeps NAME (lower case): 1/a, 2/ab,
# 3/a/abc, then ab/cd/abcd...
index_path() {
  case ${#1} in
    1) echo "1/$1" ;;
    2) echo "2/$1" ;;
    3) echo "3/$(printf %s "$1" | cut -c1)/$1" ;;
    *) echo "$(printf %s "$1" | cut -c1-2)/$(printf %s "$1" | cut -c3-4)/$1" ;;
  esac
}

# The crate directory an APP names, fetched if need be.
fetch() {
  case $1 in
    git+*)
      url=${1#git+}
      rev=
      case $url in *'#'*)
        rev=${url##*#}
        url=${url%#*}
        ;;
      esac
      if [ -z "$rev" ]; then
        unpinned "$1 isn't pinned: add #COMMIT"
      else
        # A full commit id (SHA-1 or SHA-256), not a name that can move.
        full=
        case $rev in
          *[!0-9a-f]*) ;;
          *) case ${#rev} in 40 | 64) full=1 ;; esac ;;
        esac
        [ -n "$full" ] || unpinned "$1: #$rev isn't a full commit id, and a branch or tag can move"
      fi
      dir=$sources/git-$(printf %s "$url" | cksum | cut -d' ' -f1)
      [ -d "$dir/.git" ] || git clone --quiet "$url" "$dir"
      git -C "$dir" fetch --quiet origin
      if [ -z "$rev" ]; then
        rev=$(git -C "$dir" rev-parse origin/HEAD)
        echo "tools/tree: $url at $rev (add #$rev to pin it)" >&2
      fi
      git -C "$dir" checkout --quiet --detach "$rev"
      git -C "$dir" submodule update --quiet --init --recursive >&2
      echo "$dir"
      ;;
    crate:*)
      name=${1#crate:}
      version=
      case $name in *@*)
        version=${name#*@}
        name=${name%@*}
        ;;
      esac
      ua="neochumby tools/tree (https://github.com/johnmerchant/neochumby)"
      if [ -z "$version" ]; then
        unpinned "$1 isn't pinned: add @VERSION"
        version=$(curl -fsS -A "$ua" "https://crates.io/api/v1/crates/$name" |
          sed -n 's/.*"max_stable_version":"\([^"]*\)".*/\1/p')
        [ -n "$version" ] || {
          echo "tools/tree: no such crate on crates.io: $name" >&2
          exit 1
        }
      fi
      dir=$sources/crate-$name-$version
      if [ ! -d "$dir" ]; then
        # The index's checksum for this version, and the download's.
        lower=$(printf %s "$name" | tr '[:upper:]' '[:lower:]')
        want=$(curl -fsS -A "$ua" "https://index.crates.io/$(index_path "$lower")" |
          grep -F "\"vers\":\"$version\"," |
          sed -n 's/.*"cksum":"\([0-9a-f]\{64\}\)".*/\1/p' | head -n 1)
        [ -n "$want" ] || {
          echo "tools/tree: $name $version isn't in crates.io's index" >&2
          exit 1
        }
        rm -rf "$dir.tmp" "$dir.crate"
        curl -fsSL -A "$ua" -o "$dir.crate" "https://crates.io/api/v1/crates/$name/$version/download"
        got=$(sha256 "$dir.crate")
        [ "$got" = "$want" ] || {
          rm -f "$dir.crate"
          echo "tools/tree: $name $version: SHA-256 $got, but the index says $want" >&2
          exit 1
        }
        mkdir -p "$dir.tmp"
        tar -xzf "$dir.crate" -C "$dir.tmp" --strip-components 1
        rm -f "$dir.crate"
        mv "$dir.tmp" "$dir"
      fi
      echo "$dir"
      ;;
    ./* | ../* | /*) (cd "$1" && pwd) ;;
    *)
      # The third-party C it builds is in submodules.
      git -C "$root" submodule update --quiet --init --recursive -- "apps/$1" crates >&2
      echo "$root/apps/$1"
      ;;
  esac
}

# Whether $crate (at $src) links neochumby-ncurses, on the Chumby.
uses_curses() {
  cargo tree -q --manifest-path "$src/Cargo.toml" -p "$crate" --target $chumby_t -e normal --prefix none |
    grep -q '^neochumby-ncurses '
}
# The shared libraries, and how an app that uses curses is linked against
# them: dynamically, and
# position-independent. A fixed-address executable would take copies of
# libc's data (environ, optarg and the like) by copy relocation, and zig's
# stand-in for libc.so, which it links against, has them all at one
# address: the copies would overlap.
libs=$root/target/linux-libs
dynamic="-C target-feature=-crt-static -C relocation-model=pic -C link-arg=-pie"

cargo chumby
cargo build -q --release -p neochumby-manifest
mkdir -p "$out"
tools/linux-libs "$libs"
# Plain files, under the names the binaries ask for: a FAT stick holds no
# links. musl's libc.so is its own loader, and answers for libc.so.
mkdir -p "$out/lib"
cp "$libs/lib/ld-musl-arm.so.1" "$libs/usr/lib/libncursesw.so.6" "$libs/usr/lib/libpanelw.so.6" "$out/lib/"
cp "target/$chumby_t/release/neochumby" "target/$chumby_t/release/neochumby-sync" "$out/"
# What the boot hook needs on stock, in a workspace of its own.
cargo build -q --release --manifest-path crates/neochumby-handoff/Cargo.toml \
  --target $chumby_t --target-dir target/handoff
mkdir -p "$out/sideload"
cp "target/handoff/$chumby_t/release/neochumby-handoff" "$out/sideload/"
if [ -n "$sideload" ]; then
  cp "$sideload/sideload.ko" "$out/sideload/sideload.ko"
  cp "$sideload/sideload-zImage" "$out/sideload/zImage"
  cp "$sideload/sideload-rootfs.cpio.gz" "$out/sideload/initramfs.cpio.gz"
fi
# The colour schemes. iTerm2-Color-Schemes is large and only this needs
# it, so its submodule isn't checked out with the rest (update = none):
# here, at the commit pinned, without its history.
schemes=crates/neochumby/third_party/iTerm2-Color-Schemes
git -C "$root" submodule update --quiet --init --checkout --depth 1 -- "$schemes" >&2
target/release/neochumby-colors crates/neochumby/themes crates/neochumby/third_party/themes/*/ghostty \
  "$schemes/ghostty" > "$out/colors"
{
  echo "OUT/colors: neochumby's colour schemes, from these sources under these licences."
  echo
  echo "== neochumby's own (crates/neochumby/themes; GitHub Dark is GitHub's Primer palette, MIT)"
  cat crates/neochumby/LICENSE
  for d in crates/neochumby/third_party/themes/*/; do
    echo
    echo "== $(sed -n 1p "$d/SOURCE") at $(sed -n 2p "$d/SOURCE")"
    cat "$d/LICENSE"
  done
  echo
  echo "== https://github.com/mbadolato/iTerm2-Color-Schemes at $(git -C "$schemes" rev-parse HEAD)"
  cat "$schemes/LICENSE"
} > "$out/colors.LICENSE"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
built_catalog=0

for app in home catalog "$@"; do
  # Always here, whether asked for or not: once is enough.
  if [ "$built_catalog" = 1 ] && [ "$app" = catalog ]; then continue; fi
  [ "$app" = catalog ] && built_catalog=1
  src=$(fetch "$app")
  [ -f "$src/Cargo.toml" ] || {
    echo "tools/tree: $app: no Cargo.toml at $src" >&2
    exit 1
  }
  # Checks the crate's name and metadata, and fails with what is wrong.
  manifest=$work/manifest
  target/release/neochumby-manifest "$src/Cargo.toml" > "$manifest"
  crate=$(sed -n 's/^name *= *"\(neochumby-[a-z0-9_-]*\)".*/\1/p' "$src/Cargo.toml" | head -n 1)
  name=${crate#neochumby-}
  # This repository's apps build in its workspace; others in their own,
  # beside it.
  case $src in
    "$root"/apps/*) bin=$root/target ;;
    *) bin=$root/target/apps/$name ;;
  esac
  build() { cargo build --release --manifest-path "$src/Cargo.toml" --target-dir "$bin" "$@"; }

  dest=$out/apps/$name
  mkdir -p "$dest"
  # The Chumby's binaries, if it has any: an app may be only a server
  # program. Linked dynamically if it uses curses, in a target directory of their own (their flags differ).
  chumby_bin=$bin
  if [ -n "$(field "$manifest" exec)$(field "$manifest" service)$(field "$manifest" transition)" ]; then
    if uses_curses; then
      chumby_bin=$bin/shared
      NEOCHUMBY_NCURSES=system PKG_CONFIG_SYSROOT_DIR=$libs PKG_CONFIG_LIBDIR=$libs/usr/lib/pkgconfig \
        PKG_CONFIG_PATH='' PKG_CONFIG_ALLOW_SYSTEM_CFLAGS=1 PKG_CONFIG_ALLOW_SYSTEM_LIBS=1 \
        CARGO_TARGET_ARMV5TE_UNKNOWN_LINUX_MUSLEABI_RUSTFLAGS="$CARGO_TARGET_ARMV5TE_UNKNOWN_LINUX_MUSLEABI_RUSTFLAGS $dynamic" \
        cargo build --release --manifest-path "$src/Cargo.toml" --target-dir "$chumby_bin" --target $chumby_t -p "$crate"
    else
      build --target $chumby_t -p "$crate"
    fi
  fi
  for key in exec service transition; do
    f=$(field "$manifest" "$key")
    [ -z "$f" ] || cp "$chumby_bin/$chumby_t/release/$f" "$dest/"
  done
  # A wasm app: its module, and its compiled code when tools/wamrc can make
  # it (LLVM 18: nix develop .#wasm), recorded in its manifest; without,
  # the runner interprets it. The runner goes in the tree once.
  w=$(field "$manifest" wasm)
  if [ -n "$w" ]; then
    build --target wasm32-wasip1 -p "$crate" --bin "${w%.wasm}"
    cp "$bin/wasm32-wasip1/release/$w" "$dest/"
    if aot=$("$root/tools/wamrc" --compile "$dest/$w" "$dest/${w%.wasm}.aot"); then
      echo "$aot" >> "$manifest"
    else
      echo "tools/tree: $name: no compiled code (tools/wamrc failed): the runner interprets it" >&2
    fi
    if [ ! -f "$out/neochumby-wasm" ]; then
      cargo build -q --release --target $chumby_t -p neochumby-wasm
      cp "target/$chumby_t/release/neochumby-wasm" "$out/"
    fi
  fi
  # neochumbyd:<name> is one of neochumbyd's own (the catalog's, for GET
  # APPS): nothing to build.
  for key in companion server; do
    f=$(field "$manifest" "$key")
    case $f in
      '' | neochumbyd:*) ;;
      *)
        build --target $server_t -p "$crate" --bin "$f"
        cp "$bin/$server_t/release/$f" "$dest/"
        ;;
    esac
  done
  cp "$manifest" "$dest/manifest"
  [ ! -d "$src/files" ] || cp -R "$src/files/." "$dest/"
done
[ -z "$data" ] || cp -R "$data/." "$out/"
