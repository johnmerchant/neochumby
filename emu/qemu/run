#!/bin/sh
# run KERNEL NAND [QEMU OPTIONS...]: boots a zImage and a NAND image on
# QEMU's chumby-classic machine, with the console on stdio (unless a
# -serial option is given) and QMP on qmp.sock in the current directory.
#
# Uses $QEMU if set, else the binary emu/qemu/build made, else Nix's
# result (in emu/qemu or the current directory), else qemu-system-arm
# from PATH.
set -eu

if [ $# -lt 2 ]; then
    echo "usage: $0 KERNEL NAND [QEMU OPTIONS...]" >&2
    exit 2
fi
kernel=$1
nand=$2
shift 2

here=$(cd "$(dirname "$0")" && pwd)
if [ -z "${QEMU:-}" ]; then
    for q in "$here/build/obj/qemu-system-arm" "$here/result/bin/qemu-system-arm" \
        "$PWD/result/bin/qemu-system-arm"; do
        if [ -x "$q" ]; then
            QEMU=$q
            break
        fi
    done
fi
QEMU=${QEMU:-qemu-system-arm}

serial="-serial stdio"
for a in "$@"; do
    if [ "$a" = "-serial" ]; then
        serial=
    fi
done

# shellcheck disable=SC2086 # $serial is empty or two words.
exec "$QEMU" -M chumby-classic -kernel "$kernel" \
    -drive "if=mtd,file=$nand,format=raw" $serial \
    -qmp unix:qmp.sock,server=on,wait=off "$@"
