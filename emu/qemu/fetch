#!/bin/sh
# fetch: puts qemu-chumby's prebuilt qemu-system-arm, the one its CI built
# from the commit this repository pins for the submodule beside this
# script, in emu/qemu/out/obj/qemu-system-arm, where emu/qemu/build would
# have put it.
#
# qemu-chumby publishes a build for each commit on its main branch, for
# Linux x86_64 and aarch64 and macOS on Apple silicon, on its `prebuilt`
# release (its README, "Prebuilt binaries"): fetched without a token, its
# SHA-256 checked, and the binary run once to see that it has the machine
# and finds its libraries. Exits 0 with the binary in place; 1, leaving
# out/obj as it was, when there is no build for this commit and host (a
# commit not yet on qemu-chumby's main, or pruned), or it doesn't run here:
# then build it with emu/qemu/build, as CI does.
#
# Needs git, curl, tar and xz (or a tar that reads .tar.xz, as on macOS),
# and sha256sum or shasum. The commit is the one HEAD pins, not whatever the
# submodule has checked out; QEMU_CHUMBY_COMMIT overrides it.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
base=${QEMU_CHUMBY_PREBUILT:-https://github.com/johnmerchant/qemu-chumby/releases/download/prebuilt}

commit=${QEMU_CHUMBY_COMMIT:-$(cd "$here" && git rev-parse HEAD:./qemu-chumby)}
case $(uname -s)-$(uname -m) in
    Linux-x86_64) platform=linux-x86_64 ;;
    Linux-aarch64 | Linux-arm64) platform=linux-aarch64 ;;
    Darwin-arm64) platform=macos-arm64 ;;
    *) echo "fetch: no prebuilt QEMU for $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac
name=qemu-chumby-$commit-$platform

work=$here/out/prebuilt
rm -rf "$work"
mkdir -p "$work"
trap 'rm -rf "$work"' EXIT
cd "$work"

echo "fetching $base/$name.tar.xz"
if ! curl -fsSL --retry 3 -o "$name.tar.xz.sha256" "$base/$name.tar.xz.sha256" ||
    ! curl -fsSL --retry 3 -o "$name.tar.xz" "$base/$name.tar.xz"; then
    echo "fetch: no prebuilt QEMU for qemu-chumby $commit on $platform" >&2
    exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
    got=$(sha256sum "$name.tar.xz" | cut -d' ' -f1)
else
    got=$(shasum -a 256 "$name.tar.xz" | cut -d' ' -f1)
fi
want=$(cut -d' ' -f1 "$name.tar.xz.sha256")
if [ "$got" != "$want" ]; then
    echo "fetch: $name.tar.xz: SHA-256 is $got, expected $want" >&2
    exit 1
fi

if command -v xz >/dev/null 2>&1; then
    xz -dc "$name.tar.xz" | tar xf -
else
    tar xJf "$name.tar.xz"
fi
q=$work/$name/qemu-system-arm
if ! "$q" -machine help 2>&1 | grep -q '^chumby-classic '; then
    echo "fetch: the prebuilt QEMU doesn't run here:" >&2
    "$q" -machine help >&2 || true
    sed -n '/^Needs/,/^$/p' "$work/$name/RUNTIME" >&2
    exit 1
fi

mkdir -p "$here/out/obj"
cp "$q" "$here/out/obj/qemu-system-arm.part"
mv "$here/out/obj/qemu-system-arm.part" "$here/out/obj/qemu-system-arm"
echo "fetched $here/out/obj/qemu-system-arm (qemu-chumby $commit, $platform)"
