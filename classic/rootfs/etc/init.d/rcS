#!/bin/sh
# The Chumby's drivers and devices, as the stock boot (/etc/init.d/rcS on
# the stock root disk) brings them up: the same modules, in the same order,
# with the same arguments, and their nodes made from /proc/devices.
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs tmpfs /var
# The settings partition, empty and writable: nothing here touches NAND.
mount -t tmpfs tmpfs /psp
mkdir -p /psp/rfs1 /var/run /var/log
hostname chumby
ifconfig lo 127.0.0.1 up

# The hardware version, as the boot loader passes it (the machine's default
# command line has it); else 3.8, the last Classic's and the machine's.
hw=$(sed -n 's/.*chumby_hwversion=\([0-9.]*\).*/\1/p' /proc/cmdline)
hw=${hw:-3.8}
v38=
[ "$hw" = 3.8 ] && v38=version038=1
echo "rcS: Chumby drivers for hardware version $hw"

insmod /drivers/chumby-tsc2100.ko $v38 # touchscreen and audio codec
insmod /drivers/chumby_sense1.ko $v38  # button, backlight, mute, headphones
insmod /drivers/chumby_udma.ko         # user DMA
insmod /drivers/chumby_timer.ko        # aux timer
insmod /drivers/chumby_accel.ko        # accelerometer and DC ID EEPROM

# NAME DRIVER MINOR: a node for a driver with a dynamic major.
node() {
    major=$(sed -n "s/^ *\([0-9]*\) $2\$/\1/p" /proc/devices)
    [ -n "$major" ] || {
        echo "rcS: no $2 in /proc/devices"
        return
    }
    rm -f "/dev/$1"
    mknod -m 644 "/dev/$1" c "$major" "$3"
}
node timerx timerx 0
node timerm timerx 1
node accel accel 0
node switch switch 0
node dcid dcid 0
node udma udma 1
