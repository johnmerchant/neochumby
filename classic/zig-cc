#!/bin/sh
# classic/build's C compiler for BusyBox: zig cc for the Chumby Classic's
# ARM926EJ-S (ARMv5TE, soft float), static musl, as tools/zigcc builds
# neochumby's own binaries. ZIG is the zig to run. Drops the linker options
# BusyBox's link script (scripts/trylink) always asks for, only to write a
# map and a report beside the binary, which zig's linker doesn't take.
args=
for a in "$@"; do
  case "$a" in
    -Wl,--warn-common | -Wl,--verbose | -Wl,-Map,*) ;;
    *) args="$args '$(printf %s "$a" | sed "s/'/'\\\\''/g")'" ;;
  esac
done
eval exec "\"\${ZIG:?}\"" cc -target arm-linux-musleabi -mcpu=arm926ej_s "$args"
