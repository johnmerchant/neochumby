#!/bin/sh
# Builds the open-source Chumby Classic image: Chumby's own Linux 2.6.16
# (the classic/linux submodule, the GPL source of the stock firmware's
# kernel) configured as the stock kernel, with the Chumby's drivers, and an
# initramfs of BusyBox, the drivers and classic/rootfs built in. Written to
# OUT:
#
#   OUT/classic-zImage           the kernel, initramfs built in
#   OUT/classic-rootfs.cpio.gz   the same initramfs, for -initrd
#   OUT/classic-config           the kernel's .config
#
# Compiled with the compiler the stock kernel was built with, CodeSourcery's
# 2008q3 (gcc 4.3.2), from Chumby's own download server, pinned by its hash.
# Its programs are 32-bit x86 Linux binaries: they run natively on x86_64
# (CI) and under qemu-i386 elsewhere (an arm64 Mac), which needs a container
# allowed to register a binfmt handler.
#
# Runs in a container (classic/Containerfile) with Apple's container, docker
# or podman (NEOCHUMBY_CLASSIC_RUNTIME picks). The work (downloads, the
# toolchain, the build trees) stays in a volume, neochumby-classic, on the
# container's own disk: the kernel's tree has files whose names differ only
# by case, which macOS's disk can't hold, so the kernel is taken from the
# submodule's git objects, never from its checkout. A second run rebuilds
# only what changed; `$runtime volume rm neochumby-classic` starts over.
#
#   classic/build OUT
set -eu
TOOLCHAIN_URL=http://files.chumby.com/toolchain/arm-2008q3-72-arm-none-linux-gnueabi-i686-pc-linux-gnu.tar.bz2
TOOLCHAIN_SHA256=d09f1580a9179a3c8346bde44d6c7d828937d7afcab0ec41207f24e65aa71dca
BUSYBOX_VERSION=1.36.1
BUSYBOX_SHA256=b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314

if [ "${1:-}" = --inside ]; then
  root=$2
  out=$3
  here=$root/classic
  jobs=$(nproc)
  mkdir -p /work/dl

  fetch() { # URL SHA256 FILE
    [ -f "$3" ] && echo "$2  $3" | sha256sum -c - >/dev/null 2>&1 && return
    wget -nv -O "$3.part" "$1"
    echo "$2  $3.part" | sha256sum -c -
    mv "$3.part" "$3"
  }

  # DIR's .config: DIR/.config.base with FRAGMENT's options in place of its
  # own, through `MAKE oldconfig`. Every option of FRAGMENT has to be in
  # the result as written: Kconfig drops one whose dependencies aren't
  # met, silently.
  configure() { # DIR FRAGMENT MAKE
    want=$(cat "$1/.config.base" "$2" | sha256sum)
    [ "$(cat "$1/.config.neochumby" 2>/dev/null)" = "$want" ] && return
    names=$(grep -o -E '^(# )?CONFIG_[A-Za-z0-9_]+' "$2" | sed 's/^# //' | paste -sd'|')
    {
      grep -v -E "^(# )?($names)[= ]" "$1/.config.base"
      grep -E '^(# )?CONFIG_' "$2"
    } >"$1/.config"
    yes '' | "$3" oldconfig >/dev/null
    grep -E '^(# )?CONFIG_' "$2" | while IFS= read -r line; do
      grep -qxF "$line" "$1/.config" || {
        echo "classic/build: not in $1/.config: $line" >&2
        exit 1
      }
    done
    echo "$want" >"$1/.config.neochumby"
  }

  # The toolchain's programs are i686 binaries.
  case $(uname -m) in
  x86_64 | i?86) ;;
  *)
    export QEMU_LD_PREFIX=/usr/i686-linux-gnu
    [ -e /proc/sys/fs/binfmt_misc/register ] ||
      mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
    [ -e /proc/sys/fs/binfmt_misc/qemu-i386 ] ||
      printf '%s' ':qemu-i386:M::\x7fELF\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x03\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/usr/bin/qemu-i386-static:F' \
        >/proc/sys/fs/binfmt_misc/register
    ;;
  esac
  tc=/work/arm-2008q3
  if [ ! -x "$tc/bin/arm-none-linux-gnueabi-gcc" ]; then
    fetch "$TOOLCHAIN_URL" "$TOOLCHAIN_SHA256" /work/dl/arm-2008q3.tar.bz2
    tar xjf /work/dl/arm-2008q3.tar.bz2 -C /work
  fi
  export PATH="$tc/bin:$PATH"
  cross=arm-none-linux-gnueabi-
  "${cross}gcc" --version | head -n 1

  # The kernel: the commit this repository pins, from the submodule's
  # objects (whatever its checkout holds).
  git config --global --add safe.directory '*'
  rev=$(git -C "$root" ls-files -s classic/linux | awk '{print $2}')
  k=/work/linux
  stamp=$rev-$(cat "$here"/patches/linux/*.patch | sha256sum | cut -c1-16)
  if [ "$(cat "$k/.neochumby-source" 2>/dev/null)" != "$stamp" ]; then
    rm -rf "$k"
    mkdir -p "$k"
    git -C "$root/classic/linux" archive "$rev" | tar x -C "$k"
    for p in "$here"/patches/linux/*.patch; do
      patch -d "$k" -p1 --no-backup-if-mismatch <"$p"
    done
    echo "$stamp" >"$k/.neochumby-source"
  fi

  # BusyBox, static, with the same compiler and its glibc.
  bb=/work/busybox-$BUSYBOX_VERSION
  stamp=$BUSYBOX_SHA256-$(cat "$here"/patches/busybox/*.patch | sha256sum | cut -c1-16)
  if [ "$(cat "$bb/.neochumby-source" 2>/dev/null)" != "$stamp" ]; then
    fetch "https://busybox.net/downloads/busybox-$BUSYBOX_VERSION.tar.bz2" "$BUSYBOX_SHA256" \
      /work/dl/busybox-$BUSYBOX_VERSION.tar.bz2
    rm -rf "$bb"
    tar xjf /work/dl/busybox-$BUSYBOX_VERSION.tar.bz2 -C /work
    for p in "$here"/patches/busybox/*.patch; do
      patch -d "$bb" -p1 --no-backup-if-mismatch <"$p"
    done
    echo "$stamp" >"$bb/.neochumby-source"
  fi
  make_bb() { make -C "$bb" -j"$jobs" CROSS_COMPILE=$cross "$@"; }
  if [ ! -f "$bb/.config.base" ]; then
    make_bb defconfig >/dev/null
    cp "$bb/.config" "$bb/.config.base"
  fi
  configure "$bb" "$here/busybox.fragment" make_bb
  make_bb busybox

  # The initramfs's tree: BusyBox, our overlay, and (below) the Chumby's
  # modules. The device nodes are in classic/initramfs.list, in the
  # kernel's list format; linux.fragment points the kernel at both.
  r=/work/rootfs
  rm -rf "$r"
  make -C "$bb" CROSS_COMPILE=$cross CONFIG_PREFIX="$r" install >/dev/null
  "${cross}strip" "$r/bin/busybox"
  cp -R "$here/rootfs/." "$r/"
  mkdir -p "$r/drivers"
  cp "$here/initramfs.list" /work/initramfs.list

  # The kernel, configured as the stock one (the .config its source
  # carries) with linux.fragment's options in place of the stock ones.
  make_k() { make -C "$k" -j"$jobs" ARCH=arm CROSS_COMPILE=$cross "$@"; }
  [ -f "$k/.config.base" ] || cp "$k/.config" "$k/.config.base"
  configure "$k" "$here/linux.fragment" make_k
  make_k zImage modules

  # The Chumby's own drivers, which the stock firmware loads from /drivers.
  for m in drivers/mfd/chumby-tsc2100.ko drivers/char/chumby_sense1.ko drivers/char/chumby_accel.ko \
    drivers/char/chumby_timer.ko drivers/char/chumby_udma.ko; do
    "${cross}strip" --strip-debug -o "$r/drivers/${m##*/}" "$k/$m"
  done
  # Again, now that the tree is complete (the kernel rebuilds the archive
  # only when its list of files changes, not their contents).
  rm -f "$k/usr/initramfs_data.cpio" "$k/usr/initramfs_data.cpio.gz"
  make_k zImage

  mkdir -p "$out"
  cp "$k/arch/arm/boot/zImage" "$out/classic-zImage"
  cp "$k/usr/initramfs_data.cpio.gz" "$out/classic-rootfs.cpio.gz"
  cp "$k/.config" "$out/classic-config"
  ls -l "$out"
  exit 0
fi

out=${1:?usage: classic/build OUT}
root=$(git rev-parse --show-toplevel)
# The kernel's source, the submodule (`update = none` in .gitmodules, so a
# plain `git submodule update` leaves it out): fetched at the pinned commit
# only, if it isn't here yet.
rev=$(git -C "$root" ls-files -s classic/linux | awk '{print $2}')
git -C "$root/classic/linux" cat-file -e "$rev^{commit}" 2>/dev/null ||
  git -C "$root" submodule update --init --checkout --depth 1 classic/linux
mkdir -p "$out"
out=$(cd "$out" && pwd)
runtime=${NEOCHUMBY_CLASSIC_RUNTIME:-}
if [ -z "$runtime" ]; then
  for r in container docker podman; do
    command -v "$r" >/dev/null && {
      runtime=$r
      break
    }
  done
fi
[ -n "$runtime" ] || {
  echo "classic/build: needs Apple's container, docker or podman" >&2
  exit 2
}
# A nameserver for the downloads, if the runtime's own doesn't answer (seen
# with Apple's container): NEOCHUMBY_CLASSIC_DNS=<ip>.
dns=
[ -n "${NEOCHUMBY_CLASSIC_DNS:-}" ] && dns="--dns $NEOCHUMBY_CLASSIC_DNS"
# shellcheck disable=SC2086
"$runtime" build $dns -t neochumby-classic -f "$root/classic/Containerfile" "$root/classic"
# NEOCHUMBY_CLASSIC_WORK=DIR keeps the work in DIR instead of a named volume
# (CI caches DIR; it has to be on a case-sensitive disk).
work=${NEOCHUMBY_CLASSIC_WORK:-}
if [ -n "$work" ]; then
  mkdir -p "$work"
  work=$(cd "$work" && pwd)
  work_mount="-v $work:/work"
else
  "$runtime" volume inspect neochumby-classic >/dev/null 2>&1 ||
    "$runtime" volume create neochumby-classic >/dev/null
  work_mount="-v neochumby-classic:/work"
fi
opts=
# Apple's container gives a container 1 GB and 4 CPUs unless told.
[ "$runtime" = container ] && opts="-c 8 -m 8G"
# Off x86, the toolchain runs under qemu-i386, whose binfmt handler the
# container registers: that needs privileges.
case $(uname -m) in
x86_64 | i?86) ;;
*) if [ "$runtime" = container ]; then opts="$opts --cap-add ALL"; else opts="$opts --privileged"; fi ;;
esac
# shellcheck disable=SC2086
exec "$runtime" run --rm $opts $dns $work_mount -v "$root:$root" -v "$out:$out" \
  neochumby-classic sh "$root/classic/build" --inside "$root" "$out"
