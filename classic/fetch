#!/bin/sh
# fetch: puts the classic image CI built from this checkout's classic/ (and
# the kernel commit it pins) in OUT, as classic/build OUT would, from the
# `dist-prebuilt` release, verified: dist/fetch --classic, which documents it.
#
#   classic/fetch OUT    OUT/classic-zImage, OUT/classic-rootfs.cpio.gz, OUT/classic-config
#
# Exits 1 and leaves OUT as it was when there's no verified build for these
# inputs: then build it with classic/build OUT.
exec "$(dirname "$0")/../dist/fetch" --classic "$@"
