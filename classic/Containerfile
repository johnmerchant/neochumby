# classic/build's Linux: what the 2.6.16 kernel (gawk, for its initramfs
# list script) and BusyBox need of a host, and a way to run Chumby's
# toolchain, whose programs are 32-bit x86 (i686) Linux binaries: natively
# on x86_64 (CI) with the i386 libc, and anywhere else (an arm64 Mac) under
# qemu-i386 with the i386 libc as a sysroot (classic/build registers the
# binfmt handler).
FROM docker.io/library/ubuntu:24.04
RUN apt-get update -q \
 && DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends \
      build-essential bzip2 ca-certificates cpio gawk git gzip patch perl wget \
      xz-utils \
 && if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends libc6-i386; \
    else \
      DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends \
        qemu-user-static libc6-i386-cross; \
    fi \
 && rm -rf /var/lib/apt/lists/*
