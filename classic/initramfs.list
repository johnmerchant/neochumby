# The initramfs's device nodes, in the kernel's gen_init_cpio format: the
# numbers the stock 2.6.16 uses (2.6.16 has no devtmpfs). The Chumby's own
# drivers take dynamic majors; /init makes their nodes from /proc/devices.
dir /dev 0755 0 0
dir /dev/input 0755 0 0
dir /dev/snd 0755 0 0
dir /dev/pts 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/tty 0666 0 0 c 5 0
nod /dev/ptmx 0666 0 0 c 5 2
nod /dev/null 0666 0 0 c 1 3
nod /dev/zero 0666 0 0 c 1 5
nod /dev/mem 0640 0 0 c 1 1
nod /dev/kmsg 0600 0 0 c 1 11
nod /dev/random 0666 0 0 c 1 8
nod /dev/urandom 0666 0 0 c 1 9
nod /dev/tty0 0600 0 0 c 4 0
nod /dev/tty1 0600 0 0 c 4 1
nod /dev/ttyS0 0600 0 0 c 4 64
nod /dev/ttyS1 0600 0 0 c 4 65
nod /dev/ttyS2 0600 0 0 c 4 66
nod /dev/ttyS3 0600 0 0 c 4 67
nod /dev/fb0 0666 0 0 c 29 0
nod /dev/mixer 0666 0 0 c 14 0
nod /dev/dsp 0666 0 0 c 14 3
nod /dev/input/event0 0666 0 0 c 13 64
nod /dev/input/event1 0666 0 0 c 13 65
nod /dev/input/event2 0666 0 0 c 13 66
nod /dev/input/event3 0666 0 0 c 13 67
nod /dev/input/mice 0666 0 0 c 13 63
nod /dev/input/ts0 0666 0 0 c 13 128
nod /dev/ts 0666 0 0 c 13 128
nod /dev/snd/controlC0 0666 0 0 c 116 0
nod /dev/snd/pcmC0D0p 0666 0 0 c 116 16
nod /dev/snd/pcmC0D0c 0666 0 0 c 116 24
nod /dev/snd/seq 0666 0 0 c 116 1
nod /dev/snd/timer 0666 0 0 c 116 33
nod /dev/sda 0660 0 0 b 8 0
nod /dev/sda1 0660 0 0 b 8 1
nod /dev/sdb 0660 0 0 b 8 16
nod /dev/sdb1 0660 0 0 b 8 17
nod /dev/mtd0 0660 0 0 c 90 0
nod /dev/mtd1 0660 0 0 c 90 2
nod /dev/mtd2 0660 0 0 c 90 4
nod /dev/mtd3 0660 0 0 c 90 6
nod /dev/mtd4 0660 0 0 c 90 8
nod /dev/mtd5 0660 0 0 c 90 10
nod /dev/mtd6 0660 0 0 c 90 12
nod /dev/mtd7 0660 0 0 c 90 14
nod /dev/mtdblock0 0660 0 0 b 31 0
nod /dev/mtdblock1 0660 0 0 b 31 1
nod /dev/mtdblock2 0660 0 0 b 31 2
nod /dev/mtdblock3 0660 0 0 b 31 3
nod /dev/mtdblock4 0660 0 0 b 31 4
nod /dev/mtdblock5 0660 0 0 b 31 5
nod /dev/mtdblock6 0660 0 0 b 31 6
nod /dev/mtdblock7 0660 0 0 b 31 7
slink /dev/fb /dev/fb0 0777 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 1777 0 0
dir /psp 0755 0 0
dir /mnt 0755 0 0
dir /mnt/usb 0755 0 0
dir /mnt/neochumby 0755 0 0
dir /var 0755 0 0
dir /root 0700 0 0
