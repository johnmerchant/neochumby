/target
# Game data is never committed: Doom and Quake WADs/PAKs are fetched onto
# the server by hand (see README).
*.wad
*.WAD
*.pak
*.PAK
# Captures and profiles from the device.
*.raw
*.prof

# Your own settings, such as where your firmware images are (dev/emulate).
/.env.local

# Agents' worktrees
/.claude/
