# The Chumby Classic: Freescale i.MX21, an ARM926EJ-S with no FPU.
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

# Static musl, like the apps. (On an x86_64 host dist/build swaps in
# Bootlin's prebuilt toolchain instead: board/chumby-classic/bootlin.config.)
# The headers stay at 5.9.16, older than the kernel, which the kernel's ABI
# allows: the apps keep the baseline they were built for, and the toolchain
# doesn't follow every kernel update.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_GCC_VERSION_13_X=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="5.9.16"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_9=y
BR2_STATIC_LIBS=y

# Compiles go through ccache, so a build whose output was thrown away (a
# config change, a cold CI cache) still reuses what it compiled before.
# dist/build puts the cache in its work, beside the downloads.
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=1G"

# Every download checked against a hash; the kernel's are ours (patches/).
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_NEOCHUMBY_PATH)/patches"

# The kernel: 7.2.13, with the i.MX21 brought back as a device-tree
# platform (patches/linux/7.2.13). Our options go on top of
# imx_v4_v5_defconfig. The boot loader passes ATAGs and no device tree, so
# the zImage carries the Chumby's DTB appended.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.13"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="imx_v4_v5"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NEOCHUMBY_PATH)/board/chumby-classic/linux7.fragment"
BR2_LINUX_KERNEL_APPENDED_ZIMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="nxp/imx/imx21-chumby-classic"
# scripts/extract-cert links OpenSSL: Buildroot's, not the host's.
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# No init of Buildroot's: neochumby-init will be ours. devtmpfs makes /dev.
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# Wi-Fi: the Chumby's adapter is an rt73 (rt73usb, with its firmware).
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73=y

# sideload: the initramfs is built into the kernel as well as shipped
# beside it.  A flashed zImage therefore still boots, and /init can load the
# NAND recovery modules when the sideload marker is absent.
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NEOCHUMBY_PATH)/board/chumby-classic/rootfs"

# modprobe for the NAND recovery modules (the normal path never loads them).
BR2_PACKAGE_KMOD=y

# The initramfs userhook2 kexecs with, beside the zImage.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
