# The Chumby Classic: Freescale i.MX21, an ARM926EJ-S with no FPU.
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

# Static musl, like the apps. (On an x86_64 host dist/build swaps in
# Bootlin's prebuilt toolchain instead: board/chumby-classic/bootlin.config.)
# The headers stay at 5.9.16, older than the kernel, which the kernel's ABI
# allows: the apps keep the baseline they were built for, and the toolchain
# doesn't follow every kernel update.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# C++ too: Buildroot's Rust needs it for a musl target (ncinit).
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_13_X=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="5.9.16"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_9=y
BR2_STATIC_LIBS=y

# Compiles go through ccache, so a build whose output was thrown away (a
# config change, a cold CI cache) still reuses what it compiled before.
# dist/build puts the cache in its work, beside the downloads.
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=1G"

# Every download checked against a hash; the kernel's are ours. patches/
# has the headers' hash (5.9.16, shared with the other kernels) and
# kernel/mainline/ this track's own: linux/ (its patches and the archive's
# hash, with no version in the path, so a bump renames nothing) and
# linux.fragment.
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_NEOCHUMBY_PATH)/patches $(BR2_EXTERNAL_NEOCHUMBY_PATH)/kernel/mainline"

# The kernel: the mainline track, kernel.org's mainline (Linus's newest
# tag: a release such as v7.3, or an -rc such as v7.4-rc3), with the
# i.MX21 brought back as a device-tree platform (kernel/mainline/linux).
# Our options go on top of imx_v4_v5_defconfig. The boot loader passes
# ATAGs and no device tree, so the zImage carries the Chumby's DTB
# appended.
#
# An -rc has no kernel.org tarball with a published checksum, so every
# mainline tag, release or -rc, comes the same way: Buildroot's git
# download of the tag, which Buildroot archives reproducibly
# (linux-TAG-git4.tar.gz: the same bytes from the same tree). dist/build
# makes that same archive, with Buildroot's own helper, from a shallow
# fetch of the tag rather than Buildroot's clone of the whole history, and
# checks the tag's commit and the archive's SHA-256 against the pin before
# Buildroot sees it (Buildroot checks the hash again).
#
# The pin: this tag, and in kernel/mainline/linux/linux.hash its commit and
# the archive's SHA-256. CI's kernel-sync job moves all three when
# kernel.org's mainline does, after checking the tag's signature
# (dist/kernel-sync); dist/build refuses a hash file that names another
# tag.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v7.3"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="imx_v4_v5"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NEOCHUMBY_PATH)/kernel/mainline/linux.fragment"
BR2_LINUX_KERNEL_APPENDED_ZIMAGE=y
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="nxp/imx/imx21-chumby-classic"
# scripts/extract-cert links OpenSSL: Buildroot's, not the host's.
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# No init of Buildroot's: neochumby-init will be ours. devtmpfs makes /dev.
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# Wi-Fi: the Chumby's adapter is an rt73 (rt73usb, with its firmware).
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73=y

# /init: ncinit (crates/neochumby-init), which loads the NAND recovery
# modules (only when flashed) and every other module as its device appears.
BR2_PACKAGE_NEOCHUMBY_INIT=y

# The initramfs the boot hook hands over, beside the zImage.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
