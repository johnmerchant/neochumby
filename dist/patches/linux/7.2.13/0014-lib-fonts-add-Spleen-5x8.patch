From: John Merchant <john@johnmerchant.dev>
Subject: [PATCH] lib/fonts: add Spleen 5x8

Spleen 5x8 2.1.0 (BSD-2-Clause, Frederic Cambus), converted from its BDF
to code page 437's order, the console's default map. Positions Spleen has
no glyph for (double-line box drawing, shades, most of the Greek) are
blank. On the Chumby's 320x240 screen it gives the console 64x30
characters, against 40x30 with the VGA 8x8.

Source: https://github.com/fcambus/spleen/tree/2.1.0 (spleen-5x8.bdf)

---
--- a/include/linux/font.h
+++ b/include/linux/font.h
@@ -154,6 +154,7 @@
 extern const struct font_desc font_acorn_8x8;
 extern const struct font_desc font_mini_4x6;
 extern const struct font_desc font_pearl_8x8;
+extern const struct font_desc font_spleen_5x8;
 extern const struct font_desc font_sun_12x22;
 extern const struct font_desc font_sun_8x16;
 extern const struct font_desc font_ter_10x18;
--- a/lib/fonts/Kconfig
+++ b/lib/fonts/Kconfig
@@ -139,6 +139,13 @@
 	help
 	  This font is useful for small displays (OLED).
 
+config FONT_SPLEEN_5x8
+	bool "Spleen 5x8 font"
+	depends on !SPARC && FONTS
+	help
+	  Frederic Cambus's Spleen, 5x8: a small, clear console font for a
+	  320x240 screen, which gets 64x30 characters.
+
 config FONT_AUTOSELECT
 	def_bool y
 	depends on !FONT_8x8
@@ -154,6 +161,7 @@
 	depends on !FONT_TER10x18
 	depends on !FONT_TER16x32
 	depends on !FONT_6x8
+	depends on !FONT_SPLEEN_5x8
 	select FONT_8x16
 
 endif # FONT_SUPPORT
--- a/lib/fonts/Makefile
+++ b/lib/fonts/Makefile
@@ -17,6 +17,7 @@
 font-$(CONFIG_FONT_PEARL_8x8) += font_pearl_8x8.o
 font-$(CONFIG_FONT_SUN8x16)   += font_sun8x16.o
 font-$(CONFIG_FONT_SUN12x22)  += font_sun12x22.o
+font-$(CONFIG_FONT_SPLEEN_5x8) += font_spleen_5x8.o
 font-$(CONFIG_FONT_TER10x18)  += font_ter10x18.o
 font-$(CONFIG_FONT_TER16x32)  += font_ter16x32.o
 
--- a/lib/fonts/font.h
+++ b/lib/fonts/font.h
@@ -34,5 +34,6 @@
 #define TER16x32_IDX	11
 #define FONT6x8_IDX	12
 #define TER10x18_IDX	13
+#define SPLEEN5x8_IDX	14
 
 #endif
--- /dev/null
+++ b/lib/fonts/font_spleen_5x8.c
@@ -0,0 +1,2582 @@
