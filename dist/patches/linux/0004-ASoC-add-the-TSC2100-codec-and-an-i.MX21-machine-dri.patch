diff --git a/sound/soc/fsl/imx-tsc2100.c b/sound/soc/fsl/imx-tsc2100.c
new file mode 100644
index 000000000..aa9046cff
--- /dev/null
+++ b/sound/soc/fsl/imx-tsc2100.c
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ASoC machine driver for i.MX21 boards with a TI TSC2100 codec on the
+ * SSI (Chumby Classic)
+ *
+ * Wiring, from the stock Chumby 2.6.16 driver (drivers/mfd/chumby-tsc2100.c):
+ *  - SSI1 (imx-ssi.0), synchronous, I2S slave: the TSC2100 is the bit and
+ *    frame clock master.  16-bit words in four slots per frame, slots 0
+ *    and 2 carrying left and right.
+ *  - AUDMUX: SSI1 (host port 1) takes its transmit clock and frame sync
+ *    from the SSI2 pins (peripheral port 2) and its receive clock, frame
+ *    sync and data from the SSI1 pins (peripheral port 1); both
+ *    peripheral ports take their data from SSI1.
+ *  - The codec's MCLK is the board's 16 MHz oscillator.
+ *  - The speaker amplifier is switched by a GPIO (KPP column 4 on the
+ *    Chumby): the "speaker" GPIO, logically high when the speaker is on.
+ */
+
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <sound/soc.h>
+
+#include "imx-audmux.h"
+#include "imx-ssi.h"
+
+static unsigned int mclk = 16000000;
+module_param(mclk, uint, 0444);
+MODULE_PARM_DESC(mclk, "TSC2100 MCLK rate in Hz (default 16000000)");
+
+struct imx_tsc2100 {
+	struct snd_soc_card card;
+	struct gpio_desc *spk_gpio;
+};
+
+static int imx_tsc2100_spk_event(struct snd_soc_dapm_widget *w,
+				 struct snd_kcontrol *k, int event)
+{
+	struct imx_tsc2100 *priv = snd_soc_card_get_drvdata(w->dapm->card);
+
+	gpiod_set_value_cansleep(priv->spk_gpio, SND_SOC_DAPM_EVENT_ON(event));
+
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget imx_tsc2100_dapm_widgets[] = {
+	SND_SOC_DAPM_SPK("Speaker", imx_tsc2100_spk_event),
+	SND_SOC_DAPM_HP("Headphone", NULL),
+};
+
+static const struct snd_soc_dapm_route imx_tsc2100_dapm_routes[] = {
+	{ "Speaker", NULL, "HPL" },
+	{ "Speaker", NULL, "HPR" },
+	{ "Headphone", NULL, "HPL" },
+	{ "Headphone", NULL, "HPR" },
+};
+
+static const struct snd_kcontrol_new imx_tsc2100_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Speaker"),
+	SOC_DAPM_PIN_SWITCH("Headphone"),
+};
+
+static int imx_tsc2100_startup(struct snd_pcm_substream *substream)
+{
+	/* the four 16-bit slot frame only carries 16-bit samples */
+	return snd_pcm_hw_constraint_mask64(substream->runtime,
+					    SNDRV_PCM_HW_PARAM_FORMAT,
+					    SNDRV_PCM_FMTBIT_S16_LE);
+}
+
+static const struct snd_soc_ops imx_tsc2100_ops = {
+	.startup = imx_tsc2100_startup,
+};
+
+static int imx_tsc2100_dai_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dai *codec_dai = asoc_rtd_to_codec(rtd, 0);
+	struct snd_soc_dai *cpu_dai = asoc_rtd_to_cpu(rtd, 0);
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(codec_dai, 0, mclk, SND_SOC_CLOCK_IN);
+	if (ret) {
+		dev_err(rtd->dev, "codec MCLK %u Hz rejected: %d\n", mclk, ret);
+		return ret;
+	}
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, IMX_SSP_SYS_CLK, 0,
+				     SND_SOC_CLOCK_IN);
+	if (ret)
+		return ret;
+
+	/* as the stock driver: DC = 3, STMSK/SRMSK = ~(slot 0 | slot 2) */
+	return snd_soc_dai_set_tdm_slot(cpu_dai, 0x5, 0x5, 4, 16);
+}
+
+SND_SOC_DAILINK_DEFS(hifi,
+	DAILINK_COMP_ARRAY(COMP_CPU("imx-ssi.0")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("tsc2100-codec", "tsc2100-hifi")),
+	DAILINK_COMP_ARRAY(COMP_PLATFORM("imx-ssi.0")));
+
+static struct snd_soc_dai_link imx_tsc2100_dai = {
+	.name		= "TSC2100",
+	.stream_name	= "TSC2100",
+	.init		= imx_tsc2100_dai_init,
+	.ops		= &imx_tsc2100_ops,
+	.dai_fmt	= SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			  SND_SOC_DAIFMT_CBM_CFM,
+	SND_SOC_DAILINK_REG(hifi),
+};
+
+/* The i.MX21 AUDMUX has the i.MX27's layout, so the MX27_ port names apply */
+static int imx_tsc2100_audmux(void)
+{
+	int ret;
+
+	/* SSI1: Tx clocks from the SSI2 pins, Rx clocks and data from SSI1's */
+	ret = imx_audmux_v1_configure_port(MX27_AUDMUX_HPCR1_SSI0,
+			IMX_AUDMUX_V1_PCR_TFSDIR |
+			IMX_AUDMUX_V1_PCR_TCLKDIR |
+			IMX_AUDMUX_V1_PCR_RFSDIR |
+			IMX_AUDMUX_V1_PCR_RCLKDIR |
+			IMX_AUDMUX_V1_PCR_TFCSEL(MX27_AUDMUX_PPCR2_SSI_PINS_2) |
+			IMX_AUDMUX_V1_PCR_RFCSEL(MX27_AUDMUX_PPCR1_SSI_PINS_1) |
+			IMX_AUDMUX_V1_PCR_RXDSEL(MX27_AUDMUX_PPCR1_SSI_PINS_1));
+	if (ret)
+		return ret;
+
+	/* Both pin groups: clocks are inputs, data out from SSI1 */
+	ret = imx_audmux_v1_configure_port(MX27_AUDMUX_PPCR1_SSI_PINS_1,
+			IMX_AUDMUX_V1_PCR_SYN |
+			IMX_AUDMUX_V1_PCR_TFCSEL(MX27_AUDMUX_HPCR1_SSI0) |
+			IMX_AUDMUX_V1_PCR_RFCSEL(MX27_AUDMUX_HPCR1_SSI0) |
+			IMX_AUDMUX_V1_PCR_RXDSEL(MX27_AUDMUX_HPCR1_SSI0));
+	if (ret)
+		return ret;
+
+	return imx_audmux_v1_configure_port(MX27_AUDMUX_PPCR2_SSI_PINS_2,
+			IMX_AUDMUX_V1_PCR_SYN |
+			IMX_AUDMUX_V1_PCR_TFCSEL(MX27_AUDMUX_HPCR1_SSI0) |
+			IMX_AUDMUX_V1_PCR_RFCSEL(MX27_AUDMUX_HPCR1_SSI0) |
+			IMX_AUDMUX_V1_PCR_RXDSEL(MX27_AUDMUX_HPCR1_SSI0));
+}
+
+static int imx_tsc2100_probe(struct platform_device *pdev)
+{
+	struct imx_tsc2100 *priv;
+	int ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	/* speaker off until DAPM turns it on */
+	priv->spk_gpio = devm_gpiod_get_optional(&pdev->dev, "speaker",
+						 GPIOD_OUT_LOW);
+	if (IS_ERR(priv->spk_gpio))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->spk_gpio),
+				     "failed to get speaker GPIO\n");
+
+	ret = imx_tsc2100_audmux();
+	if (ret == -ENOSYS)	/* imx-audmux not probed yet */
+		return -EPROBE_DEFER;
+	if (ret) {
+		dev_err(&pdev->dev, "AUDMUX setup failed: %d\n", ret);
+		return ret;
+	}
+
+	priv->card.name = "TSC2100";
+	priv->card.owner = THIS_MODULE;
+	priv->card.dev = &pdev->dev;
+	priv->card.dai_link = &imx_tsc2100_dai;
+	priv->card.num_links = 1;
+	priv->card.controls = imx_tsc2100_controls;
+	priv->card.num_controls = ARRAY_SIZE(imx_tsc2100_controls);
+	priv->card.dapm_widgets = imx_tsc2100_dapm_widgets;
+	priv->card.num_dapm_widgets = ARRAY_SIZE(imx_tsc2100_dapm_widgets);
+	priv->card.dapm_routes = imx_tsc2100_dapm_routes;
+	priv->card.num_dapm_routes = ARRAY_SIZE(imx_tsc2100_dapm_routes);
+	snd_soc_card_set_drvdata(&priv->card, priv);
+
+	return devm_snd_soc_register_card(&pdev->dev, &priv->card);
+}
+
+static struct platform_driver imx_tsc2100_driver = {
+	.driver = {
+		.name = "imx-tsc2100",
+	},
+	.probe = imx_tsc2100_probe,
+};
+module_platform_driver(imx_tsc2100_driver);
+
+MODULE_DESCRIPTION("i.MX21 TSC2100 ASoC machine driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:imx-tsc2100");
