index 000000000..22426ae5e
--- /dev/null
+++ b/arch/arm/mach-imx/mach-chumby-classic.c
@@ -0,0 +1,529 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Chumby Classic (hardware 3.8): a Freescale i.MX21 with 64 MiB of SDRAM,
+ * 64 MiB of NAND flash, a 320x240 TFT, a TI TSC2100 touchscreen
+ * controller and audio codec on CSPI3, and a top button.
+ *
+ * The values here come from Chumby's 2.6.16 board file (mx21ads.c), its
+ * imxfb and its chumby-tsc2100 driver. Its boot loader enters the kernel
+ * with the MX21ADS machine number, so this board takes that number and
+ * cannot be built with MACH_MX21ADS.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/machine.h>
+#include <linux/gpio_keys.h>
+#include <linux/input.h>
+#include <linux/platform_device.h>
+#include <linux/platform_data/asoc-imx-ssi.h>
+#include <linux/platform_data/usb-mx2.h>
+#include <linux/pwm.h>
+#include <linux/pwm_backlight.h>
+#include <linux/regulator/fixed.h>
+#include <linux/regulator/machine.h>
+#include <linux/spi/spi.h>
+#include <asm/mach-types.h>
+#include <asm/mach/arch.h>
+
+#include "common.h"
+#include "devices-imx21.h"
+#include "hardware.h"
+#include "iomux-mx21.h"
+
+/* The TSC2100's PINTDAV: low while the pen is down */
+#define CHUMBY_PEN_GPIO		IMX_GPIO_NR(5, 19)
+
+/*
+ * The keypad port is not a keypad here: Chumby uses its rows and columns
+ * as GPIO, as a basic-mmio-gpio chip with the rows at 0-7 and the
+ * columns at 8-15.
+ */
+#define CHUMBY_KPP_GPIO_BASE	(6 * 32)
+#define CHUMBY_KPP_ROW(n)	(n)
+#define CHUMBY_KPP_COL(n)	(8 + (n))
+
+#define CHUMBY_KPP_BUTTON	CHUMBY_KPP_ROW(0)	/* low while pressed */
+#define CHUMBY_KPP_WIFI_ON	CHUMBY_KPP_COL(0)
+#define CHUMBY_KPP_LCD_PWRON	CHUMBY_KPP_COL(2)
+#define CHUMBY_KPP_SPK_OFF	CHUMBY_KPP_COL(4)	/* high mutes the speaker */
+
+#define MX21_PWMC		0x00
+#define MX21_PWMP		0x08
+#define MX21_PWMC_SWR		BIT(16)
+
+#define MX21_KPP_KPCR		0x0
+#define MX21_KPP_KDDR		0x4
+#define MX21_KPP_KPDR		0x6
+
+static const int chumby_pins[] __initconst = {
+	/* UART1: the console */
+	PE12_PF_UART1_TXD,
+	PE13_PF_UART1_RXD,
+	PE14_PF_UART1_CTS,
+	PE15_PF_UART1_RTS,
+
+	/* UART3: the crypto processor */
+	PE8_PF_UART3_TXD,
+	PE9_PF_UART3_RXD,
+
+	/* LCDC */
+	PA5_PF_LSCLK,
+	PA6_PF_LD0,
+	PA7_PF_LD1,
+	PA8_PF_LD2,
+	PA9_PF_LD3,
+	PA10_PF_LD4,
+	PA11_PF_LD5,
+	PA12_PF_LD6,
+	PA13_PF_LD7,
+	PA14_PF_LD8,
+	PA15_PF_LD9,
+	PA16_PF_LD10,
+	PA17_PF_LD11,
+	PA18_PF_LD12,
+	PA19_PF_LD13,
+	PA20_PF_LD14,
+	PA21_PF_LD15,
+	PA22_PF_LD16,
+	PA28_PF_HSYNC,
+	PA29_PF_VSYNC,
+	PA31_PF_OE_ACD,
+
+	/* CSPI3: the TSC2100 */
+	PE18_AF_CSPI3_MISO,
+	PE21_AF_CSPI3_SS,
+	PE22_AF_CSPI3_MOSI,
+	PE23_AF_CSPI3_SCLK,
+	(GPIO_PORTE | GPIO_GPIO | GPIO_IN | GPIO_PUEN | 19),	/* PINTDAV */
+
+	/* CSPI1: the sensor card; SS0 and SS1 are GPIOs it decodes */
+	PD29_PF_CSPI1_SCLK,
+	PD30_PF_CSPI1_MISO,
+	PD31_PF_CSPI1_MOSI,
+	(GPIO_PORTD | GPIO_GPIO | GPIO_OUT | 27),	/* SS1 */
+	(GPIO_PORTD | GPIO_GPIO | GPIO_OUT | 28),	/* SS0 */
+
+	/* The backlight's PWM */
+	PE5_PF_PWMO | GPIO_OUT,
+
+	/*
+	 * SSI1 and SSI2's pins: the AUDMUX gives SSI1 the codec's bit clock
+	 * and frame sync from the SSI2 pins, the rest from its own.
+	 */
+	PC20_PF_SSI1_FS | GPIO_PUEN,
+	PC21_PF_SSI1_RXD | GPIO_PUEN,
+	PC22_PF_SSI1_TXD | GPIO_PUEN,
+	PC23_PF_SSI1_CLK | GPIO_PUEN,
+	PC24_PF_SSI2_FS | GPIO_PUEN,
+	PC25_PF_SSI2_RXD | GPIO_PUEN,
+	PC26_PF_SSI2_TXD | GPIO_PUEN,
+	PC27_PF_SSI2_CLK | GPIO_PUEN,
+
+	/* NFC */
+	PF0_PF_NRFB,
+	PF1_PF_NFCE,
+	PF2_PF_NFWP,
+	PF3_PF_NFCLE,
+	PF4_PF_NFALE,
+	PF5_PF_NFRE,
+	PF6_PF_NFWE,
+	PF7_PF_NFIO0,
+	PF8_PF_NFIO1,
+	PF9_PF_NFIO2,
+	PF10_PF_NFIO3,
+	PF11_PF_NFIO4,
+	PF12_PF_NFIO5,
+	PF13_PF_NFIO6,
+	PF14_PF_NFIO7,
+
+	/* USB host 1: the internal hub */
+	PB23_PF_USB_PWR,
+	PB25_PF_USBH1_ON | GPIO_PUEN,
+	PB26_PF_USBH1_FS,
+	PB27_PF_USBH1_OE | GPIO_PUEN,
+	PB28_PF_USBH1_TXDM | GPIO_PUEN,
+	PB29_PF_USBH1_TXDP | GPIO_PUEN,
+	PB30_PF_USBH1_RXDM | GPIO_PUEN,
+	PB31_PF_USBH1_RXDP | GPIO_PUEN,
+
+	/* USB host 2 */
+	PD19_AOUT_USBH2_RXDM | GPIO_PUEN,
+	PD20_AOUT_USBH2_RXDP | GPIO_PUEN,
+	PD21_AIN_USBH2_FS | GPIO_PUEN,
+	PD22_AIN_USBH2_OE | GPIO_PUEN,
+	PD23_AIN_USBH2_TXDM | GPIO_PUEN,
+	PD24_AIN_USBH2_TXDP | GPIO_PUEN,
+
+	/* The OTG port, used as a host */
+	PC8_PF_USBOTG_FS | GPIO_PUEN,
+	PC9_PF_USBOTG_OE | GPIO_PUEN,
+	PC10_PF_USBOTG_TXDM | GPIO_PUEN,
+	PC11_PF_USBOTG_TXDP | GPIO_PUEN,
+	PC12_PF_USBOTG_RXDM | GPIO_PUEN,
+	PC13_PF_USBOTG_RXDP | GPIO_PUEN,
+};
+
+static const struct imxuart_platform_data uart_pdata_rts __initconst = {
+	.flags = IMXUART_HAVE_RTSCTS,
+};
+
+static const struct imxuart_platform_data uart_pdata_norts __initconst = {
+};
+
+static const struct mxc_nand_platform_data chumby_nand_pdata __initconst = {
+	.width = 1,
+	.hw_ecc = 1,
+};
+
+/*
+ * The panel, as the stock imxfb programs it for hardware 3.8: PCR
+ * 0xcad80084, HCR 0x0800133e and VCR 0x10001204. This driver writes
+ * HCR as (hsync_len - 1, right_margin - 1, left_margin - 3) and VCR as
+ * (vsync_len, lower_margin, upper_margin), hence the values below. The
+ * pixel clock is the stock one, LSCLK 33.25 MHz / 5.
+ */
+static struct imx_fb_videomode chumby_fb_modes[] = {
+	{
+		.mode = {
+			.name		= "Chumby-QVGA",
+			.refresh	= 60,
+			.xres		= 320,
+			.yres		= 240,
+			.pixclock	= 150376,	/* 6.65 MHz */
+			.hsync_len	= 3,
+			.right_margin	= 20,
+			.left_margin	= 65,
+			.vsync_len	= 4,
+			.lower_margin	= 18,
+			.upper_margin	= 4,
+		},
+		.pcr	= PCR_TFT | PCR_COLOR | PCR_FLMPOL | PCR_LPPOL |
+			  PCR_OEPOL | PCR_SCLKIDLE | PCR_SCLK_SEL,
+		.bpp	= 16,
+	},
+};
+
+static const struct imx_fb_platform_data chumby_fb_pdata __initconst = {
+	.mode		= chumby_fb_modes,
+	.num_modes	= ARRAY_SIZE(chumby_fb_modes),
+	.pwmr		= 0x00a903c0,
+	.lscr1		= 0x00000000,
+	.dmacr		= 0x00020008,
+};
+
+static const struct mx21_usbh_platform_data chumby_usbh_pdata __initconst = {
+	.host_xcvr	= MX21_USBXCVR_TXDIF_RXDIF,
+	.otg_xcvr	= MX21_USBXCVR_TXDIF_RXDIF,
+	.enable_host1	= 1,
+	.enable_host2	= 1,
+	.enable_otg_host = 1,
+};
+
+/*
+ * CSPI1 has the sensor card. Its two select lines, which idle high, are
+ * decoded on the card: SS0 low selects the accelerometer, SS1 low the
+ * ID EEPROM. The SPI core never asserts both.
+ */
+static struct gpiod_lookup_table chumby_cspi1_gpiod_table = {
+	/* The SPI core looks them up for the controller, bus 0 */
+	.dev_id = "spi0",
+	.table = {
+		GPIO_LOOKUP_IDX("imx21-gpio.3", 28, "cs", 0, GPIO_ACTIVE_LOW),
+		GPIO_LOOKUP_IDX("imx21-gpio.3", 27, "cs", 1, GPIO_ACTIVE_LOW),
+		{ },
+	},
+};
+
+static struct spi_board_info chumby_spi_board_info[] __initdata = {
+	/* The accelerometer, on CSPI1 */
+	{
+		.modalias	= "kxp74",
+		.max_speed_hz	= 1000000,
+		.bus_num	= 0,
+		.chip_select	= 0,
+		.mode		= SPI_MODE_3,
+	},
+	/* SPI3: the TSC2100, mode 1, 16-bit words, chip select active low */
+	{
+		.modalias	= "tsc2100",
+		.max_speed_hz	= 8000000,
+		.bus_num	= 2,
+		.chip_select	= 0,
+		.mode		= SPI_MODE_1,
+		/* .irq set at run time */
+	},
+};
+
+/*
+ * The backlight: the PWM on PE5, brightness proportional to PWMS. The
+ * pwm-imx1 driver only rewrites PWMS, as PWMP - PWMP * duty / period, so
+ * the board sets the rest up as the stock kernel does, and the levels
+ * run backwards to make brightness b PWMS = PWMP * b / 100. The period
+ * is nominal: the driver only uses duty / period.
+ */
+static struct resource chumby_pwm_resources[] = {
+	DEFINE_RES_MEM(MX21_PWM_BASE_ADDR, SZ_16),
+	DEFINE_RES_IRQ(MX21_INT_PWM),
+};
+
+static struct platform_device chumby_pwm = {
+	.name		= "pwm-imx1",
+	.id		= 0,
+	.resource	= chumby_pwm_resources,
+	.num_resources	= ARRAY_SIZE(chumby_pwm_resources),
+};
+
+static struct pwm_lookup chumby_pwm_lookup[] = {
+	PWM_LOOKUP("pwm-imx1.0", 0, "pwm-backlight", NULL, 65536,
+		   PWM_POLARITY_NORMAL),
+};
+
+static unsigned int chumby_bl_levels[101];
+
+static struct platform_pwm_backlight_data chumby_bl_pdata = {
+	.max_brightness	= 100,
+	.dft_brightness	= 100,
+	.levels		= chumby_bl_levels,
+	.pwm_period_ns	= 65536,
+};
+
+static struct platform_device chumby_backlight = {
+	.name	= "pwm-backlight",
+	.id	= PLATFORM_DEVID_NONE,
+	.dev	= {
+		.platform_data = &chumby_bl_pdata,
+	},
+};
+
+/* Sound: the TSC2100's codec, the I2S master, on SSI1 */
+static const struct imx_ssi_platform_data chumby_ssi_pdata __initconst = {
+	.flags = IMX_SSI_DMA | IMX_SSI_SYN | IMX_SSI_NET |
+		 IMX_SSI_USE_I2S_SLAVE,
+};
+
+static struct platform_device chumby_sound = {
+	.name	= "imx-tsc2100",
+	.id	= PLATFORM_DEVID_NONE,
+};
+
+static struct gpiod_lookup_table chumby_sound_gpiod_table = {
+	.dev_id = "imx-tsc2100",
+	.table = {
+		GPIO_LOOKUP("chumby-kpp", CHUMBY_KPP_SPK_OFF, "speaker",
+			    GPIO_ACTIVE_LOW),
+		{ },
+	},
+};
+
+/* The keypad port as GPIO */
+static struct resource chumby_kpp_gpio_resources[] = {
+	DEFINE_RES_MEM_NAMED(MX21_KPP_BASE_ADDR + MX21_KPP_KPDR, 2, "dat"),
+	DEFINE_RES_MEM_NAMED(MX21_KPP_BASE_ADDR + MX21_KPP_KDDR, 2, "dirout"),
+};
+
+static struct bgpio_pdata chumby_kpp_gpio_pdata = {
+	.label	= "chumby-kpp",
+	.base	= CHUMBY_KPP_GPIO_BASE,
+	.ngpio	= 16,
+};
+
+static struct platform_device chumby_kpp_gpio = {
+	.name		= "basic-mmio-gpio",
+	.id		= PLATFORM_DEVID_AUTO,
+	.resource	= chumby_kpp_gpio_resources,
+	.num_resources	= ARRAY_SIZE(chumby_kpp_gpio_resources),
+	.dev = {
+		.platform_data = &chumby_kpp_gpio_pdata,
+	},
+};
+
+/* The top button. The keypad port can't interrupt for it, so poll. */
+static struct gpio_keys_button chumby_buttons[] = {
+	{
+		.code		= KEY_ENTER,
+		.gpio		= CHUMBY_KPP_GPIO_BASE + CHUMBY_KPP_BUTTON,
+		.active_low	= 1,
+		.desc		= "top",
+		.type		= EV_KEY,
+		.debounce_interval = 20,
+	},
+};
+
+static struct gpio_keys_platform_data chumby_button_pdata = {
+	.buttons	= chumby_buttons,
+	.nbuttons	= ARRAY_SIZE(chumby_buttons),
+	.poll_interval	= 20,
+	.name		= "chumby-button",
+};
+
+static struct platform_device chumby_button = {
+	.name	= "gpio-keys-polled",
+	.id	= PLATFORM_DEVID_NONE,
+	.dev	= {
+		.platform_data = &chumby_button_pdata,
+	},
+};
+
+/* The LCD's supply, switched by LCD_PWRON (keypad column 2) */
+static struct regulator_consumer_supply chumby_lcd_consumer =
+	REGULATOR_SUPPLY("lcd", "imx21-fb.0");
+
+static struct regulator_init_data chumby_lcd_init_data = {
+	.constraints = {
+		.valid_ops_mask	= REGULATOR_CHANGE_STATUS,
+	},
+	.consumer_supplies	= &chumby_lcd_consumer,
+	.num_consumer_supplies	= 1,
+};
+
+static struct fixed_voltage_config chumby_lcd_regulator_pdata = {
+	.supply_name	= "LCD",
+	.microvolts	= 3300000,
+	.init_data	= &chumby_lcd_init_data,
+	/* The boot loader leaves the panel on. */
+	.enabled_at_boot = 1,
+};
+
+static struct platform_device chumby_lcd_regulator = {
+	.name	= "reg-fixed-voltage",
+	.id	= 0,
+	.dev	= {
+		.platform_data = &chumby_lcd_regulator_pdata,
+	},
+};
+
+static struct gpiod_lookup_table chumby_lcd_regulator_gpiod_table = {
+	.dev_id = "reg-fixed-voltage.0",
+	.table = {
+		GPIO_LOOKUP("chumby-kpp", CHUMBY_KPP_LCD_PWRON, NULL,
+			    GPIO_ACTIVE_HIGH),
+		{ },
+	},
+};
+
+static struct platform_device *chumby_devices[] __initdata = {
+	&chumby_kpp_gpio,
+	&chumby_lcd_regulator,
+	&chumby_button,
+	&chumby_pwm,
+	&chumby_backlight,
+	&chumby_sound,
+};
+
+/*
+ * The keypad port as the stock kernel leaves it: rows inputs, columns
+ * outputs, all high: Wi-Fi and the LCD on, the speaker muted until the
+ * sound driver unmutes it. Set before the GPIO chip reads it back.
+ */
+static void __init chumby_kpp_init(void)
+{
+	void __iomem *kpp = MX21_IO_ADDRESS(MX21_KPP_BASE_ADDR);
+	struct clk *clk;
+
+	clk = clk_get_sys("imx-keypad", NULL);
+	if (IS_ERR(clk) || clk_prepare_enable(clk)) {
+		pr_err("chumby: no keypad port clock\n");
+		return;
+	}
+
+	imx_writew(0, kpp + MX21_KPP_KPCR);
+	imx_writew(0xff00, kpp + MX21_KPP_KPDR);
+	imx_writew(0xff00, kpp + MX21_KPP_KDDR);
+}
+
+/*
+ * The PWM as the stock kernel sets it: reset, PERCLK1 / 2, no prescaler,
+ * PWMP 0xfffc. Its clock stays on, as pwm-imx1 writes PWMS before it
+ * enables the clocks.
+ */
+static void __init chumby_pwm_init(void)
+{
+	void __iomem *pwm = MX21_IO_ADDRESS(MX21_PWM_BASE_ADDR);
+	struct clk *clk;
+	int i, timeout = 1000;
+
+	clk = clk_get_sys("pwm-imx1.0", "ipg");
+	if (IS_ERR(clk) || clk_prepare_enable(clk)) {
+		pr_err("chumby: no PWM clock\n");
+		return;
+	}
+
+	imx_writel(MX21_PWMC_SWR, pwm + MX21_PWMC);
+	while ((imx_readl(pwm + MX21_PWMC) & MX21_PWMC_SWR) && --timeout)
+		udelay(1);
+	imx_writel(0, pwm + MX21_PWMC);
+	imx_writel(0xfffc, pwm + MX21_PWMP);
+
+	for (i = 0; i < ARRAY_SIZE(chumby_bl_levels); i++)
+		chumby_bl_levels[i] = 100 - i;
+}
+
+/*
+ * imx21-hcd enables only its peripheral clock; its registers need the
+ * AHB clock too, which would otherwise be gated off as unused.
+ */
+static void __init chumby_usb_init(void)
+{
+	struct clk *clk = clk_get_sys("imx21-hcd.0", "ahb");
+
+	if (IS_ERR(clk) || clk_prepare_enable(clk))
+		pr_err("chumby: no USB host AHB clock\n");
+}
+
+static void __init chumby_board_init(void)
+{
+	imx21_soc_init();
+
+	mxc_gpio_setup_multiple_pins(chumby_pins, ARRAY_SIZE(chumby_pins),
+				     "chumby");
+
+	imx21_add_imx_uart0(&uart_pdata_rts);
+	imx21_add_imx_uart2(&uart_pdata_norts);
+	imx21_add_mxc_nand(&chumby_nand_pdata);
+	imx21_add_imx2_wdt();
+
+	imx21_add_imx21_hcd(&chumby_usbh_pdata);
+	imx21_add_imx_ssi(0, &chumby_ssi_pdata);
+	imx21_add_spi_imx0(&chumby_cspi1_gpiod_table);
+	imx21_add_spi_imx2(NULL);
+
+	chumby_kpp_init();
+	chumby_pwm_init();
+	chumby_usb_init();
+}
+
+static void __init chumby_late_init(void)
+{
+	gpiod_add_lookup_table(&chumby_lcd_regulator_gpiod_table);
+	gpiod_add_lookup_table(&chumby_sound_gpiod_table);
+	pwm_add_table(chumby_pwm_lookup, ARRAY_SIZE(chumby_pwm_lookup));
+	/* The LCD's is the only regulator; anything else may use a dummy. */
+	regulator_has_full_constraints();
+	platform_add_devices(chumby_devices, ARRAY_SIZE(chumby_devices));
+
+	/* After the LCD's regulator, which non-DT lookups can't wait for */
+	imx21_add_imx_fb(&chumby_fb_pdata);
+
+	chumby_spi_board_info[1].irq = gpio_to_irq(CHUMBY_PEN_GPIO);
+	spi_register_board_info(chumby_spi_board_info,
+				ARRAY_SIZE(chumby_spi_board_info));
+}
+
+static void __init chumby_timer_init(void)
+{
+	mx21_clocks_init(32768, 26000000);
+}
+
+MACHINE_START(MX21ADS, "Chumby Classic")
+	.atag_offset	= 0x100,
+	.map_io		= mx21_map_io,
+	.init_early	= imx21_init_early,
+	.init_irq	= mx21_init_irq,
+	.init_time	= chumby_timer_init,
+	.init_machine	= chumby_board_init,
+	.init_late	= chumby_late_init,
+	.restart	= mxc_restart,
+MACHINE_END
