Description: ARM: imx21: add the Chumby Classic
 Its boot loader enters the kernel as an MX21ADS, so the board takes that
 machine number and excludes MACH_MX21ADS. Values are from Chumby's 2.6.16
 board file and drivers: the 320x240 panel, three USB host ports, the
 TSC2100 on CSPI3, the accelerometer on CSPI1, the PWM backlight, SSI1
 sound, and the keypad port as GPIO for the top button and the power and
 speaker switches.
Author: John Merchant <john@johnmerchant.dev>
Upstream-Status: Inappropriate [AI generated code]
Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Ee1gRFAS7tp8oLbvQ
---
diff --git a/arch/arm/mach-imx/Kconfig b/arch/arm/mach-imx/Kconfig
index e7d7b90e2..73de094a4 100644
--- a/arch/arm/mach-imx/Kconfig
+++ b/arch/arm/mach-imx/Kconfig
@@ -92,6 +92,22 @@ config MACH_MX21ADS
 	  Include support for MX21ADS platform. This includes specific
 	  configurations for the board and its peripherals.
 
+config MACH_CHUMBY_CLASSIC
+	bool "Chumby Classic"
+	depends on !MACH_MX21ADS
+	select IMX_HAVE_PLATFORM_IMX21_HCD
+	select IMX_HAVE_PLATFORM_IMX2_WDT
+	select IMX_HAVE_PLATFORM_IMX_FB
+	select IMX_HAVE_PLATFORM_IMX_SSI
+	select IMX_HAVE_PLATFORM_IMX_UART
+	select IMX_HAVE_PLATFORM_MXC_NAND
+	select IMX_HAVE_PLATFORM_SPI_IMX
+	select SOC_IMX21
+	help
+	  Include support for the Chumby Classic, an i.MX21 board. Its
+	  boot loader uses the MX21ADS machine number, so it can't be
+	  built together with MACH_MX21ADS.
+
 comment "MX27 platforms:"
 
 config MACH_MX27ADS
diff --git a/arch/arm/mach-imx/Makefile b/arch/arm/mach-imx/Makefile
index e7364e6c8..c53a8fe53 100644
--- a/arch/arm/mach-imx/Makefile
+++ b/arch/arm/mach-imx/Makefile
@@ -39,6 +39,7 @@ endif
 
 # i.MX21 based machines
 obj-$(CONFIG_MACH_MX21ADS) += mach-mx21ads.o
+obj-$(CONFIG_MACH_CHUMBY_CLASSIC) += mach-chumby-classic.o
 
 # i.MX27 based machines
 obj-$(CONFIG_MACH_MX27ADS) += mach-mx27ads.o
diff --git a/arch/arm/mach-imx/mach-chumby-classic.c b/arch/arm/mach-imx/mach-chumby-classic.c
