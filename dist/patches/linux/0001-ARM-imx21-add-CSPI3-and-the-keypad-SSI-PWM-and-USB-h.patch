From f0cb981ad5ce740b85ba119decef251781d021f6 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 02:23:30 +1030
Subject: [PATCH 1/6] ARM: imx21: add CSPI3 and the keypad, SSI, PWM and USB
 host clock lookups

The i.MX21 has three CSPIs but only the first two had platform data.
The clock driver had no lookups for the keypad port, the SSIs or the
PWM, and none without a connection id for the USB host, whose driver
asks for its clock with a NULL con_id.

Claude-Session: https://claude.ai/code/session_01B1fN5Ee1gRFAS7tp8oLbvQ
---
 arch/arm/mach-imx/devices-imx21.h            | 1 +
 arch/arm/mach-imx/devices/platform-spi_imx.c | 1 +
 drivers/clk/imx/clk-imx21.c                  | 6 ++++++
 3 files changed, 8 insertions(+)

diff --git a/arch/arm/mach-imx/devices-imx21.h b/arch/arm/mach-imx/devices-imx21.h
index 3679d1de8..af67bbcf9 100644
--- a/arch/arm/mach-imx/devices-imx21.h
+++ b/arch/arm/mach-imx/devices-imx21.h
@@ -54,3 +54,4 @@ extern const struct imx_spi_imx_data imx21_cspi_data[];
 	imx_add_spi_imx(&imx21_cspi_data[id], pdata)
 #define imx21_add_spi_imx0(pdata)	imx21_add_cspi(0, pdata)
 #define imx21_add_spi_imx1(pdata)	imx21_add_cspi(1, pdata)
+#define imx21_add_spi_imx2(pdata)	imx21_add_cspi(2, pdata)
diff --git a/arch/arm/mach-imx/devices/platform-spi_imx.c b/arch/arm/mach-imx/devices/platform-spi_imx.c
index 27747bf62..a9a1b1121 100644
--- a/arch/arm/mach-imx/devices/platform-spi_imx.c
+++ b/arch/arm/mach-imx/devices/platform-spi_imx.c
@@ -25,6 +25,7 @@ const struct imx_spi_imx_data imx21_cspi_data[] __initconst = {
 	imx_spi_imx_data_entry(MX21, CSPI, "imx21-cspi", _id, _hwid, SZ_4K)
 	imx21_cspi_data_entry(0, 1),
 	imx21_cspi_data_entry(1, 2),
+	imx21_cspi_data_entry(2, 3),
 };
 #endif
 
diff --git a/drivers/clk/imx/clk-imx21.c b/drivers/clk/imx/clk-imx21.c
index 077b4a712..4446f9a35 100644
--- a/drivers/clk/imx/clk-imx21.c
+++ b/drivers/clk/imx/clk-imx21.c
@@ -145,6 +145,7 @@ int __init mx21_clocks_init(unsigned long lref, unsigned long href)
 	clk_register_clkdev(clk[IMX21_CLK_LCDC_IPG_GATE], "ipg", "imx21-fb.0");
 	clk_register_clkdev(clk[IMX21_CLK_LCDC_HCLK_GATE], "ahb", "imx21-fb.0");
 	clk_register_clkdev(clk[IMX21_CLK_USB_GATE], "per", "imx21-hcd.0");
+	clk_register_clkdev(clk[IMX21_CLK_USB_GATE], NULL, "imx21-hcd.0");
 	clk_register_clkdev(clk[IMX21_CLK_USB_HCLK_GATE], "ahb", "imx21-hcd.0");
 	clk_register_clkdev(clk[IMX21_CLK_NFC_GATE], NULL, "imx21-nand.0");
 	clk_register_clkdev(clk[IMX21_CLK_DMA_HCLK_GATE], "ahb", "imx21-dma");
@@ -152,6 +153,11 @@ int __init mx21_clocks_init(unsigned long lref, unsigned long href)
 	clk_register_clkdev(clk[IMX21_CLK_WDOG_GATE], NULL, "imx2-wdt.0");
 	clk_register_clkdev(clk[IMX21_CLK_I2C_GATE], NULL, "imx21-i2c.0");
 	clk_register_clkdev(clk[IMX21_CLK_OWIRE_GATE], NULL, "mxc_w1.0");
+	clk_register_clkdev(clk[IMX21_CLK_KPP_GATE], NULL, "imx-keypad");
+	clk_register_clkdev(clk[IMX21_CLK_SSI1_GATE], NULL, "imx-ssi.0");
+	clk_register_clkdev(clk[IMX21_CLK_SSI2_GATE], NULL, "imx-ssi.1");
+	clk_register_clkdev(clk[IMX21_CLK_PWM_IPG_GATE], "ipg", "pwm-imx1.0");
+	clk_register_clkdev(clk[IMX21_CLK_PER1], "per", "pwm-imx1.0");
 
 	mxc_timer_init(MX21_GPT1_BASE_ADDR, MX21_INT_GPT1, GPT_TYPE_IMX21);
 
