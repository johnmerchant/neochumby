#!/bin/sh
# /init for the initramfs.
#
# The kernel has no NAND driver built in.  The NAND modules are in this
# initramfs, and are loaded only when the kernel was booted without the
# sideloader's marker: that is, when this image was flashed instead of
# handed off from the stock 2.6.16.  A normal sideload never loads them.
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

/bin/busybox --install -s /bin 2>/dev/null

mkdir -p /proc /sys /dev /tmp /mnt
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3

# Messages go to the kernel log, which is how init normally speaks.
log() { echo "init: $*" > /dev/kmsg; }

if grep -q 'neochumby.sideloaded=1' /proc/cmdline; then
    log "sideloaded; NAND modules stay unloaded"
else
    log "no sideload marker; this kernel was flashed"
    log "loading the NAND recovery modules"
    modprobe cmdlinepart 2>/dev/null
    modprobe mxc_nand 2>/dev/null
    modprobe mtdblock 2>/dev/null
    [ -e /proc/mtd ] && while read -r line; do log "/proc/mtd: $line"; done < /proc/mtd
    for dev in /dev/mtdblock*; do [ -e "$dev" ] && log "$dev"; done
    while read -r mod rest; do
        [ "$mod" = mxc_nand ] && log "module $mod loaded"
    done < /proc/modules
fi

log "starting shell"
exec setsid -c /bin/sh -i </dev/console >/dev/console 2>&1
