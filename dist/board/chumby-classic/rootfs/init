#!/bin/sh
# NANDLESS init.
#
# The kernel has no NAND driver built in.  The NAND modules are in this
# initramfs, and are loaded only when the kernel was booted without the
# sideloader's marker: that is, when this image was flashed instead of
# handed off from the stock 2.6.16.  A normal sideload never loads them.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TERM=vt100
export PS1="nandless# "
/bin/busybox --install -s /bin 2>/dev/null || true

mkdir -p /proc /sys /dev /tmp /mnt
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3

echo
echo "### NANDLESS: Linux 5.9.16 initramfs ###"
uname -a
echo "--- /proc/cmdline ---"
cat /proc/cmdline

if grep -q 'neochumby.sideloaded=1' /proc/cmdline 2>/dev/null; then
    echo "NANDLESS: sideloaded; NAND modules stay unloaded"
else
    echo "NANDLESS: no sideload marker; this kernel was flashed"
    echo "NANDLESS: loading the NAND recovery modules"
    modprobe cmdlinepart 2>/dev/null || true
    modprobe mxc_nand 2>/dev/null || true
    modprobe mtdblock 2>/dev/null || true
    echo "--- /proc/mtd ---"
    if [ -e /proc/mtd ]; then cat /proc/mtd; else echo "absent: no /proc/mtd"; fi
    echo "--- /dev/mtd* ---"
    ls -l /dev/mtd* 2>/dev/null || echo "absent: no /dev/mtd*"
fi

echo "--- /proc/modules ---"
cat /proc/modules 2>/dev/null || true
echo "### NANDLESS: starting shell ###"
exec setsid -c /bin/sh -i </dev/console >/dev/console 2>&1
