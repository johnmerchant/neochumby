# Bootlin's prebuilt armv5-eabi musl toolchain (gcc 14, headers 5.4, older
# than the kernel's), which dist/build puts over the defconfig's own on an
# x86_64 host: building gcc from source was most of a cold build, and
# Bootlin's binaries run only on x86_64.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV5_EABI_MUSL_STABLE=y
