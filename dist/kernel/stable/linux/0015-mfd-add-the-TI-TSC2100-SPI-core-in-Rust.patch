+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/ti,tsc2100.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments TSC2100 touchscreen controller and audio codec
+
+maintainers:
+  - John Merchant <john@johnmerchant.dev>
+
+description: |
+  The TSC2100 is a four-wire resistive touchscreen controller with a
+  stereo audio codec, on one SPI device. Each register access is a
+  single 16-bit-word transfer, a command word and then the data, with
+  the chip select held for both.
+
+  The interrupt is the chip's PINTDAV output, which the touchscreen uses
+  as its pen-down interrupt. The optional touchscreen properties go on
+  this node. The audio codec is described by the "codec" child node,
+  which a sound card refers to.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+  - $ref: /schemas/input/touchscreen/touchscreen.yaml#
+
+properties:
+  compatible:
+    const: ti,tsc2100
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: PINTDAV, low while the pen is down.
+
+  spi-cpha: true
+
+  codec:
+    type: object
+    additionalProperties: false
+    description: The audio codec.
+
+    properties:
+      compatible:
+        const: ti,tsc2100-codec
+
+      "#sound-dai-cells":
+        const: 0
+
+    required:
+      - compatible
+      - "#sound-dai-cells"
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        tsc2100@0 {
+            compatible = "ti,tsc2100";
+            reg = <0>;
+            spi-max-frequency = <8000000>;
+            spi-cpha;
+            interrupt-parent = <&gpio5>;
+            interrupts = <19 IRQ_TYPE_EDGE_FALLING>;
+
+            tsc2100_codec: codec {
+                compatible = "ti,tsc2100-codec";
+                #sound-dai-cells = <0>;
+            };
+        };
+    };
