+kernel::of_device_table!(
+    OF_TABLE,
+    <Imx21Hcd as platform::Driver>::IdInfo,
+    [(of::DeviceId::new(c"fsl,imx21-usbh"), ())]
+);
+
+impl platform::Driver for Imx21Hcd {
+    type IdInfo = ();
+    type Data<'bound> = usb_hcd::Registration<Imx21>;
+    const OF_ID_TABLE: Option<of::IdTable<Self::IdInfo>> = Some(&OF_TABLE);
+
+    fn probe<'bound>(
+        pdev: &'bound platform::Device<Core<'_>>,
+        _id_info: Option<&'bound Self::IdInfo>,
+    ) -> impl PinInit<Self::Data<'bound>, Error> + 'bound {
+        let dev = pdev.as_ref();
+
+        let irq = pdev.irq_by_index(0)?.irq();
+        let cfg = read_config(dev)?;
+
+        let mut etd = KVec::with_capacity(USB_NUM_ETD, GFP_KERNEL)?;
+        for _ in 0..USB_NUM_ETD {
+            etd.push(Etd::default(), GFP_KERNEL)?;
+        }
+        // Everything that can't wait for memory to be found in an interrupt.
+        let queue_for_dmem = KVec::with_capacity(USB_NUM_ETD, GFP_KERNEL)?;
+        let queue_for_etd = KVec::with_capacity(USB_NUM_ETD, GFP_KERNEL)?;
+        let dmem = KVec::with_capacity(USB_NUM_ETD * 2, GFP_KERNEL)?;
+
+        let regs = Regs::map(pdev)?;
+
+        // The registers need the AHB clock, which nothing else enables.
+        let clk_ahb = Clk::get(dev, Some(c"ahb")).inspect_err(|_| {
+            dev_err!(dev, "no ahb clock\n");
+        })?;
+        clk_ahb.prepare_enable()?;
+
+        let clk = match Clk::get(dev, Some(c"per")) {
+            Ok(clk) => clk,
+            Err(e) => {
+                clk_ahb.disable_unprepare();
+                dev_err!(dev, "no per clock\n");
+                return Err(e);
+            }
+        };
+
+        if let Err(e) = usb_hcd::clk_set_nearest_rate(&clk, 48000000).and_then(|()| clk.prepare_enable()) {
+            clk_ahb.disable_unprepare();
+            return Err(e);
+        }
+
+        dev_info!(dev, "Hardware HC revision: 0x{:02X}\n", (regs.read(USBOTG_HWMODE) >> 16) & 0xff);
+
+        // Past here the clocks are `Imx21`'s to turn off: it goes with the registration.
+        let probe_regs = regs.mapping_info();
+        usb_hcd::Registration::new(
+            pdev,
+            &probe_regs,
+            irq,
+            try_pin_init!(Imx21 {
+                regs,
+                cfg,
+                clk,
+                _clk_ahb: clk_ahb,
+                state <- new_spinlock_irq!(State {
+                    etd,
+                    eps: KVec::new(),
+                    dmem,
+                    queue_for_etd,
+                    queue_for_dmem,
+                }),
+            }),
+        )
+    }
+}
