+// SPDX-License-Identifier: GPL-2.0
+
+//! ASoC machine driver for i.MX21 boards with a TI TSC2100 codec on the SSI (Chumby Classic):
+//! imx-tsc2100.c in Rust.
+//!
+//! Wiring, from the stock Chumby 2.6.16 driver:
+//!  - SSI1 (fsl_ssi), synchronous, I2S slave: the TSC2100 is the bit and frame clock provider.
+//!    16-bit words in four slots per frame, slots 0 and 2 carrying left and right.
+//!  - AUDMUX: SSI1 (host port 1) takes its transmit clock and frame sync from the SSI2 pins
+//!    (peripheral port 2) and its receive clock, frame sync and data from the SSI1 pins (peripheral
+//!    port 1); both peripheral ports take their data from SSI1. That uses two peripheral ports,
+//!    which the fsl,mux-int-port/fsl,mux-ext-port pair of other i.MX cards can't describe, so the
+//!    routing is fixed here.
+//!  - The codec's MCLK is the board's 16 MHz oscillator. Unlike the C driver's module parameter,
+//!    it's fixed.
+//!  - The speaker amplifier is switched by a GPIO: "speaker-gpios", logically high when it's on.
+
+use kernel::{
+    device::Core,
+    of, platform,
+    prelude::*,
+    asoc::{self, CardDesc, Control, GpioOutput, OfNode, Route, Runtime, Substream, Widget},
+    sync::Arc,
+};
+
+const MCLK: u32 = 16000000;
+
+// The i.MX21 AUDMUX has the i.MX27's layout, so the MX27 port names apply.
+const HPCR1_SSI0: u32 = 0;
+const PPCR1_SSI_PINS_1: u32 = 3;
+const PPCR2_SSI_PINS_2: u32 = 4;
+
+const PCR_SYN: u32 = 1 << 12;
+const PCR_RCLKDIR: u32 = 1 << 24;
+const PCR_RFSDIR: u32 = 1 << 25;
+const PCR_TCLKDIR: u32 = 1 << 30;
+const PCR_TFSDIR: u32 = 1 << 31;
+
+const fn pcr_rxdsel(x: u32) -> u32 {
+    (x & 0x7) << 13
+}
+const fn pcr_rfcsel(x: u32) -> u32 {
+    (x & 0xf) << 20
+}
+const fn pcr_tfcsel(x: u32) -> u32 {
+    (x & 0xf) << 26
+}
+
+// `SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBP_CFP`.
+const DAI_FMT: u32 = 1 | (0 << 8) | (1 << 12);
+
+// `SNDRV_PCM_FMTBIT_S16_LE`.
+const FMTBIT_S16_LE: u64 = 1 << 2;
+
+struct Card {
+    speaker: Option<GpioOutput>,
+}
+
+impl asoc::CardOps for Card {
+    fn speaker_event(&self, on: bool) -> Result {
+        // The C driver leaves a failure, and an absent GPIO, to gpiod: the same here.
+        if let Some(speaker) = &self.speaker {
+            let _ = speaker.set(on);
+        }
+        Ok(())
+    }
+
+    fn startup(&self, substream: &Substream) -> Result {
+        // The four 16-bit slot frame only carries 16-bit samples.
+        substream.constrain_formats(FMTBIT_S16_LE)
+    }
+
+    fn dai_init(&self, runtime: &Runtime) -> Result {
+        runtime.codec_set_sysclk(MCLK).inspect_err(|e| {
+            pr_err!("codec MCLK {} Hz rejected: {}\n", MCLK, e.to_errno());
+        })?;
+
+        // As the stock driver: DC = 3, STMSK/SRMSK = ~(slot 0 | slot 2). fsl_ssi, like imx-ssi
+        // before it, writes the inverse of the mask. The SSI is a clock consumer, so it needs no
+        // sysclk of its own.
+        runtime.cpu_set_tdm_slot(0x5, 0x5, 4, 16)
+    }
+}
+
+fn audmux() -> Result {
+    // SSI1: Tx clocks from the SSI2 pins, Rx clocks and data from SSI1's.
+    asoc::imx_audmux_v1_configure_port(
+        HPCR1_SSI0,
+        PCR_TFSDIR
+            | PCR_TCLKDIR
+            | PCR_RFSDIR
+            | PCR_RCLKDIR
+            | pcr_tfcsel(PPCR2_SSI_PINS_2)
+            | pcr_rfcsel(PPCR1_SSI_PINS_1)
+            | pcr_rxdsel(PPCR1_SSI_PINS_1),
+    )?;
+
+    // Both pin groups: clocks are inputs, data out from SSI1.
+    let pins = PCR_SYN | pcr_tfcsel(HPCR1_SSI0) | pcr_rfcsel(HPCR1_SSI0) | pcr_rxdsel(HPCR1_SSI0);
+    asoc::imx_audmux_v1_configure_port(PPCR1_SSI_PINS_1, pins)?;
+    asoc::imx_audmux_v1_configure_port(PPCR2_SSI_PINS_2, pins)
+}
+
+struct ImxTsc2100;
+
+kernel::of_device_table!(
+    OF_TABLE,
+    <ImxTsc2100 as platform::Driver>::IdInfo,
+    [(of::DeviceId::new(c"chumby,imx21-tsc2100-audio"), ())]
+);
+
+impl platform::Driver for ImxTsc2100 {
+    type IdInfo = ();
+    type Data<'bound> = Self;
+    const OF_ID_TABLE: Option<of::IdTable<Self::IdInfo>> = Some(&OF_TABLE);
+
+    fn probe<'bound>(
+        pdev: &'bound platform::Device<Core<'_>>,
+        _id_info: Option<&'bound Self::IdInfo>,
+    ) -> impl PinInit<Self, Error> + 'bound {
+        let dev = pdev.as_ref();
+
+        let cpu = OfNode::from_phandle(dev, c"ssi-controller").inspect_err(|_| {
+            dev_err!(dev, "ssi-controller missing or invalid\n");
+        })?;
+        let codec = OfNode::from_phandle(dev, c"audio-codec").inspect_err(|_| {
+            dev_err!(dev, "audio-codec missing or invalid\n");
+        })?;
+
+        // Speaker off until DAPM turns it on.
+        let speaker = GpioOutput::optional_low(dev, c"speaker")?;
+
+        audmux().map_err(|e| {
+            // imx-audmux not probed yet.
+            if e == ENOSYS {
+                EPROBE_DEFER
+            } else {
+                dev_err!(dev, "AUDMUX setup failed: {}\n", e.to_errno());
+                e
+            }
+        })?;
+
+        asoc::register_card(
+            dev,
+            CardDesc {
+                name: c"TSC2100",
+                dai_fmt: DAI_FMT,
+                cpu,
+                codec,
+                codec_dai: c"tsc2100-hifi",
+                // Optional: the card keeps its 5.9 name without it.
+                model_property: c"model",
+                controls: &[
+                    Control::PinSwitch { name: c"Speaker Switch", pin: c"Speaker" },
+                    Control::PinSwitch { name: c"Headphone Switch", pin: c"Headphone" },
+                ],
+                widgets: &[Widget::Speaker(c"Speaker"), Widget::Headphone(c"Headphone")],
+                routes: &[
+                    Route { sink: c"Speaker", source: c"HPL" },
+                    Route { sink: c"Speaker", source: c"HPR" },
+                    Route { sink: c"Headphone", source: c"HPL" },
+                    Route { sink: c"Headphone", source: c"HPR" },
+                ],
+            },
+            Arc::new(Card { speaker }, GFP_KERNEL)?,
+        )?;
+
+        Ok(ImxTsc2100)
+    }
+}
+
+kernel::module_platform_driver! {
+    type: ImxTsc2100,
+    name: "imx-tsc2100",
+    authors: ["John Merchant <john@johnmerchant.dev>"],
+    description: "i.MX21 TSC2100 ASoC machine driver",
+    license: "GPL",
+}
