+// SPDX-License-Identifier: GPL-2.0
+
+//! The i.MX21/i.MX27 keypad port (KPP) as 16 general-purpose lines: gpio-imx21-kpp.c in Rust.
+//!
+//! Some boards, such as the Chumby Classic, don't wire a key matrix to the KPP: its columns switch
+//! power rails and its rows read buttons. With KPCR cleared every pin is a plain input or push-pull
+//! output, and KDDR and KPDR work as a GPIO port: lines 0-7 are the rows, lines 8-15 the columns.
+//! The KPP can't interrupt on a single row, so there are no interrupts: poll inputs instead.
+//!
+//! The lines keep the state the boot loader left them in until claimed.
+
+use kernel::{device::Core, gpio_generic, of, platform, prelude::*};
+
+const KPP_KPCR: usize = 0x0; // row enables and column open-drain
+const KPP_KDDR: usize = 0x4; // data direction, 1 = output
+const KPP_KPDR: usize = 0x6; // data
+
+struct Imx21KppGpio;
+
+kernel::of_device_table!(
+    OF_TABLE,
+    <Imx21KppGpio as platform::Driver>::IdInfo,
+    [(of::DeviceId::new(c"fsl,imx21-kpp-gpio"), ())]
+);
+
+impl platform::Driver for Imx21KppGpio {
+    type IdInfo = ();
+    type Data<'bound> = Self;
+    const OF_ID_TABLE: Option<of::IdTable<Self::IdInfo>> = Some(&OF_TABLE);
+
+    fn probe<'bound>(
+        pdev: &'bound platform::Device<Core<'_>>,
+        _id_info: Option<&'bound Self::IdInfo>,
+    ) -> impl PinInit<Self, Error> + 'bound {
+        gpio_generic::register_16(
+            pdev,
+            &gpio_generic::Config {
+                dat: KPP_KPDR,
+                dirout: KPP_KDDR,
+                ngpio: 16,
+                // No scanning: rows not ANDed into the interrupt, columns push-pull.
+                init: &[(KPP_KPCR, 0)],
+            },
+        )?;
+
+        Ok(Imx21KppGpio)
+    }
+}
+
+kernel::module_platform_driver! {
+    type: Imx21KppGpio,
+    name: "imx21-kpp-gpio",
+    authors: ["John Merchant <john@johnmerchant.dev>"],
+    description: "i.MX21 keypad port as GPIO",
+    license: "GPL",
+}
