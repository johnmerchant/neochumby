+        let d = self.iso(index);
+        // SAFETY: `iso` returns a valid descriptor.
+        unsafe { ((*d).offset, (*d).length) }
+    }
+
+    /// Sets the `index`th packet's result.
+    pub fn set_iso_result(&self, index: i32, actual: u32, status: i32) {
+        let d = self.iso(index);
