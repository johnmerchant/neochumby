+    /// `len` bytes of its transfer buffer from `offset`, for its controller to read.
+    pub fn transfer_slice(&self, offset: u32, len: u32) -> Option<&[u8]> {
+        // SAFETY: `self` is a valid URB.
+        let p = unsafe { (*self.raw()).transfer_buffer }.cast::<u8>();
+        if p.is_null() || offset.checked_add(len)? > self.transfer_buffer_length() {
+            return None;
+        }
+        // SAFETY: The buffer has `transfer_buffer_length` bytes, and those were just checked.
+        Some(unsafe { core::slice::from_raw_parts(p.add(offset as usize), len as usize) })
+    }
+
+    /// The 8 bytes of its setup packet.
+    pub fn setup_slice(&self) -> Option<&[u8]> {
+        // SAFETY: `self` is a valid URB.
+        let p = unsafe { (*self.raw()).setup_packet };
+        if p.is_null() {
+            return None;
+        }
+        // SAFETY: A control URB's setup packet is 8 bytes.
+        Some(unsafe { core::slice::from_raw_parts(p, 8) })
+    }
