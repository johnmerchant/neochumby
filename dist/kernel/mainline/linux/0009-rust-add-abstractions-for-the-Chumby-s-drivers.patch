+// SPDX-License-Identifier: GPL-2.0
+
+//! i.MX1, i.MX21 and i.MX27 pin controllers, on `drivers/pinctrl/freescale`'s core.
+//!
+//! C header: [`drivers/pinctrl/freescale/pinctrl-imx1.h`](srctree/drivers/pinctrl/freescale/pinctrl-imx1.h)
+
+use crate::{
+    alloc::{flags::GFP_KERNEL, KBox, KVec},
+    device,
+    error::*,
+    ffi::c_void,
+    platform,
+    prelude::*,
+};
+
+struct Info {
+    info: bindings::imx1_pinctrl_soc_info,
+    _pins: KVec<bindings::pinctrl_pin_desc>,
+}
+
+unsafe extern "C" fn release(data: *mut c_void) {
+    // SAFETY: `data` came from `KBox::into_raw`, and this devres action runs once.
+    drop(unsafe { KBox::from_raw(data.cast::<Info>()) });
+}
+
+/// Runs the core's probe for a controller with these pins: each its number and name.
+pub fn imx1_probe(pdev: &platform::Device<device::Core<'_>>, pins: &[(u32, &'static CStr)]) -> Result {
+    let dev: &device::Device<device::Bound> = pdev.as_ref();
+
+    let mut raw = KVec::with_capacity(pins.len(), GFP_KERNEL)?;
+    for &(number, name) in pins {
+        let mut desc: bindings::pinctrl_pin_desc = pin_init::zeroed();
+        desc.number = number;
+        desc.name = name.as_char_ptr();
+        raw.push(desc, GFP_KERNEL)?;
+    }
+
+    let mut info: bindings::imx1_pinctrl_soc_info = pin_init::zeroed();
+    info.pins = raw.as_ptr();
+    info.npins = raw.len() as _;
+
+    let holder = KBox::into_raw(KBox::new(Info { info, _pins: raw }, GFP_KERNEL)?);
+
+    // SAFETY: `holder` is valid until the action frees it, which, actions running in reverse order,
+    // is after the core's devres, which uses it.
+    to_result(unsafe {
+        bindings::devm_add_action_or_reset(dev.as_raw(), Some(release), holder.cast())
+    })?;
+
+    // SAFETY: A `platform::Device` is a `struct platform_device`, whose `dev` is `dev`.
+    let raw_pdev = unsafe { crate::container_of!(dev.as_raw(), bindings::platform_device, dev) };
+
+    // SAFETY: `raw_pdev` is valid and being probed, and `holder`'s `info` is set up, valid and
+    // exclusively the core's from here on.
+    to_result(unsafe { bindings::imx1_pinctrl_core_probe(raw_pdev, &raw mut (*holder).info) })
+}
