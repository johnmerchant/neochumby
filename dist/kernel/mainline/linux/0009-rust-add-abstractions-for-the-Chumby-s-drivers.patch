+/// `USB_PIPE*`, from a pipe's bits.
+pub const PIPE_ISOCHRONOUS: u32 = 0;
+/// See [`PIPE_ISOCHRONOUS`].
+pub const PIPE_INTERRUPT: u32 = 1;
+/// See [`PIPE_ISOCHRONOUS`].
+pub const PIPE_CONTROL: u32 = 2;
+/// See [`PIPE_ISOCHRONOUS`].
+pub const PIPE_BULK: u32 = 3;
+
+/// `URB_SHORT_NOT_OK`.
+pub const URB_SHORT_NOT_OK: u32 = bindings::URB_SHORT_NOT_OK;
+/// `URB_ISO_ASAP`.
+pub const URB_ISO_ASAP: u32 = bindings::URB_ISO_ASAP;
+/// `URB_ZERO_PACKET`.
+pub const URB_ZERO_PACKET: u32 = bindings::URB_ZERO_PACKET;
