+        (self.pipe() >> 30) & 3
+    }
+
+    /// `usb_pipeendpoint`.
+    pub fn pipe_endpoint(&self) -> u32 {
+        (self.pipe() >> 15) & 0xf
+    }
+
+    /// `usb_pipedevice`.
+    pub fn pipe_device(&self) -> u32 {
+        (self.pipe() >> 8) & 0x7f
+    }
+
+    /// `usb_pipein`.
+    pub fn pipe_in(&self) -> bool {
+        self.pipe() & bindings::USB_DIR_IN != 0
+    }
+
+    /// `usb_pipeisoc`.
+    pub fn is_isoc(&self) -> bool {
+        self.pipe_type() == PIPE_ISOCHRONOUS
+    }
+
+    /// Whether its device is low speed.
+    pub fn is_low_speed(&self) -> bool {
