+//! USB host controller drivers.
+//!
+//! An URB the core hands over is a [`Urb`] for the length of the call. Linked to its endpoint it's
+//! a [`LinkedUrb`], which has one owner and can't be copied: it goes back to the core only by
+//! moving it into [`Done::complete`], so that no URB is completed twice or used afterwards. A
+//! [`Done`] gives its URBs back as it's dropped, which should be after the driver's lock is
+//! released: declare it first, and it is.
+//!
+//! C header: [`include/linux/usb/hcd.h`](srctree/include/linux/usb/hcd.h)
+
+use crate::{
+    alloc::{flags::GFP_ATOMIC, KVec},
+    device::{self, Bound},
+    error::*,
+    ffi::{c_char, c_int, c_void},
+    platform,
+    prelude::*,
+    types::Opaque,
+};
+use core::{marker::PhantomData, ptr::NonNull};
