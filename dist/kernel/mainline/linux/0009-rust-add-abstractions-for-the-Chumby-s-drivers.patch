+// SPDX-License-Identifier: GPL-2.0
+
+//! 64-bit division that works on 32-bit architectures.
+//!
+//! Dividing a `u64` with `/` on 32-bit ARM links, but `__aeabi_uldivmod` goes to a stub that
+//! panics (see `rust/compiler_builtins.rs`).
+//!
+//! C header: [`include/linux/math64.h`](srctree/include/linux/math64.h)
+
+/// `dividend / divisor`, or [`None`] when `divisor` is zero.
+#[inline]
+pub fn div64_u64(dividend: u64, divisor: u64) -> Option<u64> {
+    if divisor == 0 {
+        return None;
+    }
+
+    // SAFETY: `div64_u64` only reads its arguments, and `divisor` isn't zero.
+    Some(unsafe { bindings::div64_u64(dividend, divisor) })
+}
