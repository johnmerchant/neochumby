+    /// Fills `len` bytes of its transfer buffer from `offset`, each from `byte`.
+    pub fn fill_transfer(&self, offset: u32, len: u32, mut byte: impl FnMut(u32) -> u8) -> Result {
+        // SAFETY: `self` is a valid URB.
+        let p = unsafe { (*self.raw()).transfer_buffer }.cast::<u8>();
