+/// One transfer of a [`Device::sync`] message, all in one chip-select frame with the others.
+#[derive(Default)]
+pub struct Transfer<'a> {
+    /// What to send, if anything.
+    pub tx: Option<&'a [u8]>,
+    /// Where to put what's received, if anything. With `tx`, the two must be the same length.
+    pub rx: Option<&'a mut [u8]>,
+    /// How long to wait after this transfer, in microseconds.
+    pub delay_us: u16,
+}
