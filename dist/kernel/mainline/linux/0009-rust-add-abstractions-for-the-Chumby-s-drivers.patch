+    /// `transfer_flags`.
+    pub fn transfer_flags(&self) -> u32 {
+        // SAFETY: `self` is a valid URB.
+        unsafe { (*self.raw()).transfer_flags }
+    }
+
+    /// `transfer_buffer_length`.
+    pub fn transfer_buffer_length(&self) -> u32 {
+        // SAFETY: `self` is a valid URB.
+        unsafe { (*self.raw()).transfer_buffer_length }
+    }
+
+    /// `transfer_dma`.
+    pub fn transfer_dma(&self) -> u32 {
+        // SAFETY: `self` is a valid URB.
+        unsafe { (*self.raw()).transfer_dma as u32 }
+    }
+
+    /// `setup_dma`.
+    pub fn setup_dma(&self) -> u32 {
+        // SAFETY: `self` is a valid URB.
+        unsafe { (*self.raw()).setup_dma as u32 }
+    }
+
+    /// `interval`.
+    pub fn interval(&self) -> i32 {
+        // SAFETY: `self` is a valid URB.
+        unsafe { (*self.raw()).interval }
+    }
+
+    /// `number_of_packets`.
+    pub fn number_of_packets(&self) -> i32 {
+        // SAFETY: `self` is a valid URB.
+        unsafe { (*self.raw()).number_of_packets }
+    }
+
+    /// `start_frame`.
+    pub fn set_start_frame(&self, frame: i32) {
