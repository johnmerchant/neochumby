+// SPDX-License-Identifier: GPL-2.0
+
+//! i.MX clock controllers (CCMs) as `drivers/clk/imx` builds them, for a Rust clock driver.
+//!
+//! C headers: [`include/linux/clk-provider.h`](srctree/include/linux/clk-provider.h),
+//! [`drivers/clk/imx/clk.h`](srctree/drivers/clk/imx/clk.h)
+
+use crate::{
+    alloc::{flags::GFP_ATOMIC, KBox, KVec},
+    error::*,
+    ffi::{c_char, c_void},
+    prelude::*,
+};
+
+/// A node in the device tree that a clock driver's init function is given.
+#[repr(transparent)]
+pub struct OfNode(bindings::device_node);
+
+/// An entry of the table of clock drivers that `of_clk_init` runs through.
+#[repr(transparent)]
+pub struct OfEntry(bindings::of_device_id);
+
+// SAFETY: The entry is immutable, and its pointers are to code.
+unsafe impl Sync for OfEntry {}
+
+impl OfEntry {
+    /// An entry for the given `compatible`, calling `init`.
+    pub const fn new(compatible: &'static CStr, init: unsafe extern "C" fn(*mut bindings::device_node)) -> Self {
+        let mut id: bindings::of_device_id = pin_init::zeroed();
+        let src = compatible.to_bytes_with_nul();
+        let mut i = 0;
+        while i < src.len() {
+            id.compatible[i] = src[i] as _;
+            i += 1;
+        }
+        id.data = init as *const c_void;
+        Self(id)
+    }
+}
+
+/// `CLK_OF_DECLARE`: runs `$init`, a `fn(&OfNode)`, early in boot for a node `$compat` matches.
+#[macro_export]
+macro_rules! clk_of_declare {
+    ($name:ident, $compat:expr, $init:path) => {
+        unsafe extern "C" fn __clk_of_trampoline(np: *mut $crate::bindings::device_node) {
+            // SAFETY: `of_clk_init` passes a valid node, and `OfNode` is a transparent wrapper.
+            $init(unsafe { &*np.cast::<$crate::imx_clk::OfNode>() })
+        }
+
+        #[used]
+        #[link_section = "__clk_of_table"]
+        static $name: $crate::imx_clk::OfEntry =
+            $crate::imx_clk::OfEntry::new($compat, __clk_of_trampoline);
+    };
+}
+
+/// A clock controller being set up: clocks go in by their id, and [`Ccm::finish`] provides them.
+pub struct Ccm {
+    np: *mut bindings::device_node,
+    base: *mut u8,
+    size: usize,
+    clks: KVec<*mut bindings::clk>,
+}
+
+impl Ccm {
+    /// Maps the node's registers, for `count` clocks.
+    pub fn new(np: &OfNode, count: usize) -> Result<Self> {
+        let np = (&raw const np.0).cast_mut();
+
+        let mut res: bindings::resource = pin_init::zeroed();
+        // SAFETY: `np` is a valid node, and `res` a valid destination.
+        to_result(unsafe { bindings::of_address_to_resource(np, 0, &mut res) })?;
+        let size = (res.end - res.start + 1) as usize;
+
+        // SAFETY: `np` is a valid node. The mapping's never undone, as these clocks never go.
+        let base = unsafe { bindings::of_iomap(np, 0) }.cast::<u8>();
+        if base.is_null() {
+            return Err(ENOMEM);
+        }
+
+        let mut clks = KVec::with_capacity(count, GFP_ATOMIC)?;
+        for _ in 0..count {
+            clks.push(core::ptr::null_mut(), GFP_ATOMIC)?;
+        }
+
+        Ok(Self { np, base, size, clks })
+    }
+
+    fn reg(&self, offset: usize) -> *mut c_void {
+        // A register that isn't there is a programming error, and to touch it would be worse.
+        assert!(offset + 4 <= self.size);
+        // SAFETY: `base` maps `size` bytes, and `offset` was just checked.
+        unsafe { self.base.add(offset) }.cast()
+    }
+
+    /// A fixed-rate clock.
+    pub fn fixed(&mut self, id: u32, name: &'static CStr, rate: i32) {
+        // SAFETY: `name` is a valid string; the clock framework copies it.
+        self.clks[id as usize] = unsafe { bindings::chumby_imx_clk_fixed(name.as_char_ptr(), rate) };
+    }
+
+    /// The fixed clock from the device tree, or this one if it has none.
+    pub fn obtain_fixed(&mut self, id: u32, name: &'static CStr, rate: u32) {
+        // SAFETY: `name` is a valid string.
+        self.clks[id as usize] = unsafe { bindings::imx_obtain_fixed_clock(name.as_char_ptr(), rate as _) };
+    }
+
+    /// A clock that's its parent's times `mult` over `div`.
+    pub fn fixed_factor(&mut self, id: u32, name: &'static CStr, parent: &'static CStr, mult: u32, div: u32) {
+        // SAFETY: The names are valid strings; the clock framework copies them.
+        self.clks[id as usize] = unsafe {
+            bindings::chumby_imx_clk_fixed_factor(name.as_char_ptr(), parent.as_char_ptr(), mult, div)
+        };
+    }
+
+    /// A clock gate: a bit of a register, set to enable.
+    pub fn gate(&mut self, id: u32, name: &'static CStr, parent: &'static CStr, offset: usize, shift: u8) {
+        let reg = self.reg(offset);
+        // SAFETY: The names are valid strings, and `reg` is a mapped register, mapped forever.
+        self.clks[id as usize] = unsafe {
+            bindings::chumby_imx_clk_gate(name.as_char_ptr(), parent.as_char_ptr(), reg, shift)
+        };
+    }
+
+    /// A clock gate: a bit of a register, set to disable.
+    pub fn gate_dis(&mut self, id: u32, name: &'static CStr, parent: &'static CStr, offset: usize, shift: u8) {
+        let reg = self.reg(offset);
+        // SAFETY: As in `gate`.
+        self.clks[id as usize] = unsafe {
+            bindings::chumby_imx_clk_gate_dis(name.as_char_ptr(), parent.as_char_ptr(), reg, shift)
+        };
+    }
+
+    /// A divider, in a field of a register.
+    pub fn divider(&mut self, id: u32, name: &'static CStr, parent: &'static CStr, offset: usize, shift: u8, width: u8) {
+        let reg = self.reg(offset);
+        // SAFETY: As in `gate`.
+        self.clks[id as usize] = unsafe {
+            bindings::chumby_imx_clk_divider(name.as_char_ptr(), parent.as_char_ptr(), reg, shift, width)
+        };
+    }
+
+    /// A mux, in a field of a register.
+    pub fn mux(&mut self, id: u32, name: &'static CStr, offset: usize, shift: u8, width: u8, parents: &[&'static CStr]) -> Result {
+        let reg = self.reg(offset);
+        let mut raw: KVec<*const c_char> = KVec::with_capacity(parents.len(), GFP_ATOMIC)?;
+        for p in parents {
+            raw.push(p.as_char_ptr(), GFP_ATOMIC)?;
+        }
+        // SAFETY: The names are valid strings; the clock framework copies them and the array.
+        self.clks[id as usize] = unsafe {
+            bindings::chumby_imx_clk_mux(name.as_char_ptr(), reg, shift, width, raw.as_ptr(), raw.len() as _)
+        };
+        Ok(())
+    }
+
+    /// An i.MX21's PLL, whose registers start at `offset`.
+    pub fn pllv1_imx21(&mut self, id: u32, name: &'static CStr, parent: &'static CStr, offset: usize) {
+        let reg = self.reg(offset);
+        // SAFETY: As in `gate`.
+        self.clks[id as usize] = unsafe {
+            bindings::chumby_imx_clk_pllv1_imx21(name.as_char_ptr(), parent.as_char_ptr(), reg)
+        };
+    }
+
+    /// Reports any clock that failed, and provides the clocks to the device tree. They stay.
+    pub fn finish(self) -> Result {
+        let (ptr, len, _cap) = self.clks.into_raw_parts();
+
+        // SAFETY: `ptr` has `len` clocks, which, like everything here, are kept forever.
+        unsafe { bindings::imx_check_clocks(ptr, len as _) };
+
+        let mut data: bindings::clk_onecell_data = pin_init::zeroed();
+        data.clks = ptr;
+        data.clk_num = len as _;
+        let data = KBox::into_raw(KBox::new(data, GFP_ATOMIC)?);
+
+        // SAFETY: `self.np` is a valid node, and `data`, valid forever, is what
+        // `of_clk_src_onecell_get` wants.
+        to_result(unsafe {
+            bindings::of_clk_add_provider(self.np, Some(bindings::of_clk_src_onecell_get), data.cast())
+        })
+    }
+}
