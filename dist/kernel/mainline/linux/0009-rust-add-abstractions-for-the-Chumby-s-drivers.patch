+/// A buffer mapped for DMA for a transfer whose own buffer can't be: unmapped as it's dropped.
+pub struct Bounce {
+    dev: *mut bindings::device,
+    buf: KVec<u8>,
+    dma: bindings::dma_addr_t,
+    to_device: bool,
+    mapped: bool,
+}
+
+// SAFETY: The buffer is owned, and the device outlasts anything in its driver's state.
+unsafe impl Send for Bounce {}
+
+impl Bounce {
+    /// Maps a buffer of `len` bytes, filled from `src` when going to the device.
+    pub fn new<T: HcDriver>(hcd: &Hcd<T>, src: Option<&[u8]>, len: usize) -> Result<Self> {
+        let mut buf = KVec::with_capacity(len, GFP_ATOMIC)?;
+        match src {
+            Some(s) => buf.extend_from_slice(s.get(..len).ok_or(EINVAL)?, GFP_ATOMIC)?,
+            None => buf.resize(len, 0, GFP_ATOMIC)?,
+        }
+        let dev = hcd.controller();
+        let dir = if src.is_some() {
+            bindings::dma_data_direction_DMA_TO_DEVICE
+        } else {
+            bindings::dma_data_direction_DMA_FROM_DEVICE
+        };
+        // SAFETY: `dev` is valid, and `buf` is a heap buffer that lives at least to the unmapping.
+        let dma = unsafe { bindings::chumby_dma_map(dev, buf.as_mut_ptr().cast(), len, dir) };
+        // SAFETY: `dev` is valid, and `dma` is what it mapped.
+        if unsafe { bindings::dma_mapping_error(dev, dma) } != 0 {
+            return Err(ENOMEM);
+        }
+        Ok(Self { dev, buf, dma, to_device: src.is_some(), mapped: true })
+    }
+
+    /// The address for the device.
+    pub fn dma(&self) -> u32 {
+        self.dma as u32
+    }
+
+    fn unmap(&mut self) {
+        if !self.mapped {
+            return;
+        }
+        self.mapped = false;
+        let dir = if self.to_device {
+            bindings::dma_data_direction_DMA_TO_DEVICE
+        } else {
+            bindings::dma_data_direction_DMA_FROM_DEVICE
+        };
+        // SAFETY: This is the mapping `new` made, undone once.
+        unsafe { bindings::chumby_dma_unmap(self.dev, self.dma, self.buf.len(), dir) };
+    }
+
+    /// Hands the buffer back to the CPU, with what the device left in it.
+    pub fn finish(mut self) -> KVec<u8> {
+        self.unmap();
+        core::mem::take(&mut self.buf)
+    }
+}
+
+impl Drop for Bounce {
+    fn drop(&mut self) {
+        self.unmap();
+    }
+}
