+// SPDX-License-Identifier: GPL-2.0
+
+//! Register maps with their own read and write functions.
+//!
+//! C header: [`include/linux/regmap.h`](srctree/include/linux/regmap.h)
+
+use crate::{
+    alloc::{flags::GFP_KERNEL, KBox},
+    device::{Bound, Device},
+    error::*,
+    ffi::{c_int, c_uint, c_void},
+    prelude::*,
+    static_lock_class,
+    time::{delay::fsleep, Delta},
+};
+use core::ptr::NonNull;
+
+/// A register map's accessors.
+pub trait Bus: Send + Sync + 'static {
+    /// Reads a register.
+    fn read(&self, reg: u32) -> Result<u32>;
+    /// Writes a register.
+    fn write(&self, reg: u32, val: u32) -> Result;
+}
+
+/// A register map's shape.
+pub struct Config {
+    /// Bits in a register's address.
+    pub reg_bits: i32,
+    /// Bits in a register's value.
+    pub val_bits: i32,
+    /// The distance between registers.
+    pub reg_stride: i32,
+    /// The highest register.
+    pub max_register: u32,
+}
+
+/// A register map, which regmap's lock makes safe to share.
+///
+/// # Invariants
+///
+/// `self.0` is a regmap that lives as long as the device it's registered on stays bound. A
+/// [`Regmap`] is only obtained from that device while bound or from its child, and is held in
+/// driver data, which is dropped before the device's devres (and a child's before its parent's).
+#[derive(Clone, Copy)]
+pub struct Regmap(NonNull<bindings::regmap>);
+
+// SAFETY: regmap's own lock serializes every access.
+unsafe impl Send for Regmap {}
+// SAFETY: regmap's own lock serializes every access.
+unsafe impl Sync for Regmap {}
+
+unsafe extern "C" fn reg_read<T: Bus>(ctx: *mut c_void, reg: c_uint, val: *mut c_uint) -> c_int {
+    // SAFETY: `ctx` is the `T` given in `register`, alive as long as the regmap.
+    let bus = unsafe { &*ctx.cast::<T>() };
+    match bus.read(reg) {
+        Ok(v) => {
+            // SAFETY: regmap passes a valid pointer to the result.
+            unsafe { *val = v };
+            0
+        }
+        Err(e) => e.to_errno(),
+    }
+}
+
+unsafe extern "C" fn reg_write<T: Bus>(ctx: *mut c_void, reg: c_uint, val: c_uint) -> c_int {
+    // SAFETY: `ctx` is the `T` given in `register`, alive as long as the regmap.
+    let bus = unsafe { &*ctx.cast::<T>() };
+    match bus.write(reg, val) {
+        Ok(()) => 0,
+        Err(e) => e.to_errno(),
+    }
+}
+
+unsafe extern "C" fn release<T: Bus>(ctx: *mut c_void) {
+    // SAFETY: `ctx` came from `KBox::into_raw` in `register`, and this action runs once.
+    drop(unsafe { KBox::from_raw(ctx.cast::<T>()) });
+}
+
+impl Regmap {
+    pub(crate) fn as_ptr(&self) -> *mut bindings::regmap {
+        self.0.as_ptr()
+    }
+
+    /// Registers a register map on `dev` until it's unbound, where `bus` does the accesses.
+    pub fn register<T: Bus>(dev: &Device<Bound>, bus: T, config: &Config) -> Result<Self> {
+        let ctx = KBox::into_raw(KBox::new(bus, GFP_KERNEL)?).cast::<c_void>();
+
+        // SAFETY: `ctx` is valid until the action runs. Actions run in reverse order, so that's
+        // after the regmap below has gone.
+        to_result(unsafe {
+            bindings::devm_add_action_or_reset(dev.as_raw(), Some(release::<T>), ctx)
+        })?;
+
+        let mut cfg: bindings::regmap_config = pin_init::zeroed();
+        cfg.reg_bits = config.reg_bits;
+        cfg.val_bits = config.val_bits;
+        cfg.reg_stride = config.reg_stride;
+        cfg.max_register = config.max_register;
+        cfg.reg_read = Some(reg_read::<T>);
+        cfg.reg_write = Some(reg_write::<T>);
+
+        // SAFETY: `dev` is bound, `ctx` is valid as above, and regmap copies what it needs of
+        // the config. The key is static.
+        let map = from_err_ptr(unsafe {
+            bindings::__devm_regmap_init(
+                dev.as_raw(),
+                core::ptr::null(),
+                ctx,
+                &cfg,
+                static_lock_class!().as_ptr(),
+                c"regmap".as_char_ptr(),
+            )
+        })?;
+
+        Ok(Self(NonNull::new(map).ok_or(ENOMEM)?))
+    }
+
+    /// The register map of `dev`'s parent, which a child outlasts only unbound.
+    pub fn of_parent(dev: &Device<Bound>) -> Result<Self> {
+        let parent = dev.parent().ok_or(ENODEV)?;
+        // SAFETY: `parent` is a valid device, and a null name asks for its only regmap.
+        let map = unsafe { bindings::dev_get_regmap(parent.as_raw(), core::ptr::null()) };
+        Ok(Self(NonNull::new(map).ok_or(ENODEV)?))
+    }
+
+    /// Reads a register.
+    pub fn read(&self, reg: u32) -> Result<u32> {
+        let mut val = 0;
+        // SAFETY: By the type invariant the map is valid, and `val` is a valid destination.
+        to_result(unsafe { bindings::regmap_read(self.0.as_ptr(), reg, &mut val) })?;
+        Ok(val)
+    }
+
+    /// Writes a register.
+    pub fn write(&self, reg: u32, val: u32) -> Result {
+        // SAFETY: By the type invariant the map is valid.
+        to_result(unsafe { bindings::regmap_write(self.0.as_ptr(), reg, val) })
+    }
+
+    /// Sets the bits of `mask` in a register to those of `val`.
+    pub fn update_bits(&self, reg: u32, mask: u32, val: u32) -> Result {
+        let old = self.read(reg)?;
+        let new = (old & !mask) | (val & mask);
+        if new != old {
+            self.write(reg, new)?;
+        }
+        Ok(())
+    }
+
+    /// Reads a register every `sleep_us` until `done` says so, for up to about `timeout_us`.
+    pub fn read_poll_timeout(
+        &self,
+        reg: u32,
+        done: impl Fn(u32) -> bool,
+        sleep_us: u32,
+        timeout_us: u32,
+    ) -> Result<u32> {
+        let mut waited = 0;
+        loop {
+            let val = self.read(reg)?;
+            if done(val) {
+                return Ok(val);
+            }
+            if waited >= timeout_us {
+                return Err(ETIMEDOUT);
+            }
+            fsleep(Delta::from_micros(i64::from(sleep_us)));
+            waited += sleep_us;
+        }
+    }
+}
