+/// An URB, for the length of a call from the core, or while it's linked.
+#[repr(transparent)]
+pub struct Urb(Opaque<bindings::urb>);
+
+impl Urb {
+    fn raw(&self) -> *mut bindings::urb {
+        self.0.get()
+    }
+
+    /// What identifies it, while it's linked.
+    pub fn id(&self) -> usize {
+        self.raw() as usize
+    }
+
+    /// What identifies its endpoint, until the endpoint's disabled.
+    pub fn ep_id(&self) -> usize {
+        // SAFETY: `self` is a valid URB, and the core sets `ep` before it gets to a driver.
+        unsafe { (*self.raw()).ep as usize }
+    }
