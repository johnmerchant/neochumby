+// SPDX-License-Identifier: GPL-2.0
+
+//! ALSA System on Chip: codecs and cards, described in Rust and built into ASoC's C tables.
+//!
+//! C header: [`include/sound/soc.h`](srctree/include/sound/soc.h)
+
+use crate::{
+    alloc::{flags::GFP_KERNEL, KBox, KVec},
+    device::{Bound, Device},
+    error::*,
+    ffi::{c_int, c_uint, c_void},
+    prelude::*,
+    regmap::Regmap,
+    sync::Arc,
+    types::Opaque,
+};
+
+/// A mixer control or a DAPM pin's switch.
+pub enum Control {
+    /// A mixer over one register: two channels if the shifts differ.
+    Mixer {
+        /// The name.
+        name: &'static CStr,
+        /// The register.
+        reg: u32,
+        /// Left, or only, shift.
+        shift_l: u32,
+        /// Right shift.
+        shift_r: u32,
+        /// The largest value.
+        max: i32,
+        /// Whether the register's sense is inverted.
+        invert: bool,
+        /// A dB scale: the minimum and the step, in hundredths of a dB.
+        db_scale: Option<(i32, u32)>,
+    },
+    /// The switch of a DAPM pin.
+    PinSwitch {
+        /// The control's name.
+        name: &'static CStr,
+        /// The widget's.
+        pin: &'static CStr,
+    },
+}
+
+/// A DAPM widget.
+pub enum Widget {
+    /// A supply, in a register's bit.
+    #[allow(missing_docs)]
+    Supply { name: &'static CStr, reg: u32, shift: u32, invert: bool },
+    /// A DAC for a stream, in a register's bit.
+    #[allow(missing_docs)]
+    Dac { name: &'static CStr, stream: &'static CStr, reg: u32, shift: u32, invert: bool },
+    /// An ADC for a stream, in a register's bit.
+    #[allow(missing_docs)]
+    Adc { name: &'static CStr, stream: &'static CStr, reg: u32, shift: u32, invert: bool },
+    /// An output pin.
+    Output(&'static CStr),
+    /// An input pin.
+    Input(&'static CStr),
+    /// A speaker, which a card's [`CardOps::speaker_event`] switches.
+    Speaker(&'static CStr),
+    /// Headphones.
+    Headphone(&'static CStr),
+}
+
+/// A DAPM route, with no control.
+pub struct Route {
+    /// Where it goes.
+    pub sink: &'static CStr,
+    /// Where it's from.
+    pub source: &'static CStr,
+}
+
+type WidgetEvent = unsafe extern "C" fn(
+    *mut bindings::snd_soc_dapm_widget,
+    *mut bindings::snd_kcontrol,
+    c_int,
+) -> c_int;
+
+/// ASoC's tables for a component or a card. They don't move, being heap allocations that are
+/// never grown after they're pointed to.
+struct Tables {
+    _mixers: KVec<bindings::soc_mixer_control>,
+    _tlvs: KVec<[u32; 4]>,
+    controls: KVec<bindings::snd_kcontrol_new>,
+    widgets: KVec<bindings::snd_soc_dapm_widget>,
+    routes: KVec<bindings::snd_soc_dapm_route>,
+}
+
+// SAFETY: The tables are only read after they're built, by whichever thread.
+unsafe impl Send for Tables {}
+// SAFETY: As above.
+unsafe impl Sync for Tables {}
+
+const SND_SOC_NOPM: c_int = -1;
+const DAPM_POST_PMU: u16 = 0x2;
+const DAPM_PRE_PMD: u16 = 0x4;
+
+impl Tables {
+    fn new(
+        controls: &[Control],
+        widgets: &[Widget],
+        routes: &[Route],
+        event: Option<WidgetEvent>,
+    ) -> Result<Self> {
+        let mut mixers = KVec::with_capacity(controls.len(), GFP_KERNEL)?;
+        let mut tlvs = KVec::with_capacity(controls.len(), GFP_KERNEL)?;
+        let mut raw_controls = KVec::with_capacity(controls.len(), GFP_KERNEL)?;
+
+        for control in controls {
+            let mut k: bindings::snd_kcontrol_new = pin_init::zeroed();
+            k.iface = bindings::SNDRV_CTL_ELEM_IFACE_MIXER as _;
+            match control {
+                Control::Mixer { name, reg, shift_l, shift_r, max, invert, db_scale } => {
+                    let mut m: bindings::soc_mixer_control = pin_init::zeroed();
+                    m.reg = *reg as _;
+                    m.rreg = *reg as _;
+                    m.shift = *shift_l as _;
+                    m.rshift = *shift_r as _;
+                    m.max = *max;
+                    m.set_invert(u32::from(*invert));
+                    mixers.push(m, GFP_KERNEL)?;
+
+                    k.name = name.as_char_ptr().cast();
+                    k.info = Some(bindings::snd_soc_info_volsw);
+                    k.get = Some(bindings::snd_soc_get_volsw);
+                    k.put = Some(bindings::snd_soc_put_volsw);
+                    // `mixers` has its capacity, so its elements never move.
+                    k.private_value = mixers.last().map_or(0, |m| core::ptr::from_ref(m) as _);
+
+                    if let Some((min, step)) = db_scale {
+                        tlvs.push(
+                            [
+                                bindings::SNDRV_CTL_TLVT_DB_SCALE,
+                                8,
+                                *min as u32,
+                                *step & bindings::SNDRV_CTL_TLVD_DB_SCALE_MASK,
+                            ],
+                            GFP_KERNEL,
+                        )?;
+                        k.access = bindings::SNDRV_CTL_ELEM_ACCESS_TLV_READ
+                            | bindings::SNDRV_CTL_ELEM_ACCESS_READWRITE;
+                        k.tlv.p = tlvs.last().map_or(core::ptr::null(), |t| t.as_ptr());
+                    }
+                }
+                Control::PinSwitch { name, pin } => {
+                    k.name = name.as_char_ptr().cast();
+                    k.info = Some(bindings::snd_soc_dapm_info_pin_switch);
+                    k.get = Some(bindings::snd_soc_dapm_get_pin_switch);
+                    k.put = Some(bindings::snd_soc_dapm_put_pin_switch);
+                    k.private_value = pin.as_char_ptr() as _;
+                }
+            }
+            raw_controls.push(k, GFP_KERNEL)?;
+        }
+
+        let mut raw_widgets = KVec::with_capacity(widgets.len(), GFP_KERNEL)?;
+        for widget in widgets {
+            let mut w: bindings::snd_soc_dapm_widget = pin_init::zeroed();
+            let in_reg = |w: &mut bindings::snd_soc_dapm_widget, reg: u32, shift: u32, invert: bool| {
+                w.reg = reg as _;
+                w.mask = 1;
+                w.shift = shift as _;
+                w.on_val = u32::from(!invert) as _;
+                w.off_val = u32::from(invert) as _;
+            };
+            match widget {
+                Widget::Supply { name, reg, shift, invert } => {
+                    w.id = bindings::snd_soc_dapm_type_snd_soc_dapm_supply;
+                    w.name = name.as_char_ptr();
+                    in_reg(&mut w, *reg, *shift, *invert);
+                }
+                Widget::Dac { name, stream, reg, shift, invert } => {
+                    w.id = bindings::snd_soc_dapm_type_snd_soc_dapm_dac;
+                    w.name = name.as_char_ptr();
+                    w.sname = stream.as_char_ptr();
+                    in_reg(&mut w, *reg, *shift, *invert);
+                }
+                Widget::Adc { name, stream, reg, shift, invert } => {
+                    w.id = bindings::snd_soc_dapm_type_snd_soc_dapm_adc;
+                    w.name = name.as_char_ptr();
+                    w.sname = stream.as_char_ptr();
+                    in_reg(&mut w, *reg, *shift, *invert);
+                }
+                Widget::Output(name) => {
+                    w.id = bindings::snd_soc_dapm_type_snd_soc_dapm_output;
+                    w.name = name.as_char_ptr();
+                    w.reg = SND_SOC_NOPM;
+                }
+                Widget::Input(name) => {
+                    w.id = bindings::snd_soc_dapm_type_snd_soc_dapm_input;
+                    w.name = name.as_char_ptr();
+                    w.reg = SND_SOC_NOPM;
+                }
+                Widget::Speaker(name) => {
+                    w.id = bindings::snd_soc_dapm_type_snd_soc_dapm_spk;
+                    w.name = name.as_char_ptr();
+                    w.reg = SND_SOC_NOPM;
+                    w.event = event;
+                    w.event_flags = DAPM_POST_PMU | DAPM_PRE_PMD;
+                }
+                Widget::Headphone(name) => {
+                    w.id = bindings::snd_soc_dapm_type_snd_soc_dapm_hp;
+                    w.name = name.as_char_ptr();
+                    w.reg = SND_SOC_NOPM;
+                    w.event_flags = DAPM_POST_PMU | DAPM_PRE_PMD;
+                }
+            }
+            raw_widgets.push(w, GFP_KERNEL)?;
+        }
+
+        let mut raw_routes = KVec::with_capacity(routes.len(), GFP_KERNEL)?;
+        for route in routes {
+            let mut r: bindings::snd_soc_dapm_route = pin_init::zeroed();
+            r.sink = route.sink.as_char_ptr();
+            r.source = route.source.as_char_ptr();
+            raw_routes.push(r, GFP_KERNEL)?;
+        }
+
+        Ok(Self {
+            _mixers: mixers,
+            _tlvs: tlvs,
+            controls: raw_controls,
+            widgets: raw_widgets,
+            routes: raw_routes,
+        })
+    }
+}
+
+/// A component: a codec, as ASoC calls it back.
+///
+/// # Invariants
+///
+/// A reference to this is to a valid `struct snd_soc_component`.
+#[repr(transparent)]
+pub struct Component(Opaque<bindings::snd_soc_component>);
+
+impl Component {
+    /// Sets the bits of `mask` in a register to those of `val`.
+    pub fn update_bits(&self, reg: u32, mask: u32, val: u32) -> Result {
+        // SAFETY: By the type invariant, the component is valid.
+        let ret = unsafe { bindings::snd_soc_component_update_bits(self.0.get(), reg, mask, val) };
+        to_result(ret.min(0))
+    }
+
+    /// How many streams are active on it.
+    pub fn active(&self) -> u32 {
+        // SAFETY: By the type invariant, the component is valid.
+        unsafe { bindings::snd_soc_component_active(self.0.get()) as u32 }
+    }
+
+    /// Gives it the regmap that its controls and widgets use.
+    pub fn init_regmap(&self, map: &Regmap) {
+        // SAFETY: By the type invariant the component is valid, and `map` too.
+        unsafe { bindings::snd_soc_component_init_regmap(self.0.get(), map.as_ptr()) };
+    }
+
+    /// Takes the regmap back.
+    pub fn exit_regmap(&self) {
+        // SAFETY: By the type invariant, the component is valid.
+        unsafe { bindings::snd_soc_component_exit_regmap(self.0.get()) };
+    }
+}
+
+/// A codec's implementation.
+pub trait Codec: Send + Sync + 'static {
+    /// The component is being probed.
+    fn probe(&self, component: &Component) -> Result;
+    /// The component is being removed.
+    fn remove(&self, component: &Component);
+    /// A stream's parameters: its rate and its sample width.
+    fn hw_params(&self, component: &Component, rate: u32, width: u32) -> Result;
+    /// The DAI's clock.
+    fn set_sysclk(&self, freq: u32) -> Result;
+    /// The DAI's format: `SND_SOC_DAIFMT_*`.
+    fn set_fmt(&self, fmt: u32) -> Result;
+}
+
+/// A DAI's stream.
+#[derive(Clone, Copy)]
+pub struct Stream {
+    /// The name, which DAPM widgets name.
+    pub name: &'static CStr,
+    /// Least channels.
+    pub channels_min: u32,
+    /// Most channels.
+    pub channels_max: u32,
+    /// `SNDRV_PCM_RATE_*`.
+    pub rates: u32,
+    /// `SNDRV_PCM_FMTBIT_*`.
+    pub formats: u64,
+}
+
+/// A codec with one DAI, with symmetric rates and sample bits.
+pub struct CodecDesc<'a> {
+    /// The DAI's name.
+    pub dai_name: &'static CStr,
+    /// Playback.
+    pub playback: Stream,
+    /// Capture.
+    pub capture: Stream,
+    /// Mixer controls.
+    pub controls: &'a [Control],
+    /// DAPM widgets.
+    pub widgets: &'a [Widget],
+    /// DAPM routes.
+    pub routes: &'a [Route],
+}
+
+#[repr(C)]
+struct CodecHolder<T> {
+    component: bindings::snd_soc_component_driver,
+    dai: bindings::snd_soc_dai_driver,
+    dai_ops: bindings::snd_soc_dai_ops,
+    tables: Tables,
+    ops: Arc<T>,
+}
+
+fn raw_stream(s: &Stream) -> bindings::snd_soc_pcm_stream {
+    let mut r: bindings::snd_soc_pcm_stream = pin_init::zeroed();
+    r.stream_name = s.name.as_char_ptr();
+    r.formats = s.formats;
+    r.rates = s.rates;
+    r.channels_min = s.channels_min;
+    r.channels_max = s.channels_max;
+    r
+}
+
+unsafe fn codec_of_component<'a, T>(c: *mut bindings::snd_soc_component) -> (&'a CodecHolder<T>, &'a Component) {
+    // SAFETY: ASoC passes the component registered in `register_codec`, whose driver is the first
+    // field of a live, `repr(C)` `CodecHolder<T>`, which outlasts the component.
+    unsafe { (&*(*c).driver.cast::<CodecHolder<T>>(), &*c.cast::<Component>()) }
+}
+
+unsafe fn codec_of_dai<'a, T>(dai: *mut bindings::snd_soc_dai) -> (&'a CodecHolder<T>, &'a Component) {
+    // SAFETY: A DAI's component is valid while the DAI is.
+    unsafe { codec_of_component((*dai).component) }
+}
+
+unsafe extern "C" fn codec_probe<T: Codec>(c: *mut bindings::snd_soc_component) -> c_int {
+    // SAFETY: ASoC passes a valid component.
+    let (holder, component) = unsafe { codec_of_component::<T>(c) };
+    from_result(|| holder.ops.probe(component).map(|()| 0))
+}
+
+unsafe extern "C" fn codec_remove<T: Codec>(c: *mut bindings::snd_soc_component) {
+    // SAFETY: ASoC passes a valid component.
+    let (holder, component) = unsafe { codec_of_component::<T>(c) };
+    holder.ops.remove(component);
+}
+
+unsafe extern "C" fn codec_hw_params<T: Codec>(
+    _substream: *mut bindings::snd_pcm_substream,
+    params: *mut bindings::snd_pcm_hw_params,
+    dai: *mut bindings::snd_soc_dai,
+) -> c_int {
+    // SAFETY: ASoC passes a valid DAI.
+    let (holder, component) = unsafe { codec_of_dai::<T>(dai) };
+    // SAFETY: ASoC passes valid parameters.
+    let (rate, width) = unsafe { (bindings::params_rate(params), bindings::params_width(params)) };
+    from_result(|| holder.ops.hw_params(component, rate as u32, width as u32).map(|()| 0))
+}
+
+unsafe extern "C" fn codec_set_sysclk<T: Codec>(
+    dai: *mut bindings::snd_soc_dai,
+    _clk_id: c_int,
+    freq: c_uint,
+    _dir: c_int,
+) -> c_int {
+    // SAFETY: ASoC passes a valid DAI.
+    let (holder, _) = unsafe { codec_of_dai::<T>(dai) };
+    from_result(|| holder.ops.set_sysclk(freq).map(|()| 0))
+}
+
+unsafe extern "C" fn codec_set_fmt<T: Codec>(dai: *mut bindings::snd_soc_dai, fmt: c_uint) -> c_int {
+    // SAFETY: ASoC passes a valid DAI.
+    let (holder, _) = unsafe { codec_of_dai::<T>(dai) };
+    from_result(|| holder.ops.set_fmt(fmt).map(|()| 0))
+}
+
+unsafe extern "C" fn drop_box<H>(data: *mut c_void) {
+    // SAFETY: `data` came from `KBox::into_raw`, and this devres action runs once.
+    drop(unsafe { KBox::from_raw(data.cast::<H>()) });
+}
+
+/// Registers a codec on `dev` until it's unbound.
+pub fn register_codec<T: Codec>(dev: &Device<Bound>, desc: &CodecDesc<'_>, ops: Arc<T>) -> Result {
+    let tables = Tables::new(desc.controls, desc.widgets, desc.routes, None)?;
+
+    let holder = KBox::new(
+        CodecHolder::<T> {
+            component: pin_init::zeroed(),
+            dai: pin_init::zeroed(),
+            dai_ops: pin_init::zeroed(),
+            tables,
+            ops,
+        },
+        GFP_KERNEL,
+    )?;
+    let h = KBox::into_raw(holder);
+
+    // SAFETY: `h` is valid and exclusively ours, until it's registered below. The pointers it
+    // gets are to its own heap-allocated fields and tables, and to `'static` strings.
+    unsafe {
+        (*h).dai_ops.hw_params = Some(codec_hw_params::<T>);
+        (*h).dai_ops.set_sysclk = Some(codec_set_sysclk::<T>);
+        (*h).dai_ops.set_fmt = Some(codec_set_fmt::<T>);
+
+        (*h).dai.name = desc.dai_name.as_char_ptr();
+        (*h).dai.playback = raw_stream(&desc.playback);
+        (*h).dai.capture = raw_stream(&desc.capture);
+        (*h).dai.ops = &raw const (*h).dai_ops;
+        (*h).dai.set_symmetric_rate(1);
+        (*h).dai.set_symmetric_sample_bits(1);
+
+        (*h).component.probe = Some(codec_probe::<T>);
+        (*h).component.remove = Some(codec_remove::<T>);
+        (*h).component.controls = (*h).tables.controls.as_ptr();
+        (*h).component.num_controls = (*h).tables.controls.len() as _;
+        (*h).component.dapm_widgets = (*h).tables.widgets.as_ptr();
+        (*h).component.num_dapm_widgets = (*h).tables.widgets.len() as _;
+        (*h).component.dapm_routes = (*h).tables.routes.as_ptr();
+        (*h).component.num_dapm_routes = (*h).tables.routes.len() as _;
+        (*h).component.set_use_pmdown_time(1);
+        (*h).component.set_endianness(1);
+    }
+
+    // SAFETY: `h` is valid until the action frees it, which, actions running in reverse order, is
+    // after the component below has gone.
+    to_result(unsafe {
+        bindings::devm_add_action_or_reset(dev.as_raw(), Some(drop_box::<CodecHolder<T>>), h.cast())
+    })?;
+
+    // SAFETY: `h` is fully set up, and stays until the component has gone.
+    to_result(unsafe {
+        bindings::devm_snd_soc_register_component(
+            dev.as_raw(),
+            &raw const (*h).component,
+            &raw mut (*h).dai,
+            1,
+        )
+    })
+}
+
+/// A device tree node, with a reference on it.
+pub struct OfNode(core::ptr::NonNull<bindings::device_node>);
+
+// SAFETY: A node's reference count may be dropped from any thread.
+unsafe impl Send for OfNode {}
+
+impl OfNode {
+    /// The node that `dev`'s node's property `name` points to.
+    pub fn from_phandle(dev: &Device<Bound>, name: &CStr) -> Result<Self> {
+        // SAFETY: `dev` is valid and its node, if any, is valid. `name` is a valid string, and
+        // the C function returns a new reference, or null.
+        let np = unsafe { bindings::of_parse_phandle((*dev.as_raw()).of_node, name.as_char_ptr(), 0) };
+        core::ptr::NonNull::new(np).map(Self).ok_or(EINVAL)
+    }
+}
+
+impl Drop for OfNode {
+    fn drop(&mut self) {
+        // SAFETY: We hold a reference.
+        unsafe { bindings::of_node_put(self.0.as_ptr()) };
+    }
+}
