@@ -0,0 +1,319 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Input devices that report absolute axes and keys, and a threaded interrupt to drive them.
+//!
+//! C headers: [`include/linux/input.h`](srctree/include/linux/input.h),
+//! [`include/linux/input/touchscreen.h`](srctree/include/linux/input/touchscreen.h)
+
+use crate::{
+    alloc::{flags::GFP_KERNEL, KBox},
+    device::{Bound, Device},
+    error::*,
+    ffi::{c_int, c_void},
+    irq::Flags,
+    prelude::*,
+    sync::{Arc, ArcBorrow},
+};
+use core::ptr::NonNull;
+
+/// `ABS_X`.
+pub const ABS_X: u32 = bindings::ABS_X;
+/// `ABS_Y`.
+pub const ABS_Y: u32 = bindings::ABS_Y;
+/// `ABS_PRESSURE`.
+pub const ABS_PRESSURE: u32 = bindings::ABS_PRESSURE;
+/// `BTN_TOUCH`.
+pub const BTN_TOUCH: u32 = bindings::BTN_TOUCH;
+/// `BUS_SPI`.
+pub const BUS_SPI: u16 = bindings::BUS_SPI as u16;
+
+/// What a device does as it's opened and closed.
+pub trait Operations: Send + Sync + 'static {
+    /// The first user has opened it.
+    fn open(&self) -> Result;
+    /// The last user has closed it.
+    fn close(&self);
+}
+
+/// An input device being set up. Dropped unregistered, it's freed.
+///
+/// # Invariants
+///
+/// `self.0` is a valid `struct input_dev`, from `input_allocate_device`, not registered.
+pub struct Builder(NonNull<bindings::input_dev>);
+
+/// Reports events to an input device, for as long as it's held.
+///
+/// # Invariants
+///
+/// `input` holds a reference on the device, so it stays allocated. `input_event` takes the
+/// device's own lock, and ignores events it isn't set up for.
+pub struct Reporter {
+    input: NonNull<bindings::input_dev>,
+    prop: KBox<bindings::touchscreen_properties>,
+}
+
+// SAFETY: `Reporter` only calls `input_event` and `touchscreen_report_pos`, which any thread may.
+unsafe impl Send for Reporter {}
+// SAFETY: As above: those lock the device for themselves.
+unsafe impl Sync for Reporter {}
+
+impl Builder {
+    /// Allocates an input device, a child of `parent`.
+    pub fn new(
+        parent: &Device<Bound>,
+        name: &'static CStr,
+        phys: &'static CStr,
+        bustype: u16,
+    ) -> Result<Self> {
+        // SAFETY: There are no preconditions.
+        let input = NonNull::new(unsafe { bindings::input_allocate_device() }).ok_or(ENOMEM)?;
+        let raw = input.as_ptr();
+
+        // SAFETY: `raw` is valid and not registered, so it's exclusively ours. The strings are
+        // `'static`, and a device keeps a reference on its parent.
+        unsafe {
+            (*raw).name = name.as_char_ptr();
+            (*raw).phys = phys.as_char_ptr();
+            (*raw).id.bustype = bustype;
+            (*raw).dev.parent = parent.as_raw();
+        }
+
+        Ok(Self(input))
+    }
+
+    /// Says it reports the key `code`.
+    pub fn key(&mut self, code: u32) -> &mut Self {
+        // SAFETY: By the type invariant, `self.0` is valid.
+        unsafe { bindings::input_set_capability(self.0.as_ptr(), bindings::EV_KEY, code) };
+        self
+    }
+
+    /// Says it reports the absolute axis `axis`, between `min` and `max`.
+    pub fn abs(&mut self, axis: u32, min: i32, max: i32) -> &mut Self {
+        // SAFETY: By the type invariant, `self.0` is valid.
+        unsafe { bindings::input_set_abs_params(self.0.as_ptr(), axis, min, max, 0, 0) };
+        self
+    }
+
+    /// A [`Reporter`], with the touchscreen properties of the device tree node of the device's
+    /// parent, or of its parent's parent when it has no node of its own.
+    pub fn reporter(&mut self, parent: &Device<Bound>) -> Result<Reporter> {
+        let raw = self.0.as_ptr();
+        let dev = parent.as_raw();
+        let mut prop = KBox::new(pin_init::zeroed(), GFP_KERNEL)?;
+
+        // SAFETY: `dev` is a valid, bound device, whose parent, if any, is valid. Its node isn't
+        // used concurrently: it's being probed. `raw` and `prop` are valid.
+        unsafe {
+            if (*dev).of_node.is_null() && !(*dev).parent.is_null() && !(*(*dev).parent).of_node.is_null() {
+                bindings::device_set_of_node_from_dev(dev, (*dev).parent);
+            }
+            bindings::touchscreen_parse_properties(raw, false, &mut *prop);
+            bindings::get_device(&raw mut (*raw).dev);
+        }
+
+        Ok(Reporter { input: self.0, prop })
+    }
+
+    /// Registers the device, until `parent` is unbound, for `ops` to open and close.
+    pub fn register<T: Operations>(self, parent: &Device<Bound>, ops: Arc<T>) -> Result {
+        let raw = self.0.as_ptr();
+        let cookie = Arc::into_raw(ops);
+
+        // SAFETY: `raw` is valid and not registered, so it's exclusively ours.
+        unsafe {
+            (*raw).open = Some(open::<T>);
+            (*raw).close = Some(close::<T>);
+            (*raw).dev.driver_data = cookie.cast_mut().cast();
+        }
+
+        // SAFETY: `raw` is fully set up.
+        let ret = to_result(unsafe { bindings::input_register_device(raw) });
+        if let Err(e) = ret {
+            // SAFETY: `cookie` came from `Arc::into_raw` above, and nothing else has it.
+            drop(unsafe { Arc::from_raw(cookie) });
+            return Err(e); // `self` frees the device.
+        }
+        core::mem::forget(self);
+
+        let action = KBox::into_raw(KBox::new(Registered::<T> { input: raw, cookie }, GFP_KERNEL)?);
+        // SAFETY: `action` is valid until the action, which runs once, frees it.
+        to_result(unsafe {
+            bindings::devm_add_action_or_reset(
+                parent.as_raw(),
+                Some(unregister::<T>),
+                action.cast::<c_void>(),
+            )
+        })
+    }
+}
+
+impl Drop for Builder {
+    fn drop(&mut self) {
+        // SAFETY: By the type invariant, it's allocated and not registered.
+        unsafe { bindings::input_free_device(self.0.as_ptr()) };
+    }
+}
+
+struct Registered<T> {
+    input: *mut bindings::input_dev,
+    cookie: *const T,
+}
+
+unsafe extern "C" fn unregister<T: Operations>(data: *mut c_void) {
+    // SAFETY: `data` came from `KBox::into_raw` in `register`, and this runs once.
+    let reg = unsafe { KBox::from_raw(data.cast::<Registered<T>>()) };
+    // SAFETY: `reg.input` is registered. Past this, it's not opened or closed again.
+    unsafe { bindings::input_unregister_device(reg.input) };
+    // SAFETY: `reg.cookie` came from `Arc::into_raw`, and the device no longer uses it.
+    drop(unsafe { Arc::from_raw(reg.cookie) });
+}
+
+unsafe extern "C" fn open<T: Operations>(input: *mut bindings::input_dev) -> c_int {
+    // SAFETY: `driver_data` is the `Arc` of `register`, alive until after unregistration.
+    let ops = unsafe { ArcBorrow::<T>::from_raw((*input).dev.driver_data.cast::<T>()) };
+    match ops.open() {
+        Ok(()) => 0,
+        Err(e) => e.to_errno(),
+    }
+}
+
+unsafe extern "C" fn close<T: Operations>(input: *mut bindings::input_dev) {
+    // SAFETY: As in `open`.
+    let ops = unsafe { ArcBorrow::<T>::from_raw((*input).dev.driver_data.cast::<T>()) };
+    ops.close();
+}
+
+impl Reporter {
+    /// Reports the touchscreen's position, as its properties transform it.
+    pub fn touch_pos(&self, x: u32, y: u32) {
+        // SAFETY: By the type invariant `input` is valid, and `prop` is initialized.
+        unsafe {
+            bindings::touchscreen_report_pos(self.input.as_ptr(), &*self.prop, x, y, false);
+        }
+    }
+
+    /// Reports an absolute axis.
+    pub fn abs(&self, axis: u32, value: i32) {
+        // SAFETY: By the type invariant `input` is valid.
+        unsafe { bindings::input_event(self.input.as_ptr(), bindings::EV_ABS, axis, value) };
+    }
+
+    /// Reports a key.
+    pub fn key(&self, code: u32, down: bool) {
+        // SAFETY: By the type invariant `input` is valid.
+        unsafe {
+            bindings::input_event(self.input.as_ptr(), bindings::EV_KEY, code, i32::from(down))
+        };
+    }
+
+    /// Ends a set of events.
+    pub fn sync(&self) {
+        // SAFETY: By the type invariant `input` is valid.
+        unsafe {
+            bindings::input_event(self.input.as_ptr(), bindings::EV_SYN, bindings::SYN_REPORT, 0)
+        };
+    }
+}
+
+impl Drop for Reporter {
+    fn drop(&mut self) {
+        // SAFETY: By the type invariant we hold a reference.
+        unsafe { bindings::put_device(&raw mut (*self.input.as_ptr()).dev) };
+    }
+}
+
+/// What a threaded interrupt runs.
+pub trait IrqThread: Send + Sync + 'static {
+    /// Runs in the interrupt's thread.
+    fn thread(&self);
+}
+
+/// An interrupt line.
+#[derive(Clone, Copy)]
+pub struct IrqLine(u32);
+
+impl IrqLine {
+    /// The line with this number.
+    pub const fn new(irq: u32) -> Self {
+        Self(irq)
+    }
+
+    /// Enables it.
+    pub fn enable(self) {
+        // SAFETY: `enable_irq` checks the number, and warns of an imbalance.
+        unsafe { bindings::enable_irq(self.0) };
+    }
+
+    /// Disables it, and waits for its handlers.
+    pub fn disable(self) {
+        // SAFETY: `disable_irq` checks the number, and may sleep, as this may.
+        unsafe { bindings::disable_irq(self.0) };
+    }
+
+    /// Requests it, until `dev` is unbound, with no primary handler, for `handler` to run.
+    pub fn request_threaded<T: IrqThread>(
+        self,
+        dev: &Device<Bound>,
+        flags: Flags,
+        name: &'static CStr,
+        handler: Arc<T>,
+    ) -> Result {
+        let cookie = Arc::into_raw(handler);
+
+        // SAFETY: `cookie` stays valid until `free_threaded`, which frees the interrupt first.
+        let ret = to_result(unsafe {
+            bindings::request_threaded_irq(
+                self.0,
+                None,
+                Some(run_thread::<T>),
+                flags.into_inner() as _,
+                name.as_char_ptr(),
+                cookie.cast_mut().cast(),
+            )
+        });
+        if let Err(e) = ret {
+            // SAFETY: `cookie` came from `Arc::into_raw` above, and nothing has it.
+            drop(unsafe { Arc::from_raw(cookie) });
+            return Err(e);
+        }
+
+        let action = KBox::into_raw(KBox::new(
+            Requested::<T> {
+                irq: self.0,
+                cookie,
+            },
+            GFP_KERNEL,
+        )?);
+        // SAFETY: `action` is valid until the action, which runs once, frees it.
+        to_result(unsafe {
+            bindings::devm_add_action_or_reset(
+                dev.as_raw(),
+                Some(free_threaded::<T>),
+                action.cast::<c_void>(),
+            )
+        })
+    }
+}
+
+struct Requested<T> {
+    irq: u32,
+    cookie: *const T,
+}
+
+unsafe extern "C" fn run_thread<T: IrqThread>(_irq: c_int, data: *mut c_void) -> bindings::irqreturn_t {
+    // SAFETY: `data` is the `Arc` of `request_threaded`, alive until the interrupt is freed.
+    let handler = unsafe { ArcBorrow::<T>::from_raw(data.cast::<T>()) };
+    handler.thread();
+    bindings::irqreturn_IRQ_HANDLED
+}
+
+unsafe extern "C" fn free_threaded<T: IrqThread>(data: *mut c_void) {
+    // SAFETY: `data` came from `KBox::into_raw`, and this runs once.
+    let req = unsafe { KBox::from_raw(data.cast::<Requested<T>>()) };
+    // SAFETY: The interrupt was requested with this cookie.
+    unsafe { bindings::free_irq(req.irq, req.cookie.cast_mut().cast()) };
+    // SAFETY: `req.cookie` came from `Arc::into_raw`, and the interrupt no longer uses it.
+    drop(unsafe { Arc::from_raw(req.cookie) });
+}
