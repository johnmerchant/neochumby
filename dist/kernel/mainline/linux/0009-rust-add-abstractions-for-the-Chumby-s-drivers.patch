+// SPDX-License-Identifier: GPL-2.0
+
+//! GPIO chips on the generic MMIO library.
+//!
+//! C header: [`include/linux/gpio/generic.h`](srctree/include/linux/gpio/generic.h)
+
+use crate::{
+    alloc::flags::GFP_KERNEL,
+    device,
+    error::*,
+    platform,
+    prelude::*,
+    static_lock_class,
+};
+
+/// A chip of 16-bit registers in the platform device's first memory resource.
+pub struct Config<'a> {
+    /// Offset of the data register.
+    pub dat: usize,
+    /// Offset of the direction register, where 1 is an output.
+    pub dirout: usize,
+    /// How many lines.
+    pub ngpio: u16,
+    /// Offsets to write first, and the values to write there.
+    pub init: &'a [(usize, u16)],
+}
+
+/// Maps the registers, enables the device's only clock, writes `config.init` and adds the chip,
+/// all until `pdev` is unbound.
+pub fn register_16(pdev: &platform::Device<device::Core<'_>>, config: &Config<'_>) -> Result {
+    let dev: &device::Device<device::Bound> = pdev.as_ref();
+    let raw = dev.as_raw();
+
+    // SAFETY: A `platform::Device` is a `struct platform_device`, whose `dev` is `dev`.
+    let pdev_raw = unsafe { crate::container_of!(raw, bindings::platform_device, dev) };
+
+    // SAFETY: `pdev_raw` is valid and bound.
+    let regs = from_err_ptr(unsafe {
+        bindings::devm_platform_ioremap_resource(pdev_raw, 0)
+    })?;
+
+    // SAFETY: `raw` is valid and bound, and a null name asks for its only clock.
+    from_err_ptr(unsafe { bindings::devm_clk_get_enabled(raw, core::ptr::null()) })?;
+
+    // Past here, the size of the mapping is what the device tree says: check it holds these.
+    // SAFETY: `pdev_raw` is valid.
+    let res = unsafe { bindings::platform_get_resource(pdev_raw, bindings::IORESOURCE_MEM, 0) };
+    if res.is_null() {
+        return Err(ENODEV);
+    }
+    // SAFETY: `res` is the device's resource, just checked to be there.
+    let size = unsafe { (*res).end - (*res).start + 1 } as usize;
+    let fits = |off: usize| off + 2 <= size;
+    if !fits(config.dat) || !fits(config.dirout) || !config.init.iter().all(|&(off, _)| fits(off)) {
+        return Err(EINVAL);
+    }
+
+    for &(off, val) in config.init {
+        // SAFETY: `regs` maps `size` bytes, and `off` was just checked against it.
+        unsafe { bindings::writew(val, regs.cast::<u8>().add(off).cast()) };
+    }
+
+    // SAFETY: `raw` is valid; the allocation lasts until it's unbound, as long as the chip.
+    let chip = unsafe {
+        bindings::devm_kmalloc(
+            raw,
+            core::mem::size_of::<bindings::gpio_generic_chip>(),
+            (GFP_KERNEL | crate::alloc::flags::__GFP_ZERO).as_raw(),
+        )
+    }
+    .cast::<bindings::gpio_generic_chip>();
+    if chip.is_null() {
+        return Err(ENOMEM);
+    }
+
+    let mut cfg: bindings::gpio_generic_chip_config = pin_init::zeroed();
+    cfg.dev = raw;
+    cfg.sz = 2;
+    // SAFETY: Both offsets were checked against the mapping.
+    unsafe {
+        cfg.dat = regs.cast::<u8>().add(config.dat).cast();
+        cfg.dirout = regs.cast::<u8>().add(config.dirout).cast();
+    }
+
+    // SAFETY: `chip` is valid and zeroed, and `cfg` is filled in.
+    to_result(unsafe { bindings::gpio_generic_chip_init(chip, &cfg) })?;
+
+    // SAFETY: `chip` was just initialized and isn't registered yet.
+    unsafe {
+        (*chip).gc.base = -1;
+        (*chip).gc.ngpio = config.ngpio;
+    }
+
+    // SAFETY: `chip` is valid as long as the chip's registered. The keys are static.
+    to_result(unsafe {
+        bindings::devm_gpiochip_add_data_with_key(
+            raw,
+            &raw mut (*chip).gc,
+            core::ptr::null_mut(),
+            static_lock_class!().as_ptr(),
+            static_lock_class!().as_ptr(),
+        )
+    })
+}
