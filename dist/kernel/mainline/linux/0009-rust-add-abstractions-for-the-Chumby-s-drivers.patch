+// SPDX-License-Identifier: GPL-2.0
+
+//! Industrial I/O: read-only, direct-mode devices.
+//!
+//! C header: [`include/linux/iio/iio.h`](srctree/include/linux/iio/iio.h)
+
+use crate::{
+    alloc::{flags::GFP_KERNEL, KVec},
+    device::{Bound, Device},
+    error::*,
+    prelude::*,
+};
+use crate::ffi::{c_int, c_long, c_void};
+
+/// What's asked of a channel, in [`Operations::read`].
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Info {
+    /// The raw sample.
+    Raw,
+    /// The multiplier from raw units to SI units.
+    Scale,
+    /// What's added to a raw sample before scaling.
+    Offset,
+}
+
+/// A value read from a channel.
+pub enum Value {
+    /// An integer.
+    Int(i32),
+    /// An integer, plus billionths.
+    IntPlusNano(i32, i32),
+}
+
+/// The acceleration axis a channel measures.
+#[derive(Clone, Copy)]
+pub enum Axis {
+    /// X.
+    X,
+    /// Y.
+    Y,
+    /// Z.
+    Z,
+}
+
+/// An acceleration channel: raw per channel, scale and offset shared by all of them.
+#[derive(Clone, Copy)]
+pub struct AccelChannel {
+    /// The axis.
+    pub axis: Axis,
+    /// The driver's own value for the channel, handed back in [`Operations::read`].
+    pub address: usize,
+}
+
+/// A device's implementation.
+pub trait Operations: Send + Sync + Sized + 'static {
+    /// Reads `info` of the channel with this `address`.
+    fn read(&self, address: usize, info: Info) -> Result<Value>;
+}
+
+struct Inner<T> {
+    ops: T,
+    // Lives as long as the IIO device, which points to it.
+    _channels: KVec<bindings::iio_chan_spec>,
+}
+
+/// The registration of IIO devices of a type of driver.
+pub struct Registration<T>(core::marker::PhantomData<T>);
+
+impl<T: Operations> Registration<T> {
+    const INFO: bindings::iio_info = {
+        let mut info: bindings::iio_info = pin_init::zeroed();
+        info.read_raw = Some(Self::read_raw);
+        info
+    };
+
+    unsafe extern "C" fn read_raw(
+        indio_dev: *mut bindings::iio_dev,
+        chan: *const bindings::iio_chan_spec,
+        val: *mut c_int,
+        val2: *mut c_int,
+        mask: c_long,
+    ) -> c_int {
+        let info = match mask as u32 {
+            bindings::iio_chan_info_enum_IIO_CHAN_INFO_RAW => Info::Raw,
+            bindings::iio_chan_info_enum_IIO_CHAN_INFO_SCALE => Info::Scale,
+            bindings::iio_chan_info_enum_IIO_CHAN_INFO_OFFSET => Info::Offset,
+            _ => return EINVAL.to_errno(),
+        };
+
+        // SAFETY: The IIO core passes the device registered in `register`, whose private data
+        // is an initialized `Inner<T>` until the device has been unregistered.
+        let inner = unsafe { &*bindings::iio_priv(indio_dev).cast::<Inner<T>>() };
+        // SAFETY: The IIO core passes one of the device's channels.
+        let address = unsafe { (*chan).address } as usize;
+
+        match inner.ops.read(address, info) {
+            // SAFETY: The IIO core passes valid pointers to the results.
+            Ok(Value::Int(v)) => unsafe {
+                *val = v;
+                bindings::IIO_VAL_INT as c_int
+            },
+            // SAFETY: The IIO core passes valid pointers to the results.
+            Ok(Value::IntPlusNano(v, nano)) => unsafe {
+                *val = v;
+                *val2 = nano;
+                bindings::IIO_VAL_INT_PLUS_NANO as c_int
+            },
+            Err(e) => e.to_errno(),
+        }
+    }
+
+    unsafe extern "C" fn release(inner: *mut c_void) {
+        // SAFETY: This action is registered, in `register`, on an initialized `Inner<T>`, and
+        // runs once, after the device's unregistration (devres runs in reverse order).
+        unsafe { core::ptr::drop_in_place(inner.cast::<Inner<T>>()) };
+    }
+
+    /// Registers a device, for as long as `parent` is bound, that `ops` implements.
+    ///
+    /// When `ops` is dropped the device has been unregistered: its [`Drop`] may power it off.
+    pub fn register(
+        parent: &Device<Bound>,
+        name: &'static CStr,
+        channels: &[AccelChannel],
+        ops: T,
+    ) -> Result {
+        let mut raw = KVec::with_capacity(channels.len(), GFP_KERNEL)?;
+        for c in channels {
+            let mut spec: bindings::iio_chan_spec = pin_init::zeroed();
+            spec.type_ = bindings::iio_chan_type_IIO_ACCEL;
+            spec.set_modified(1);
+            spec.channel2 = match c.axis {
+                Axis::X => bindings::iio_modifier_IIO_MOD_X,
+                Axis::Y => bindings::iio_modifier_IIO_MOD_Y,
+                Axis::Z => bindings::iio_modifier_IIO_MOD_Z,
+            } as _;
+            spec.address = c.address as _;
+            spec.info_mask_separate = 1 << bindings::iio_chan_info_enum_IIO_CHAN_INFO_RAW;
+            spec.info_mask_shared_by_type = (1 << bindings::iio_chan_info_enum_IIO_CHAN_INFO_SCALE)
+                | (1 << bindings::iio_chan_info_enum_IIO_CHAN_INFO_OFFSET);
+            raw.push(spec, GFP_KERNEL)?;
+        }
+
+        // SAFETY: `parent` is a valid, bound device. The size fits `Inner<T>`, whose alignment
+        // is no more than the private data's, which is `ARCH_DMA_MINALIGN`.
+        let indio_dev = unsafe {
+            bindings::devm_iio_device_alloc(parent.as_raw(), size_of::<Inner<T>>() as c_int)
+        };
+        if indio_dev.is_null() {
+            return Err(ENOMEM);
+        }
+
+        let (chan_ptr, chan_len) = (raw.as_ptr(), raw.len());
+
+        // SAFETY: `indio_dev` was just allocated with room for an `Inner<T>`.
+        let inner = unsafe { bindings::iio_priv(indio_dev) }.cast::<Inner<T>>();
+        // SAFETY: As above, and it's not initialized yet.
+        unsafe {
+            inner.write(Inner {
+                ops,
+                _channels: raw,
+            })
+        };
+
+        // SAFETY: `inner` is valid until the action runs. On failure the action has run, and
+        // dropped `inner`, so nothing here touches it again.
+        to_result(unsafe {
+            bindings::devm_add_action_or_reset(parent.as_raw(), Some(Self::release), inner.cast())
+        })?;
+
+        // SAFETY: `indio_dev` isn't registered yet, so it's exclusively ours. `name` and the
+        // tables are `'static` or live in `inner`, which outlasts the registration.
+        unsafe {
+            (*indio_dev).name = name.as_char_ptr();
+            (*indio_dev).info = &Self::INFO;
+            (*indio_dev).modes = bindings::INDIO_DIRECT_MODE as _;
+            (*indio_dev).channels = chan_ptr;
+            (*indio_dev).num_channels = chan_len as _;
+        }
+
+        // SAFETY: `parent` is bound, so its driver is set; that driver's module owns the device.
+        let module = unsafe { (*(*parent.as_raw()).driver).owner };
+
+        // SAFETY: `indio_dev` is fully set up, and devres unregisters it before `release` runs.
+        to_result(unsafe {
+            bindings::__devm_iio_device_register(parent.as_raw(), indio_dev, module)
+        })
+    }
+}
