+// SPDX-License-Identifier: GPL-2.0
+
+//! Multi-function devices, and the registers of the one we have.
+//!
+//! C header: [`include/linux/mfd/core.h`](srctree/include/linux/mfd/core.h)
+
+use crate::{
+    alloc::{flags::GFP_KERNEL, KVec},
+    device::{Bound, Device},
+    error::*,
+    prelude::*,
+};
+
+/// A child device of a multi-function device.
+pub struct Cell {
+    /// The name, which is what a platform driver matches.
+    pub name: &'static CStr,
+    /// The device tree `compatible` of its child node, if it has one.
+    pub of_compatible: Option<&'static CStr>,
+}
+
+/// Adds `cells` as `dev`'s children until it's unbound, with no device numbering.
+pub fn add_devices(dev: &Device<Bound>, cells: &[Cell]) -> Result {
+    let mut raw = KVec::with_capacity(cells.len(), GFP_KERNEL)?;
+    for cell in cells {
+        let mut c: bindings::mfd_cell = pin_init::zeroed();
+        c.name = cell.name.as_char_ptr();
+        if let Some(of) = cell.of_compatible {
+            c.of_compatible = of.as_char_ptr();
+        }
+        raw.push(c, GFP_KERNEL)?;
+    }
+
+    // SAFETY: `dev` is bound. The MFD core copies the cells it keeps, and their strings are
+    // `'static`.
+    to_result(unsafe {
+        bindings::devm_mfd_add_devices(
+            dev.as_raw(),
+            bindings::PLATFORM_DEVID_NONE,
+            raw.as_ptr(),
+            raw.len() as _,
+            core::ptr::null_mut(),
+            0,
+            core::ptr::null_mut(),
+        )
+    })
+}
+
+/// The TI TSC2100's registers.
+pub mod tsc2100 {
+    /// A read, in the command word.
+    pub const READ: u32 = 1 << 15;
+
+    /// A register's address, as it appears in the command word.
+    pub const fn reg(page: u32, reg: u32) -> u32 {
+        (page << 11) | (reg << 5)
+    }
+
+    /// The distance between registers.
+    pub const REG_STRIDE: u32 = reg(0, 1);
+    /// The highest register.
+    pub const REG_MAX: u32 = reg(3, 0x3f);
+
+    /// X result.
+    pub const REG_X: u32 = reg(0, 0x00);
+    /// Y result.
+    pub const REG_Y: u32 = reg(0, 0x01);
+    /// Z1 result.
+    pub const REG_Z1: u32 = reg(0, 0x02);
+    /// Z2 result.
+    pub const REG_Z2: u32 = reg(0, 0x03);
+
+    /// ADC control.
+    pub const REG_ADC: u32 = reg(1, 0x00);
+    /// Status.
+    pub const REG_STATUS: u32 = reg(1, 0x01);
+    /// Reference.
+    pub const REG_REF: u32 = reg(1, 0x03);
+    /// Reset.
+    pub const REG_RESET: u32 = reg(1, 0x04);
+
+    /// `REG_ADC`, read: the pen is down.
+    pub const ADC_PSTCM: u32 = 1 << 15;
+    /// `REG_ADC`: the conversion or scan mode.
+    pub const fn adc_adscm(mode: u32) -> u32 {
+        mode << 10
+    }
+    /// No conversion.
+    pub const ADSCM_NONE: u32 = 0x0;
+    /// Convert X.
+    pub const ADSCM_X: u32 = 0x3;
+    /// Convert Y.
+    pub const ADSCM_Y: u32 = 0x4;
+    /// Convert Z1 and Z2.
+    pub const ADSCM_Z: u32 = 0x5;
+    /// 12-bit.
+    pub const ADC_RES_12BIT: u32 = 0 << 8;
+    /// Mean of 4.
+    pub const ADC_AVG_4: u32 = 1 << 6;
+    /// 1 MHz conversion clock.
+    pub const ADC_CL_1MHZ: u32 = 3 << 4;
+    /// 500 us panel settling.
+    pub const ADC_PV_500US: u32 = 2 << 1;
+
+    /// `REG_STATUS`: what PINTDAV does.
+    pub const fn status_pintdav(mode: u32) -> u32 {
+        mode << 14
+    }
+    /// PINTDAV signals the pen alone.
+    pub const PINTDAV_PEN: u32 = 2;
+    /// X is done.
+    pub const STATUS_XSTAT: u32 = 1 << 10;
+    /// Y is done.
+    pub const STATUS_YSTAT: u32 = 1 << 9;
+    /// Z2 is done.
+    pub const STATUS_Z2STAT: u32 = 1 << 7;
+
+    /// `REG_RESET`: writing this resets the chip.
+    pub const RESET_MAGIC: u32 = 0xbb00;
+    /// `REG_REF`: the internal reference, as the stock driver sets it.
+    pub const REF_DEFAULT: u32 = 0x0011;
+}
