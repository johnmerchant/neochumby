+/// A controller's registers, in the platform device's first memory resource.
+///
+/// # Invariants
+///
+/// `base` maps `size` bytes for as long as the device is bound. A `Regs` isn't `Clone`, and belongs
+/// in what's given to [`Registration::new`], which drops it before the device's devres.
+pub struct Regs {
+    base: *mut u8,
+    size: usize,
+    start: u64,
+}
+
+// SAFETY: MMIO may be accessed from any thread, and the mapping isn't tied to one.
+unsafe impl Send for Regs {}
+// SAFETY: As above: these are volatile accesses by a register's own width.
+unsafe impl Sync for Regs {}
+
+impl Regs {
+    /// Maps the device's first memory resource until it's unbound.
+    pub fn map(pdev: &platform::Device<device::Core<'_>>) -> Result<Self> {
+        let dev: &device::Device<Bound> = pdev.as_ref();
+        // SAFETY: A `platform::Device` is a `struct platform_device`, whose `dev` is `dev`.
+        let raw = unsafe { crate::container_of!(dev.as_raw(), bindings::platform_device, dev) };
+        let mut res = core::ptr::null_mut();
+        // SAFETY: `raw` is valid and being probed, and `res` a valid destination.
+        let base = from_err_ptr(unsafe {
+            bindings::devm_platform_get_and_ioremap_resource(raw, 0, &mut res)
+        })?;
+        // SAFETY: On success the C function sets `res` to the device's resource.
+        let (start, end) = unsafe { ((*res).start, (*res).end) };
+        Ok(Self {
+            base: base.cast(),
+            size: (end - start + 1) as usize,
+            start: start as u64,
+        })
+    }
+
+    /// Where they are, as [`Registration::new`] wants it, once they're in the driver's data.
+    pub fn mapping_info(&self) -> MappingInfo {
+        MappingInfo { start: self.start, size: self.size }
+    }
+
+    fn at(&self, offset: usize, width: usize) -> *mut c_void {
+        // A register that isn't there is a programming error, and to touch it would be worse.
+        assert!(offset + width <= self.size);
+        // SAFETY: By the type invariant, `base` maps `size` bytes, and `offset` was just checked.
+        unsafe { self.base.add(offset) }.cast()
+    }
+
+    /// Reads a 32-bit register.
+    pub fn read(&self, offset: usize) -> u32 {
+        // SAFETY: `at` returns a mapped address.
+        unsafe { bindings::readl(self.at(offset, 4)) }
+    }
+
+    /// Writes a 32-bit register.
+    pub fn write(&self, offset: usize, value: u32) {
+        // SAFETY: `at` returns a mapped address.
+        unsafe { bindings::writel(value, self.at(offset, 4)) };
+    }
+
+    /// Reads a byte.
+    pub fn read8(&self, offset: usize) -> u8 {
+        // SAFETY: `at` returns a mapped address.
+        unsafe { bindings::readb(self.at(offset, 1)) }
+    }
+}
+
+/// Where a controller's registers are.
+pub struct MappingInfo {
+    start: u64,
+    size: usize,
+}
