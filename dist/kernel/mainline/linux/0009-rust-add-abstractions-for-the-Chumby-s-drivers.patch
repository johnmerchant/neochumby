+
+impl Device<device::Core<'_>> {
+    /// Sets the word size, in bits, and applies the device's settings to the controller.
+    ///
+    /// `only_if_unset` leaves a word size that the device tree already chose.
+    pub fn setup(&self, bits_per_word: u8, only_if_unset: bool) -> Result {
+        // SAFETY: In the `Core` context the device isn't in use by anyone else, so its settings
+        // may be written, and `as_raw` is valid by the type invariant.
+        unsafe {
+            if !only_if_unset || (*self.as_raw()).bits_per_word == 0 {
+                (*self.as_raw()).bits_per_word = bits_per_word;
+            }
+            to_result(bindings::spi_setup(self.as_raw()))
+        }
+    }
+}
+
+impl Device {
+    /// Runs `transfers` as one message, in one chip-select frame.
+    ///
+    /// The buffers needn't be DMA-safe: they're copied through a heap buffer. May sleep.
+    pub fn sync(&self, transfers: &mut [Transfer<'_>]) -> Result {
+        let total = transfers.iter().try_fold(0usize, |sum, t| {
+            let (tx, rx) = (t.tx.map(<[u8]>::len), t.rx.as_ref().map(|r| r.len()));
+            match (tx, rx) {
+                (Some(a), Some(b)) if a != b => Err(EINVAL),
+                (a, b) => Ok(sum + a.or(b).unwrap_or(0)),
+            }
+        })?;
+
+        // Twice over: a transmit and a receive buffer for each.
+        let mut buf = KVec::<u8>::with_capacity(total * 2, GFP_KERNEL)?;
+        buf.resize(total * 2, 0, GFP_KERNEL)?;
+        let (txs, rxs) = buf.split_at_mut(total);
+
+        let mut raw = KVec::with_capacity(transfers.len(), GFP_KERNEL)?;
+        let mut at = 0;
+        for t in transfers.iter() {
+            let len = t.tx.map(<[u8]>::len).or(t.rx.as_ref().map(|r| r.len())).unwrap_or(0);
+            let mut x: bindings::spi_transfer = pin_init::zeroed();
+            x.len = len as u32;
+            if let Some(tx) = t.tx {
+                txs[at..at + len].copy_from_slice(tx);
+                x.tx_buf = txs[at..].as_ptr().cast();
+            }
+            if t.rx.is_some() {
+                x.rx_buf = rxs[at..].as_mut_ptr().cast();
+            }
+            x.delay.value = t.delay_us;
+            x.delay.unit = bindings::SPI_DELAY_UNIT_USECS as u8;
+            raw.push(x, GFP_KERNEL)?;
+            at += len;
+        }
+
+        // SAFETY: `as_raw` is valid by the type invariant. `raw` and the buffers it points to
+        // live until the call returns, and `spi_sync` is synchronous.
+        to_result(unsafe {
+            bindings::spi_sync_transfer(self.as_raw(), raw.as_mut_ptr(), raw.len() as _)
+        })?;
+
+        let mut at = 0;
+        for t in transfers.iter_mut() {
+            let len = t.tx.map(<[u8]>::len).or(t.rx.as_ref().map(|r| r.len())).unwrap_or(0);
+            if let Some(rx) = t.rx.as_mut() {
+                rx.copy_from_slice(&rxs[at..at + len]);
+            }
+            at += len;
+        }
+
+        Ok(())
+    }
+
+    /// Sends `data` in one transfer.
+    pub fn write(&self, data: &[u8]) -> Result {
+        self.sync(&mut [Transfer {
+            tx: Some(data),
+            ..Default::default()
+        }])
+    }
+
+    /// The SPI device that's `dev`'s parent.
+    pub fn of_parent<Ctx: device::DeviceContext>(dev: &device::Device<Ctx>) -> Result<ARef<Self>> {
+        let parent = dev.parent().ok_or(ENODEV)?;
+        // SAFETY: `parent` is a valid device, and `bus` isn't written after it's added.
+        if !core::ptr::eq(unsafe { (*parent.as_raw()).bus }, &raw const bindings::spi_bus_type) {
+            return Err(ENODEV);
+        }
+        // SAFETY: Its bus is SPI's, so `parent` is the `dev` of a `struct spi_device`, and a
+        // `Device` is a transparent wrapper of that.
+        let spi = unsafe {
+            &*crate::container_of!(parent.as_raw(), bindings::spi_device, dev).cast::<Self>()
+        };
+        Ok(spi.into())
+    }
+
+    /// The device's interrupt, if it has one.
+    pub fn irq(&self) -> Option<u32> {
+        // SAFETY: `as_raw` is valid by the type invariant, and `irq` isn't written after probe.
+        let irq = unsafe { (*self.as_raw()).irq };
+        u32::try_from(irq).ok().filter(|&irq| irq != 0)
+    }
+}
+
+// SAFETY: `Device` is a transparent wrapper of `struct spi_device`, whose `dev` is at `OFFSET`.
+unsafe impl<Ctx: device::DeviceContext> device::AsBusDevice<Ctx> for Device<Ctx> {
+    const OFFSET: usize = offset_of!(bindings::spi_device, dev);
+}
