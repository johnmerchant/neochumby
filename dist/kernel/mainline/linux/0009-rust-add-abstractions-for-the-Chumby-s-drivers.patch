+/// A card's implementation.
+pub trait CardOps: Send + Sync + 'static {
+    /// The speaker widget is going on or off.
+    fn speaker_event(&self, on: bool) -> Result;
+    /// A stream is starting.
+    fn startup(&self, substream: &Substream) -> Result;
+    /// The DAI link is being set up.
+    fn dai_init(&self, runtime: &Runtime) -> Result;
+}
+
+/// A card with one DAI link, one CPU DAI and one codec, its platform being the CPU DAI's device.
+pub struct CardDesc<'a> {
+    /// The card's and the link's name.
+    pub name: &'static CStr,
+    /// `SND_SOC_DAIFMT_*`.
+    pub dai_fmt: u32,
+    /// The CPU DAI's node.
+    pub cpu: OfNode,
+    /// The codec's node.
+    pub codec: OfNode,
+    /// The codec DAI's name.
+    pub codec_dai: &'static CStr,
+    /// A property of the device's node to name the card, if it's there.
+    pub model_property: &'static CStr,
+    /// Mixer controls.
+    pub controls: &'a [Control],
+    /// DAPM widgets.
+    pub widgets: &'a [Widget],
+    /// DAPM routes.
+    pub routes: &'a [Route],
+}
+
+struct CardHolder<T> {
+    card: bindings::snd_soc_card,
+    link: bindings::snd_soc_dai_link,
+    cpu_c: bindings::snd_soc_dai_link_component,
+    codec_c: bindings::snd_soc_dai_link_component,
+    platform_c: bindings::snd_soc_dai_link_component,
+    link_ops: bindings::snd_soc_ops,
+    tables: Tables,
+    _cpu: OfNode,
+    _codec: OfNode,
+    ops: Arc<T>,
+}
+
+unsafe fn card_holder<'a, T>(card: *mut bindings::snd_soc_card) -> &'a CardHolder<T> {
+    // SAFETY: `drvdata` is set in `register_card`, to a `CardHolder<T>` that outlasts the card.
+    unsafe { &*(*card).drvdata.cast::<CardHolder<T>>() }
+}
+
+unsafe extern "C" fn card_event<T: CardOps>(
+    w: *mut bindings::snd_soc_dapm_widget,
+    _k: *mut bindings::snd_kcontrol,
+    event: c_int,
+) -> c_int {
+    // SAFETY: ASoC passes a valid widget of the card.
+    let holder = unsafe { card_holder::<T>(bindings::snd_soc_dapm_to_card((*w).dapm)) };
+    from_result(|| holder.ops.speaker_event(event & c_int::from(DAPM_POST_PMU) != 0).map(|()| 0))
+}
+
+unsafe extern "C" fn card_startup<T: CardOps>(s: *mut bindings::snd_pcm_substream) -> c_int {
+    // SAFETY: ASoC passes a valid stream, whose private data is its runtime.
+    let holder = unsafe {
+        let rtd = (*s).private_data.cast::<bindings::snd_soc_pcm_runtime>();
+        card_holder::<T>((*rtd).card)
+    };
+    // SAFETY: `Substream` is a transparent wrapper, and `s` is valid.
+    from_result(|| holder.ops.startup(unsafe { &*s.cast::<Substream>() }).map(|()| 0))
+}
+
+unsafe extern "C" fn card_dai_init<T: CardOps>(rtd: *mut bindings::snd_soc_pcm_runtime) -> c_int {
+    // SAFETY: ASoC passes a valid runtime of the card.
+    let holder = unsafe { card_holder::<T>((*rtd).card) };
+    // SAFETY: `Runtime` is a transparent wrapper, and `rtd` is valid.
+    from_result(|| holder.ops.dai_init(unsafe { &*rtd.cast::<Runtime>() }).map(|()| 0))
+}
+
+/// Registers a card on `dev` until it's unbound.
+pub fn register_card<T: CardOps>(dev: &Device<Bound>, desc: CardDesc<'_>, ops: Arc<T>) -> Result {
+    let tables = Tables::new(desc.controls, desc.widgets, desc.routes, Some(card_event::<T>))?;
+    let (cpu_np, codec_np) = (desc.cpu.0.as_ptr(), desc.codec.0.as_ptr());
+    let (name, dai_fmt, codec_dai, model) = (desc.name, desc.dai_fmt, desc.codec_dai, desc.model_property);
+
+    let h = KBox::into_raw(KBox::new(
+        CardHolder::<T> {
+            card: pin_init::zeroed(),
+            link: pin_init::zeroed(),
+            cpu_c: pin_init::zeroed(),
+            codec_c: pin_init::zeroed(),
+            platform_c: pin_init::zeroed(),
+            link_ops: pin_init::zeroed(),
+            tables,
+            _cpu: desc.cpu,
+            _codec: desc.codec,
+            ops,
+        },
+        GFP_KERNEL,
+    )?);
+
+    // SAFETY: `h` is valid and exclusively ours until the card's registered. It points only to
+    // its own heap-allocated fields and tables, to nodes it holds, and to `'static` strings.
+    unsafe {
+        (*h).cpu_c.of_node = cpu_np;
+        (*h).codec_c.of_node = codec_np;
+        (*h).codec_c.dai_name = codec_dai.as_char_ptr();
+        // fsl_ssi registers its dmaengine PCM on the SSI's own device.
+        (*h).platform_c.of_node = cpu_np;
+
+        (*h).link_ops.startup = Some(card_startup::<T>);
+
+        (*h).link.name = name.as_char_ptr();
+        (*h).link.stream_name = name.as_char_ptr();
+        (*h).link.init = Some(card_dai_init::<T>);
+        (*h).link.ops = &raw const (*h).link_ops;
+        (*h).link.dai_fmt = dai_fmt;
+        (*h).link.cpus = &raw mut (*h).cpu_c;
+        (*h).link.num_cpus = 1;
+        (*h).link.codecs = &raw mut (*h).codec_c;
+        (*h).link.num_codecs = 1;
+        (*h).link.platforms = &raw mut (*h).platform_c;
+        (*h).link.num_platforms = 1;
+
+        (*h).card.name = name.as_char_ptr();
+        // `dev` is bound, so its driver is set; that driver's module owns the card.
+        (*h).card.owner = (*(*dev.as_raw()).driver).owner;
+        (*h).card.dev = dev.as_raw();
+        (*h).card.dai_link = &raw mut (*h).link;
+        (*h).card.num_links = 1;
+        (*h).card.controls = (*h).tables.controls.as_ptr();
+        (*h).card.num_controls = (*h).tables.controls.len() as _;
+        (*h).card.dapm_widgets = (*h).tables.widgets.as_ptr();
+        (*h).card.num_dapm_widgets = (*h).tables.widgets.len() as _;
+        (*h).card.dapm_routes = (*h).tables.routes.as_ptr();
+        (*h).card.num_dapm_routes = (*h).tables.routes.len() as _;
+        (*h).card.drvdata = h.cast();
+    }
+
+    // SAFETY: `h` is valid until the action frees it, which, actions running in reverse order, is
+    // after the card below has gone.
+    to_result(unsafe {
+        bindings::devm_add_action_or_reset(dev.as_raw(), Some(drop_box::<CardHolder<T>>), h.cast())
+    })?;
+
+    // SAFETY: `card` is set up, with its `dev`.
+    to_result(unsafe { bindings::snd_soc_of_parse_card_name(&raw mut (*h).card, model.as_char_ptr()) })?;
+
+    // SAFETY: `card` is fully set up, and stays until it's unregistered.
+    to_result(unsafe { bindings::devm_snd_soc_register_card(dev.as_raw(), &raw mut (*h).card) })
+}
