+/// A host controller, as the core calls its driver back.
+#[repr(transparent)]
+pub struct Hcd<T>(Opaque<bindings::usb_hcd>, PhantomData<T>);
+
+impl<T: HcDriver> Hcd<T> {
+    /// The driver's data.
+    pub fn data(&self) -> Pin<&T> {
+        // SAFETY: `hcd_priv` holds a `T`, pinned in place by `Registration::new`, which stays until
+        // the core no longer calls back.
+        unsafe { Pin::new_unchecked(&*bindings::chumby_hcd_priv(self.0.get()).cast::<T>()) }
+    }
+
+    fn controller(&self) -> *mut bindings::device {
+        // SAFETY: The core sets the controller as it creates the HCD.
+        unsafe { (*self.0.get()).self_.controller }
+    }
+
+    /// Says the controller's running.
+    pub fn set_running(&self) {
+        // SAFETY: A controller's `start` sets this, and only `start` calls this.
+        unsafe { (*self.0.get()).state = bindings::HC_STATE_RUNNING as _ };
+    }
+
+    /// Links `urb` to its endpoint, unless the endpoint's going away.
+    pub fn link(&self, urb: &Urb) -> Result<LinkedUrb> {
+        // SAFETY: `urb` is valid, and is being submitted to this controller.
+        to_result(unsafe { bindings::usb_hcd_link_urb_to_ep(self.0.get(), urb.raw()) })?;
+        // INVARIANT: The core holds a reference from submission to giveback.
+        Ok(LinkedUrb(NonNull::new(urb.raw()).ok_or(EINVAL)?))
+    }
+
+    /// `usb_hcd_check_unlink_urb`: whether the URB being unlinked really is, with `status`.
+    pub fn check_unlink(&self, urb: &Urb, status: i32) -> Result {
+        // SAFETY: `urb` is valid, and is being unlinked from this controller.
+        to_result(unsafe { bindings::usb_hcd_check_unlink_urb(self.0.get(), urb.raw(), status) })
+    }
+
+    /// Unmaps the transfer buffer, which the driver will use by hand.
+    pub fn unmap_for_dma(&self, urb: &Urb) {
+        // SAFETY: `urb` is valid and this controller's.
+        unsafe { bindings::usb_hcd_unmap_urb_for_dma(self.0.get(), urb.raw()) };
+    }
+
+    /// Unmaps the setup packet, which the driver will use by hand.
+    pub fn unmap_setup_for_dma(&self, urb: &Urb) {
+        // SAFETY: `urb` is valid and this controller's.
+        unsafe { bindings::usb_hcd_unmap_urb_setup_for_dma(self.0.get(), urb.raw()) };
+    }
+}
+
+/// A host controller driver.
+pub trait HcDriver: Send + Sync + Sized + 'static {
+    /// The controller's name.
+    const NAME: &'static CStr;
+    /// Its product description.
+    const PRODUCT: &'static CStr;
+
+    /// The controller's interrupt.
+    fn irq(hcd: &Hcd<Self>);
+    /// Resets it. May sleep.
+    fn reset(hcd: &Hcd<Self>) -> Result;
+    /// Starts it.
+    fn start(hcd: &Hcd<Self>) -> Result;
+    /// Stops it.
+    fn stop(hcd: &Hcd<Self>);
+    /// Takes on an URB.
+    fn urb_enqueue(hcd: &Hcd<Self>, urb: &Urb) -> Result;
+    /// Takes an URB back.
+    fn urb_dequeue(hcd: &Hcd<Self>, urb: &Urb, status: i32) -> Result;
+    /// Forgets an endpoint: the id of [`Urb::ep_id`].
+    fn endpoint_disable(hcd: &Hcd<Self>, ep_id: usize);
+    /// The current frame.
+    fn get_frame(hcd: &Hcd<Self>) -> i32;
+    /// Fills in which of the root hub's ports changed, and returns whether any did.
+    fn hub_status_data(hcd: &Hcd<Self>, buf: &mut [u8]) -> bool;
+    /// A request to the root hub.
+    fn hub_control(hcd: &Hcd<Self>, request: u16, value: u16, index: u16, buf: &mut [u8]) -> Result;
+}
+
+struct Vtable<T>(PhantomData<T>);
+
+impl<T: HcDriver> Vtable<T> {
+    const DRIVER: bindings::hc_driver = {
+        let mut d: bindings::hc_driver = pin_init::zeroed();
+        d.description = T::NAME.as_ptr().cast();
+        d.product_desc = T::PRODUCT.as_ptr().cast();
+        d.hcd_priv_size = core::mem::size_of::<T>();
+        d.flags = (bindings::HCD_DMA | bindings::HCD_USB11) as _;
+        d.irq = Some(Self::irq);
+        d.reset = Some(Self::reset);
+        d.start = Some(Self::start);
+        d.stop = Some(Self::stop);
+        d.urb_enqueue = Some(Self::urb_enqueue);
+        d.urb_dequeue = Some(Self::urb_dequeue);
+        d.endpoint_disable = Some(Self::endpoint_disable);
+        d.get_frame_number = Some(Self::get_frame);
+        d.hub_status_data = Some(Self::hub_status_data);
+        d.hub_control = Some(Self::hub_control);
+        d
+    };
+
+    unsafe fn hcd<'a>(raw: *mut bindings::usb_hcd) -> &'a Hcd<T> {
+        // SAFETY: The core passes the valid HCD, and `Hcd` is a transparent wrapper.
+        unsafe { &*raw.cast::<Hcd<T>>() }
+    }
+
+    unsafe extern "C" fn irq(raw: *mut bindings::usb_hcd) -> bindings::irqreturn_t {
+        // SAFETY: See `hcd`.
+        T::irq(unsafe { Self::hcd(raw) });
+        bindings::irqreturn_IRQ_HANDLED
+    }
+
+    unsafe extern "C" fn reset(raw: *mut bindings::usb_hcd) -> c_int {
+        // SAFETY: See `hcd`.
+        from_result(|| T::reset(unsafe { Self::hcd(raw) }).map(|()| 0))
+    }
+
+    unsafe extern "C" fn start(raw: *mut bindings::usb_hcd) -> c_int {
+        // SAFETY: See `hcd`.
+        from_result(|| T::start(unsafe { Self::hcd(raw) }).map(|()| 0))
+    }
+
+    unsafe extern "C" fn stop(raw: *mut bindings::usb_hcd) {
+        // SAFETY: See `hcd`.
+        T::stop(unsafe { Self::hcd(raw) });
+    }
+
+    unsafe extern "C" fn urb_enqueue(
+        raw: *mut bindings::usb_hcd,
+        urb: *mut bindings::urb,
+        _flags: bindings::gfp_t,
+    ) -> c_int {
+        // SAFETY: See `hcd`; the core passes a valid URB, and `Urb` is a transparent wrapper.
+        from_result(|| T::urb_enqueue(unsafe { Self::hcd(raw) }, unsafe { &*urb.cast::<Urb>() }).map(|()| 0))
+    }
+
+    unsafe extern "C" fn urb_dequeue(raw: *mut bindings::usb_hcd, urb: *mut bindings::urb, status: c_int) -> c_int {
+        // SAFETY: As in `urb_enqueue`.
+        from_result(|| {
+            T::urb_dequeue(unsafe { Self::hcd(raw) }, unsafe { &*urb.cast::<Urb>() }, status).map(|()| 0)
+        })
+    }
+
+    unsafe extern "C" fn endpoint_disable(raw: *mut bindings::usb_hcd, ep: *mut bindings::usb_host_endpoint) {
+        if !ep.is_null() {
+            // SAFETY: See `hcd`.
+            T::endpoint_disable(unsafe { Self::hcd(raw) }, ep as usize);
+        }
+    }
+
+    unsafe extern "C" fn get_frame(raw: *mut bindings::usb_hcd) -> c_int {
+        // SAFETY: See `hcd`.
+        T::get_frame(unsafe { Self::hcd(raw) })
+    }
+
+    unsafe extern "C" fn hub_status_data(raw: *mut bindings::usb_hcd, buf: *mut c_char) -> c_int {
+        // SAFETY: The core passes a buffer with room for the root hub's 7 ports and hub bit: one.
+        let buf = unsafe { core::slice::from_raw_parts_mut(buf.cast::<u8>(), 1) };
+        // SAFETY: See `hcd`.
+        c_int::from(T::hub_status_data(unsafe { Self::hcd(raw) }, buf))
+    }
+
+    unsafe extern "C" fn hub_control(
+        raw: *mut bindings::usb_hcd,
+        request: u16,
+        value: u16,
+        index: u16,
+        buf: *mut c_char,
+        length: u16,
+    ) -> c_int {
+        // SAFETY: `rh_call_control` allocates the larger of 15 bytes and `length`.
+        let buf = unsafe { core::slice::from_raw_parts_mut(buf.cast::<u8>(), usize::from(length).max(15)) };
+        // SAFETY: See `hcd`.
+        from_result(|| T::hub_control(unsafe { Self::hcd(raw) }, request, value, index, buf).map(|()| 0))
+    }
+}
+
+/// A host controller added to the core. It's removed, and `T` dropped, as this is dropped.
+pub struct Registration<T: HcDriver>(NonNull<bindings::usb_hcd>, PhantomData<T>);
+
+// SAFETY: The registration may be undone from any thread, and `T` is `Send`.
+unsafe impl<T: HcDriver> Send for Registration<T> {}
+
+impl<T: HcDriver> Registration<T> {
+    /// Creates a controller on `pdev` with its data from `init`, and adds it with interrupt `irq`.
+    pub fn new(
+        pdev: &platform::Device<device::Core<'_>>,
+        regs: &MappingInfo,
+        irq: u32,
+        init: impl PinInit<T, Error>,
+    ) -> Result<Self> {
+        build_assert!(core::mem::align_of::<T>() <= 8);
+        let dev: &device::Device<Bound> = pdev.as_ref();
+        let raw_dev = dev.as_raw();
+
+        // SAFETY: `raw_dev` is valid, and being probed.
+        to_result(unsafe { bindings::dma_coerce_mask_and_coherent(raw_dev, u64::from(u32::MAX)) })?;
+
+        // SAFETY: The driver lives in `Vtable`'s promoted constant, and the name in the device.
+        let hcd = NonNull::new(unsafe {
+            bindings::usb_create_hcd(&Vtable::<T>::DRIVER, raw_dev, bindings::dev_name(raw_dev))
+        })
+        .ok_or(ENOMEM)?;
+
+        // SAFETY: `hcd_priv` has room for a `T`, as `DRIVER` says, and stays where it is.
+        let slot = unsafe { bindings::chumby_hcd_priv(hcd.as_ptr()) }.cast::<T>();
+        // SAFETY: `slot` is valid, uninitialized, and not moved until it's dropped.
+        if let Err(e) = unsafe { init.__init(slot) } {
+            // SAFETY: We hold the reference that `usb_create_hcd` returned.
+            unsafe { bindings::usb_put_hcd(hcd.as_ptr()) };
+            return Err(e);
+        }
+
+        // SAFETY: `hcd` isn't added yet, so it's exclusively ours.
+        unsafe {
+            (*hcd.as_ptr()).rsrc_start = regs.start as _;
+            (*hcd.as_ptr()).rsrc_len = regs.size as _;
+        }
+
+        // SAFETY: `hcd` is fully set up.
+        if let Err(e) = to_result(unsafe { bindings::usb_add_hcd(hcd.as_ptr(), irq, 0) }) {
+            // SAFETY: `slot` is initialized, and the core won't call back; we hold the reference.
+            unsafe {
+                core::ptr::drop_in_place(slot);
+                bindings::usb_put_hcd(hcd.as_ptr());
+            }
+            return Err(e);
+        }
+
+        // SAFETY: `raw_dev` is valid, and is the controller.
+        unsafe { bindings::device_wakeup_enable(raw_dev) };
+
+        Ok(Self(hcd, PhantomData))
+    }
+}
+
+impl<T: HcDriver> Drop for Registration<T> {
+    fn drop(&mut self) {
+        // SAFETY: `self.0` was added, once, in `new`. Past `usb_remove_hcd` the core won't call
+        // back, so its `T` may go, and we hold the last reference of ours.
+        unsafe {
+            bindings::usb_remove_hcd(self.0.as_ptr());
+            core::ptr::drop_in_place(bindings::chumby_hcd_priv(self.0.as_ptr()).cast::<T>());
+            bindings::usb_put_hcd(self.0.as_ptr());
+        }
+    }
+}
+
+/// `clk_round_rate`, then `clk_set_rate`.
+pub fn clk_set_nearest_rate(clk: &crate::clk::Clk, hz: usize) -> Result {
+    // SAFETY: `clk` is valid, and `clk_round_rate` only reads it.
+    let rate = unsafe { bindings::clk_round_rate(clk.as_raw(), hz as _) };
+    clk.set_rate(crate::clk::Hertz(rate as _))
+}
