+/// An URB linked to its endpoint, owned by its controller's driver until it's completed.
+///
+/// # Invariants
+///
+/// `self.0` is valid: the core holds a reference until it's given back, which only [`Done`] does.
+pub struct LinkedUrb(NonNull<bindings::urb>);
+
+// SAFETY: An URB isn't tied to a thread, and this is its only owner.
+unsafe impl Send for LinkedUrb {}
+
+impl core::ops::Deref for LinkedUrb {
+    type Target = Urb;
+
+    fn deref(&self) -> &Urb {
+        // SAFETY: By the type invariant `self.0` is valid, and `Urb` is a transparent wrapper.
+        unsafe { &*self.0.as_ptr().cast::<Urb>() }
+    }
+}
+
+/// URBs that are finished with: they're given back to the core as this is dropped.
+///
+/// They're chained through `hcpriv`, so that completing one can't fail for want of memory.
+pub struct Done<T: HcDriver> {
+    hcd: *mut bindings::usb_hcd,
+    head: *mut bindings::urb,
+    tail: *mut bindings::urb,
+    _t: PhantomData<T>,
+}
+
+impl<T: HcDriver> Done<T> {
+    /// Nothing, yet, for `hcd`.
+    pub fn new(hcd: &Hcd<T>) -> Self {
+        Self {
+            hcd: hcd.0.get(),
+            head: core::ptr::null_mut(),
+            tail: core::ptr::null_mut(),
+            _t: PhantomData,
+        }
+    }
+
+    /// Unlinks `urb` from its endpoint, to be given back with `status`.
+    pub fn complete(&mut self, urb: LinkedUrb, status: i32) {
+        let raw = urb.0.as_ptr();
+        // SAFETY: `raw` is valid by the invariant of `LinkedUrb`, which has been consumed, and
+        // linked to `self.hcd`'s endpoint. Its other fields aren't the core's until given back.
+        unsafe {
+            bindings::usb_hcd_unlink_urb_from_ep(self.hcd, raw);
+            (*raw).status = status;
+            (*raw).hcpriv = core::ptr::null_mut();
+            if self.tail.is_null() {
+                self.head = raw;
+            } else {
+                (*self.tail).hcpriv = raw.cast();
+            }
+        }
+        self.tail = raw;
+    }
+}
+
+impl<T: HcDriver> Drop for Done<T> {
+    fn drop(&mut self) {
+        let mut urb = self.head;
+        while !urb.is_null() {
+            // SAFETY: `urb` was put in the chain by `complete`, and still isn't the core's.
+            let (next, status) = unsafe { ((*urb).hcpriv.cast::<bindings::urb>(), (*urb).status) };
+            // SAFETY: As above. `hcpriv` is clear for the core, and it's given back once.
+            unsafe {
+                (*urb).hcpriv = core::ptr::null_mut();
+                bindings::usb_hcd_giveback_urb(self.hcd, urb, status);
+            }
+            urb = next;
+        }
+    }
+}
