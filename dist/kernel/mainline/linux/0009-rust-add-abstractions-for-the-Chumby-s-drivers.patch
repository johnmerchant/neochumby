+    }
+
+    /// `usb_settoggle`.
+    pub fn set_toggle(&self, on: bool) {
+        let out = usize::from(!self.pipe_in());
+        let bit = 1 << self.pipe_endpoint();
+        // SAFETY: As in `maxpacket`; the core leaves an endpoint's toggle to its controller.
+        unsafe {
+            let t = &raw mut (*(*self.raw()).dev).toggle[out];
+            *t = (*t & !bit) | if on { bit } else { 0 };
+        }
+    }
