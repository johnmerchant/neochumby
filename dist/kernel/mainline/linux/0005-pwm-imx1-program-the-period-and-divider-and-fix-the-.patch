 #define MX1_PWMS			0x04   /* PWM Sample Register */
 #define MX1_PWMP			0x08   /* PWM Period Register */
 
+#define MX1_PWMC_CLKSEL			GENMASK(1, 0)	/* divide by 2 << n */
 #define MX1_PWMC_EN			BIT(4)
+#define MX1_PWMC_PRESCALER		GENMASK(14, 8)	/* divide by n + 1 */
+#define MX1_PWMC_CLKSRC			BIT(15)		/* 32 kHz, not PERCLK1 */
+
+#define MX1_PWMP_MAX			0xffff
 
 struct pwm_imx1_chip {
 	struct clk *clk_ipg;
@@ -65,48 +70,54 @@ static int pwm_imx1_config(struct pwm_chip *chip,
 			   struct pwm_device *pwm, u64 duty_ns, u64 period_ns)
 {
 	struct pwm_imx1_chip *imx = to_pwm_imx1_chip(chip);
-	u32 max, p;
+	unsigned long rate = clk_get_rate(imx->clk_per);
+	u64 cycles, div, sample;
+	unsigned int clksel, prescale = 1;
+	u32 pwmc;
 
 	/*
-	 * The PWM subsystem allows for exact frequencies. However,
-	 * I cannot connect a scope on my device to the PWM line and
-	 * thus cannot provide the program the PWM controller
-	 * exactly. Instead, I'm relying on the fact that the
-	 * Bootloader (u-boot or WinCE+haret) has programmed the PWM
-	 * function group already. So I'll just modify the PWM sample
-	 * register to follow the ratio of duty_ns vs. period_ns
-	 * accordingly.
-	 *
-	 * This is good enough for programming the brightness of
-	 * the LCD backlight.
-	 *
-	 * The real implementation would divide PERCLK[0] first by
-	 * both the prescaler (/1 .. /128) and then by CLKSEL
-	 * (/2 .. /16).
+	 * A period is PWMP + 2 cycles of PERCLK1 divided by CLKSEL (2, 4,
+	 * 8 or 16) and the prescaler (1 to 128); the output is high for
+	 * PWMS cycles of each period. Use the smallest divider that fits.
 	 */
-	max = readl(imx->mmio_base + MX1_PWMP);
-	p = mul_u64_u64_div_u64(max, duty_ns, period_ns);
+	cycles = mul_u64_u64_div_u64(period_ns, rate, NSEC_PER_SEC);
+	for (clksel = 0; clksel <= 3; clksel++) {
+		prescale = DIV64_U64_ROUND_UP(cycles, (u64)(MX1_PWMP_MAX + 2) <<
+					      (clksel + 1));
+		if (prescale <= 128)
+			break;
+	}
+	if (clksel > 3)
+		return -EINVAL;
+	prescale = max(prescale, 1U);
 
-	writel(max - p, imx->mmio_base + MX1_PWMS);
+	div = (u64)prescale << (clksel + 1);
+	cycles = DIV64_U64_ROUND_CLOSEST(cycles, div);
+	if (cycles < 2)
+		return -EINVAL;
+
+	sample = min(mul_u64_u64_div_u64(cycles, duty_ns, period_ns),
+		     (u64)MX1_PWMP_MAX);
+
+	pwmc = readl(imx->mmio_base + MX1_PWMC);
+	pwmc &= ~(MX1_PWMC_CLKSEL | MX1_PWMC_PRESCALER | MX1_PWMC_CLKSRC);
+	pwmc |= FIELD_PREP(MX1_PWMC_CLKSEL, clksel) |
+		FIELD_PREP(MX1_PWMC_PRESCALER, prescale - 1);
+	writel(pwmc, imx->mmio_base + MX1_PWMC);
+	writel(cycles - 2, imx->mmio_base + MX1_PWMP);
+	writel(sample, imx->mmio_base + MX1_PWMS);
 
 	return 0;
 }
 
