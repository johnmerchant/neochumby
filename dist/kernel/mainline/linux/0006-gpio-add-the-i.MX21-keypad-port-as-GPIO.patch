+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/fsl,imx21-kpp-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Freescale i.MX21 keypad port (KPP) as GPIO
+
+maintainers:
+  - John Merchant <john@johnmerchant.dev>
+
+description: |
+  On boards without a key matrix, the keypad port's eight rows and eight
+  columns can be used as 16 general-purpose lines: lines 0-7 are the
+  rows, lines 8-15 the columns. The port has no per-line interrupts.
+  Lines keep their boot state until claimed; use gpio-hogs to fix it.
+
+properties:
+  compatible:
+    oneOf:
+      - const: fsl,imx21-kpp-gpio
+      - items:
+          - const: fsl,imx27-kpp-gpio
+          - const: fsl,imx21-kpp-gpio
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  gpio-controller: true
+
+  '#gpio-cells':
+    const: 2
+
+  gpio-line-names:
+    maxItems: 16
+
+patternProperties:
+  '^.+-hog(-[0-9]+)?$':
+    type: object
+    required:
+      - gpio-hog
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - gpio-controller
+  - '#gpio-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/imx21-clock.h>
+
+    gpio@10008000 {
+        compatible = "fsl,imx21-kpp-gpio";
+        reg = <0x10008000 0x10>;
+        clocks = <&clks IMX21_CLK_KPP_GATE>;
+        gpio-controller;
+        #gpio-cells = <2>;
+    };
