+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The i.MX21/i.MX27 keypad port (KPP) as 16 general-purpose lines
+ *
+ * Some boards, such as the Chumby Classic, don't wire a key matrix to
+ * the KPP: its columns switch power rails and its rows read buttons.
+ * With KPCR cleared every pin is a plain input or push-pull output, and
+ * KDDR and KPDR work as a GPIO port: lines 0-7 are the rows, lines 8-15
+ * the columns. The KPP can't interrupt on a single row, so there are no
+ * interrupts here; poll inputs instead (e.g. gpio-keys-polled).
+ *
+ * The lines keep the state the boot loader left them in until claimed;
+ * use gpio-hogs for lines that need a fixed state.
+ */
+
+#include <linux/clk.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/generic.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#define KPP_KPCR	0x0	/* row enables and column open-drain */
+#define KPP_KDDR	0x4	/* data direction, 1 = output */
+#define KPP_KPDR	0x6	/* data */
+
+static int imx21_kpp_gpio_probe(struct platform_device *pdev)
+{
+	struct gpio_generic_chip_config config;
+	struct device *dev = &pdev->dev;
+	struct gpio_generic_chip *chip;
+	void __iomem *regs;
+	struct clk *clk;
+	int ret;
+
+	chip = devm_kzalloc(dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+
+	regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(regs))
+		return PTR_ERR(regs);
+
+	clk = devm_clk_get_enabled(dev, NULL);
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "no clock\n");
+
+	/* No scanning: rows not ANDed into the interrupt, columns push-pull */
+	writew(0, regs + KPP_KPCR);
+
+	config = (struct gpio_generic_chip_config) {
+		.dev = dev,
+		.sz = 2,
+		.dat = regs + KPP_KPDR,
+		.dirout = regs + KPP_KDDR,
+	};
+
+	ret = gpio_generic_chip_init(chip, &config);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to initialize the generic GPIO chip\n");
+
+	chip->gc.base = -1;
+	chip->gc.ngpio = 16;
+
+	return devm_gpiochip_add_data(dev, &chip->gc, NULL);
+}
+
+static const struct of_device_id imx21_kpp_gpio_of_match[] = {
+	{ .compatible = "fsl,imx21-kpp-gpio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx21_kpp_gpio_of_match);
+
+static struct platform_driver imx21_kpp_gpio_driver = {
+	.driver = {
+		.name = "imx21-kpp-gpio",
+		.of_match_table = imx21_kpp_gpio_of_match,
+	},
+	.probe = imx21_kpp_gpio_probe,
+};
+module_platform_driver(imx21_kpp_gpio_driver);
+
+MODULE_DESCRIPTION("i.MX21 keypad port as GPIO");
+MODULE_LICENSE("GPL");
